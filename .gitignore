/build/
/.idea/
coverage.out
/dist/

# Секреты деплоя: реальные env-файлы не коммитим, образцы (*.env.example) — коммитим.
*.env
!*.env.example

# Изолированное рабочее дерево для параллельной работы.
.worktrees/

# Артефакт ручного контроля экстраполяции AISC: long-формат для глазной
# сверки. Пересобирается детерминированно из `make dcf-aisc` (байт-в-байт),
# в воспроизводимости ничего не добавляет к sql/dcf_mine_plans_seed.sql,
# поэтому в репозитории не хранится.
/polyus_lom_reconciled_long.csv

# То же правило для артефакта атрибуции ОПР-выпуска Сухого Лога: CSV
# пересобирается детерминированно из `make polyus-output`, поэтому в
# репозитории хранится только применяемый артефакт — sql/polyus_output_seed.sql.
/polyus_output_attribution_long.csv

# Артефакты прогона модели ключевой ставки (спека §8): отчёт, построчные прогнозы
# и запись текущего прогноза. Локальные и детерминированные при фиксированном
# сиде и одной БД (числа прогона фиксируются протоколом приёмки в PR), поэтому
# в репозитории не хранятся. Имена — точные: фикстуры scripts/testdata/key_rate/
# обязаны коммититься и широкой маски не допускают.
/key_rate_model_report.md
/key_rate_model_predictions.csv
/key_rate_model_forecast.json

# Артефакты классификатора шоков (issue #200): отчёт, as-of веса и запись
# следующего заседания. Локальные и детерминированные при фиксированном сиде
# и одной БД; имена точные.
/shock_classifier_report.md
/shock_classifier_weights.csv
/shock_classifier_forecast.json

# Артефакты экспериментального LLM-трека ключевой ставки (issue #189): JSON
# прогноза, markdown-отчёт и payload для ingest #127. Локальные, содержат ответ
# конкретного провайдера и не коммитятся; имена точные.
/key_rate_llm_forecast.json
/key_rate_llm_forecast_report.md
/key_rate_llm_forecast_log_payload.json

# Артефакты прогона CPI-nowcast (спека §5): отчёт, построчные прогнозы и запись
# текущего nowcast. Локальные и детерминированные при фиксированном сиде и одной
# БД (числа прогона фиксируются протоколом приёмки в PR), поэтому в репозитории
# не хранятся. Имена — точные: фикстуры scripts/testdata/cpi_nowcast/ обязаны
# коммититься и широкой маски не допускают.
/cpi_nowcast_report.md
/cpi_nowcast_predictions.csv
/cpi_nowcast_forecast.json

# Артефакты месячного трека v2 (спека 2026-10-18, §5.1): те же правила, что у v1.
# Имена — точные: фикстуры scripts/testdata/cpi_monthly/ обязаны коммититься.
/cpi_monthly_report.md
/cpi_monthly_predictions.csv
/cpi_monthly_forecast.json

# Артефакты parity-прогона с CB_COMP (issue #190, спека §7): отчёт, построчные
# прогнозы и машинный результат. Локальные и детерминированные при фиксированном
# сиде и одном архиве; числа прогона фиксируются протоколом приёмки в PR,
# поэтому в репозитории не хранятся. Имена — точные (не маска).
/cb_comp_parity_report.md
/cb_comp_parity_predictions.csv
/cb_comp_parity_result.json

# Артефакты прокси-прогона CB_COMP (issue #190): отчёт, метрики и JSON.
# Локальные и детерминированные при фиксированном сиде и одной БД; числа
# фиксируются отчётом docs/research/2026-10-18-cb-comp-proxy.md и протоколом PR.
/cb_comp_proxy_report.md
/cb_comp_proxy_metrics.csv
/cb_comp_proxy_results.json

# Python-байткод от запусков скриптов (например `make key-rate-model` или тестов):
# артефакт интерпретатора, в репозитории не хранится. Маска здесь безопасна —
# под `__pycache__` коммитируемого не бывает (в отличие от артефактов прогона
# выше, у которых имена точные: фикстуры тестов лежат рядом и обязаны попадать
# в коммит).
__pycache__/

# Месячные выгрузки WGC (ETF Flows, статистика ЦБ) скачиваются вручную в
# браузере с gold.org/goldhub (сервер отдаёт файлы только залогиненному
# браузеру, боту — 403) и кладутся в wgc/data/; в репозитории не хранятся —
# файлы обновляются ежемесячно. Фикстуры тестов — в wgc/testdata/.
/wgc/data/
