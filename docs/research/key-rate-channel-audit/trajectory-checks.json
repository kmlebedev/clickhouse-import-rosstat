{
  "algorithm": "function calc(year,segments){let start=Date.UTC(year,0,1),end=Date.UTC(year+1,0,1),cursor=start,sum=0;for(let s of segments){let a=Date.parse(s[0]+\"T00:00:00Z\"),b=Date.parse(s[1]+\"T00:00:00Z\");if(a!==cursor||b<=a||b>end)throw Error(\"gap/overlap\");sum+=s[2]*(b-a)/864e5;cursor=b;}if(cursor!==end)throw Error(\"incomplete\");return sum/((end-start)/864e5);}",
