+type: chain
+schedule: "7 8 * * *"
+overlap_policy: skip
+
+# Ежедневный прогон контура bold.report (ByteTree) в 08:07 МСК: данные источника
+# готовы к 07:32 МСК, а слот свободен (соседние DAG-и: cbr/gold — 18:47, wgc — 20:17).
+# Контур щадящий: ключей у источника нет, а обычный инкремент — 4 запроса у
+# bold_etf_flows (units-latest, aum-latest, flows/all-latest, summary) плюс 1 у
+# bold_gold_price (price-latest), то есть до 5 запросов в сутки. Полный режим
+# (первый прогон, доказанный пропуск дней — дата источника ушла вперёд больше чем на
+# 4 календарных дня, или расхождение максимумов ряда и пер-фондового среза) читает
+# файлы истории: до 8 запросов, но это редкий путь, а не ежедневный, и он идемпотентен
+# (ReplacingMergeTree по ключам), поэтому может запускаться руками. Оба импортёра
+# fail-fast: не-200, пустое тело, отсутствие ключа, расхождение дат или цены и ноль
+# точек — ошибка, поэтому сбой виден в dagu, а не остаётся зелёным при рядах без
+# обновления. Данные источника T+1: прогон пишет прошедший торговый день, выходные
+# источник опускает. Шаги — цепочкой: сначала цена дня, затем ETF-контур (цена входит
+# множителем в etf_bold_flow_usd_mln, поэтому без неё USD-поток дня не посчитается).
+steps:
+  - id: bold_gold_price
+    run: "$ROSSTAT_IMPORT_BIN"
+    env:
+      - CLICKHOUSE_IMPORT_STAT=bold_gold_price
+    retry_policy:
+      limit: 3
+      interval_sec: 300
+
+  - id: bold_etf_flows
+    run: "$ROSSTAT_IMPORT_BIN"
+    env:
+      - CLICKHOUSE_IMPORT_STAT=bold_etf_flows
+    retry_policy:
+      limit: 3
+      interval_sec: 300
