+// TestBoldETFSetsSkipsFirstFlow: одна строка истории — ряда потока нет, остальные пять есть.
+func TestBoldETFSetsSkipsFirstFlow(t *testing.T) {
+	points := testPoints(t, testDayRows(t, boldPinDate), nil, time.Time{})
