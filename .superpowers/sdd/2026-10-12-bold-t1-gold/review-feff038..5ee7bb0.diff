+		if entry.Series == "" || entry.Title == "" || entry.Unit == "" || entry.Origin == "" || entry.Description == "" {
+			t.Errorf("%s: пустое поле каталога: %+v", entry.Series, entry)
+		}
+		if entry.Frequency != "D" {
