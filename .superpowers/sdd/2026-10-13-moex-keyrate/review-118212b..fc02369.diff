+		"series_name":   "Короткое имя серии по ISS (SHORTNAME), например KEYRATE-10.26 — вменённая ставка на заседание 10.2026",
+		"decision_date": "Дата экспирации серии (LSTDELDATE); она же дата заседания Совета директоров ЦБ, по объявленной на нём ставке рассчитывается индекс KEYRATE",
+		"settle":        "Расчётная цена дня (SETTLEPRICE), п.п. ставки: вменённый рынком уровень ключевой ставки на дату заседания decision_date",
+		"close":         "Цена закрытия дня (CLOSE), п.п.; при отсутствии сделок не отражает ожиданий — читать settle",
+		"volume":        "Количество контрактов в сделках за день, шт.; 0 означает, что сделок не было и settle серии за этот день — не рыночное ожидание",
+		"openposition":  "Открытые позиции на конец дня, контрактов (индикатор ликвидности серии)",
+		"expected_change_pp": "Вменённое изменение ключевой ставки к дате заседания: settle − последняя известная ставка cbr_key_rate, п.п.; " +
+			"плюс — рынок ждёт повышения, минус — понижения. NULL означает, что ставка ещё не загружена (cbr_key_rate пуста): " +
+			"вменённое значение неизвестно, нулём его считать нельзя",
+		"expected_change_bp": "То же в базисных пунктах: (settle − последняя известная ставка cbr_key_rate) × 100. " +
+			"Считается к последней ИЗВЕСТНОЙ ставке, а не к ставке на дату decision_date; при нулевом объёме серии значение " +
+			"нерепрезентативно, а NULL (cbr_key_rate пуста, ставка ещё не загружена) значит «неизвестно», а не нулевое изменение. " +
+			"Вменённое рынком значение, а не прогноз и не ценовое обязательство",
+	},
+}
+
+func (s *keyrateFutures) Name() string {
+	return keyrateTable
+}
+
+func (s *keyrateFutures) Import(ctx context.Context, conn driver.Conn) (count int64, err error) {
+	// DDL — до сети: импортёр обязан отработать на чистой базе.
+	if err = conn.Exec(ctx, keyrateDdl); err != nil {
+		return count, err
+	}
+	if err = conn.Exec(ctx, keyrateContractDdl); err != nil {
+		return count, err
+	}
+	secids, err := fetchKeyrateSecids(ctx)
+	if err != nil {
+		return count, err
+	}
+	if len(secids) == 0 {
+		return count, fmt.Errorf("keyrate_futures: ISS не отдал ни одной торгуемой серии KEYRATE")
+	}
+	// Паспорта серий: сбой одной серии не останавливает остальные (серии независимы, как ленты
+	// в news_watch), но и не молчит — причина видна в логе по secid и в ошибке прогона.
+	contracts := make([]keyrateContract, 0, len(secids))
+	var seriesErrs []error
+	for _, secid := range secids {
+		if !validSecid(secid) {
+			log.Warnf("keyrate_futures: серия %q пропущена: код не проходит проверку validSecid", secid)
+			seriesErrs = append(seriesErrs, fmt.Errorf("%s: недопустимый код серии", secid))
+			continue
+		}
+		contract, err := fetchKeyrateContract(ctx, secid)
+		if err != nil {
+			log.Warnf("keyrate_futures: паспорт серии %s не получен: %v", secid, err)
+			seriesErrs = append(seriesErrs, fmt.Errorf("%s: %w", secid, err))
+			continue
+		}
+		contracts = append(contracts, contract)
+	}
+	if len(contracts) == 0 {
+		// Молчаливый нулевой прогон недопустим: сбой всех серий — ошибка импорта.
+		return count, errors.Join(
+			fmt.Errorf("keyrate_futures: паспорта не получены ни по одной из %d серий", len(secids)),
+			errors.Join(seriesErrs...))
+	}
+	contractBatch, err := conn.PrepareBatch(ctx, keyrateContractInsert)
+	if err != nil {
+		return count, err
+	}
+	now := time.Now()
+	for _, c := range contracts {
+		if err = contractBatch.Append(c.secid, c.seriesName, c.firstTrade, c.lastTrade, now); err != nil {
+			return count, err
+		}
+	}
+	dayBatch, err := conn.PrepareBatch(ctx, keyrateInsert)
+	if err != nil {
+		return count, err
+	}
+	// Инкремент — по каждой серии от её max(date) + 1 день: серии появляются и истекают
+	// в разные дни, общей даты у них нет. okSeries считает серии, по которым дни действительно
+	// собраны, — по нему решается, публиковать ли прогон.
+	okSeries := 0
+	for _, c := range contracts {
+		stored, err := keyrateStoredDate(ctx, conn, c)
+		if err != nil {
+			log.Warnf("keyrate_futures: последний день серии %s не прочитан: %v", c.secid, err)
+			seriesErrs = append(seriesErrs, fmt.Errorf("%s: %w", c.secid, err))
+			continue
+		}
+		days, err := fetchKeyrateHistory(ctx, c.secid, keyrateSince(c, stored))
+		if err != nil {
+			log.Warnf("keyrate_futures: история серии %s не получена: %v", c.secid, err)
+			seriesErrs = append(seriesErrs, fmt.Errorf("%s: %w", c.secid, err))
+			continue
+		}
+		okSeries++
+		for _, d := range days {
+			if err = dayBatch.Append(c.secid, d.date, d.close, d.settle, d.waprice, d.volume, d.numtrades, d.openposition); err != nil {
+				return count, err
+			}
+			count++
+		}
+	}
+	if okSeries == 0 {
+		// Сбой всех серий — ошибка импорта, и она возвращается ДО публикации: пустой прогон
+		// не должен отправлять батчи, писать каталог и пересоздавать витрину.
+		return count, errors.Join(
+			fmt.Errorf("keyrate_futures: дни не собраны ни по одной из %d серий", len(contracts)),
+			errors.Join(seriesErrs...))
+	}
+	if err = contractBatch.Send(); err != nil {
+		return count, err
+	}
+	if err = dayBatch.Send(); err != nil {
+		return count, err
+	}
+	log.Infof("Собрано %d дней по %d сериям KEYRATE", count, okSeries)
+	// Каталог — после успешного Send и на КАЖДУЮ обнаруженную серию (её паспорт), в том числе
+	// на серию без дневных итогов: инструмент существует, его ряд должен быть виден агенту ещё
+	// до первых сделок — так требует план («одна запись на обнаруженную серию»).
+	if err = util.UpsertSeriesCatalog(ctx, conn, keyrateSeriesMeta(contracts)); err != nil {
+		return count, err
+	}
+	if _, err = util.CreateView(ctx, conn, keyrateView); err != nil {
+		return count, err
+	}
+	return count, errors.Join(seriesErrs...)
+}
+
+// keyrateSince — с какой даты запрашивать историю серии: день после последнего сохранённого
+// (ключ таблицы — (secid, date)) или начало обращения, если по серии ещё ничего не сохранено.
+func keyrateSince(c keyrateContract, stored time.Time) time.Time {
+	if stored.IsZero() {
+		return c.firstTrade
+	}
+	return stored.AddDate(0, 0, 1)
+}
+
+// keyrateStoredDate — дата последнего сохранённого дня серии. secid подставляется в SQL-условие,
+// поэтому проверяется validSecid: код приходит из тела ответа ISS.
+func keyrateStoredDate(ctx context.Context, conn driver.Conn, c keyrateContract) (time.Time, error) {
+	if !validSecid(c.secid) {
+		return time.Time{}, fmt.Errorf("keyrate: недопустимый код серии %q", c.secid)
+	}
+	return lastDate(ctx, conn, keyrateTable, "secid = '"+c.secid+"'")
+}
+
+// keyrateSeriesMeta — описания рядов в series_catalog: по одной записи на обнаруженную серию.
+// Статического списка быть не может — серии добавляются и истекают каждый квартал.
+func keyrateSeriesMeta(contracts []keyrateContract) []util.SeriesMeta {
+	meta := make([]util.SeriesMeta, 0, len(contracts))
+	for _, c := range contracts {
+		expiry := c.lastTrade.Format(moexDate)
+		meta = append(meta, util.SeriesMeta{
+			Source:    moexSource,
+			Series:    c.secid,
+			Title:     fmt.Sprintf("%s (%s): вменённый уровень ключевой ставки на заседание ЦБ %s, дневной", c.seriesName, c.secid, expiry),
+			Unit:      "п.п. ключевой ставки",
+			Frequency: "D",
+			Origin: "MOEX ISS: /iss/history/engines/futures/markets/forts/securities/" + c.secid +
+				".json, поле SETTLEPRICE (цена дня); паспорт серии — /iss/securities/" + c.secid +
+				".json: " + c.seriesName + ", FRSTTRADE " + c.firstTrade.Format(moexDate) +
+				", экспирация (LSTDELDATE) " + expiry,
+			Description: c.seriesName + " — расчётный фьючерс на Индекс ключевой ставки МосБиржи: цена серии " +
+				"(settle, SETTLEPRICE) = вменённый рынком уровень ключевой ставки на дату экспирации " + expiry +
+				" (она же дата заседания ЦБ), в п.п.; 1 п.п. = 1 000 ₽ (шаг 0,01 п.п. = 10 ₽). " +
+				"Мнемоника перевода в ожидания: вменённое изменение к заседанию Δ = (settle − ставка) × 100 б.п., " +
+				"где ставка — последнее известное значение cbr_key_rate; ожидаемый шаг между заседаниями — разность " +
+				"settle соседних серий × 100 б.п.; вероятностная интерпретация при дискретных исходах по 25 б.п.: " +
+				"P(−25) ≈ (ставка − settle) / 0.25, но полного распределения из одного числа не получить — опционов " +
+				"на KEYRATE в ISS нет. Цена дня — SETTLEPRICE, LAST не используется (в дни без сделок ISS отдаёт по " +
+				"нему ноль). Инструмент низколиквиден: значение индикативно, при нулевом объёме серии оно " +
+				"нерепрезентативно. Витрина — v_keyrate_expectations",
+		})
+	}
+	return meta
+}
+
+func init() {
+	chimport.Stats = append(chimport.Stats, &keyrateFutures{})
+}
diff --git a/moex/keyrate_parse.go b/moex/keyrate_parse.go
new file mode 100644
index 0000000..ee31b97
--- /dev/null
+++ b/moex/keyrate_parse.go
@@ -0,0 +1,269 @@
+package moex
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// keyrateContract — паспорт серии расчётного фьючерса на Индекс ключевой ставки MOEX (KEYRATE).
+type keyrateContract struct {
+	secid      string
+	seriesName string
+	firstTrade time.Time
+	// lastTrade — дата экспирации контракта (LSTDELDATE): она же дата заседания Совета директоров ЦБ,
+	// по ставке которого рассчитывается индекс KEYRATE.
+	lastTrade time.Time
+}
+
+// keyrateDay — дневной итог торгов одной серии. Цена дня — settle (SETTLEPRICE из блока history):
+// LAST у ISS равен нулю в дни без сделок (живая проба 2026-10-13) и ценой быть не может.
+type keyrateDay struct {
+	date         time.Time
+	close        float64
+	settle       float64
+	waprice      float64
+	volume       uint64
+	numtrades    uint64
+	openposition uint64
+}
+
+const (
+	// keyrateBoard — площадка срочного рынка, на которой торгуются серии KEYRATE.
+	keyrateBoard = "RFUD"
+	// keyrateSeriesPrefix — код серии начинается с KK; отсекает прочие инструменты срочного рынка.
+	keyrateSeriesPrefix = "KK"
+)
+
+// keyrateSecidRe — допустимый код серии: заглавные латинские буквы и цифры, не короче 4 символов
+// (secid приходит из внешнего JSON и подставляется в SQL-условие инкремента).
+var keyrateSecidRe = regexp.MustCompile(`^[A-Z0-9]{4,}$`)
+
+func validSecid(s string) bool {
+	return keyrateSecidRe.MatchString(s)
+}
+
+// parseKeyrateSecids — коды серий из блока securities запроса /iss/securities.json?q=KEYRATE.
+// Параметр assetcode= ISS игнорирует (отдаёт все бумаги), поэтому отбор — здесь: площадка RFUD,
+// код серии с префиксом KK, is_traded == 1 (календарные спреды и индекс KEYRATE отсеиваются).
+func parseKeyrateSecids(b issBlock) ([]string, error) {
+	secidIdx := keyrateColumnIndex(b.Columns, "secid")
+	boardIdx := keyrateColumnIndex(b.Columns, "primary_boardid")
+	tradedIdx := keyrateColumnIndex(b.Columns, "is_traded")
+	if secidIdx < 0 || boardIdx < 0 || tradedIdx < 0 {
+		return nil, errNoColumns(b.Columns)
+	}
+	var secids []string
+	for _, row := range b.Data {
+		secid, err := rowString(row, secidIdx, "secid")
+		if err != nil {
+			return nil, err
+		}
+		board, err := rowString(row, boardIdx, "primary_boardid")
+		if err != nil {
+			return nil, err
+		}
+		traded, err := rowTraded(row, tradedIdx)
+		if err != nil {
+			return nil, err
+		}
+		if board != keyrateBoard || !traded || !strings.HasPrefix(secid, keyrateSeriesPrefix) {
+			continue
+		}
+		secids = append(secids, secid)
+	}
+	return secids, nil
+}
+
+// parseKeyrateContract — паспорт серии из блока description (пары name/value) запроса
+// /iss/securities/<secid>.json. Обязательны SHORTNAME, FRSTTRADE и LSTDELDATE: молчаливый zero
+// time недопустим. Пустое значение LSTDELDATE откатывается на LSTTRADE.
+func parseKeyrateContract(b issBlock) (keyrateContract, error) {
+	nameIdx := keyrateColumnIndex(b.Columns, "name")
+	valueIdx := keyrateColumnIndex(b.Columns, "value")
+	if nameIdx < 0 || valueIdx < 0 {
+		return keyrateContract{}, errNoColumns(b.Columns)
+	}
+	fields := make(map[string]string, len(b.Data))
+	for _, row := range b.Data {
+		name, err := rowString(row, nameIdx, "name")
+		if err != nil {
+			return keyrateContract{}, err
+		}
+		value, err := rowString(row, valueIdx, "value")
+		if err != nil {
+			return keyrateContract{}, err
+		}
+		fields[name] = value
+	}
+	seriesName := fields["SHORTNAME"]
+	if seriesName == "" {
+		return keyrateContract{}, fmt.Errorf("empty SHORTNAME in description of %s", fields["SECID"])
+	}
+	firstTrade, err := parseKeyrateDate("FRSTTRADE", fields["FRSTTRADE"])
+	if err != nil {
+		return keyrateContract{}, err
+	}
+	lastRaw, ok := fields["LSTDELDATE"]
+	if !ok {
+		return keyrateContract{}, fmt.Errorf("no LSTDELDATE in description of %s", fields["SECID"])
+	}
+	if lastRaw == "" {
+		lastRaw = fields["LSTTRADE"]
+	}
+	lastTrade, err := parseKeyrateDate("LSTDELDATE", lastRaw)
+	if err != nil {
+		return keyrateContract{}, err
+	}
+	return keyrateContract{
+		secid:      fields["SECID"],
+		seriesName: seriesName,
+		firstTrade: firstTrade,
+		lastTrade:  lastTrade,
+	}, nil
+}
+
+// parseKeyrateHistory — дневные итоги из блока history запроса /iss/history/.../securities/<secid>.json.
+// Читаются только tradedate, close, settleprice, waprice, volume, numtrades, openposition:
+// колонка LAST не читается ни здесь, ни в импортёре.
+func parseKeyrateHistory(b issBlock) ([]keyrateDay, error) {
+	idx := make(map[string]int, 7)
+	for _, name := range []string{"tradedate", "close", "settleprice", "waprice", "volume", "numtrades", "openposition"} {
+		idx[name] = keyrateColumnIndex(b.Columns, name)
+		if idx[name] < 0 {
+			return nil, errNoColumns(b.Columns)
+		}
+	}
+	var days []keyrateDay
+	for _, row := range b.Data {
+		tradedate, err := rowString(row, idx["tradedate"], "tradedate")
+		if err != nil {
+			return nil, err
+		}
+		date, err := time.Parse(moexDate, tradedate)
+		if err != nil {
+			return nil, err
+		}
+		close_, err := rowFloat(row, idx["close"])
+		if err != nil {
+			return nil, err
+		}
+		settle, err := rowFloat(row, idx["settleprice"])
+		if err != nil {
+			return nil, err
+		}
+		waprice, err := rowFloat(row, idx["waprice"])
+		if err != nil {
+			return nil, err
+		}
+		volume, err := rowCount(row, idx["volume"], "volume")
+		if err != nil {
+			return nil, err
+		}
+		numtrades, err := rowCount(row, idx["numtrades"], "numtrades")
+		if err != nil {
+			return nil, err
+		}
+		openposition, err := rowCount(row, idx["openposition"], "openposition")
+		if err != nil {
+			return nil, err
+		}
+		days = append(days, keyrateDay{
+			date:         date,
+			close:        close_,
+			settle:       settle,
+			waprice:      waprice,
+			volume:       volume,
+			numtrades:    numtrades,
+			openposition: openposition,
+		})
+	}
+	return days, nil
+}
+
+// parseHistoryTotal — TOTAL из блока history.cursor: сколько дней отдаёт ISS по запросу целиком,
+// при PAGESIZE меньше TOTAL нужны страницы (параметр start).
+func parseHistoryTotal(b issBlock) (int, error) {
+	idx := keyrateColumnIndex(b.Columns, "TOTAL")
+	if idx < 0 {
+		return 0, errNoColumns(b.Columns)
+	}
+	if len(b.Data) == 0 {
+		return 0, nil
+	}
+	total, err := rowFloat(b.Data[0], idx)
+	if err != nil {
+		return 0, err
+	}
+	if total < 0 {
+		return 0, errBadCell("TOTAL", b.Data[0][idx])
+	}
+	return int(total), nil
+}
+
+// keyrateColumnIndex — поиск колонки без учёта регистра имени. Регистр у ISS разный от блока к блоку:
+// в securities/description имена строчные (secid, primary_boardid, is_traded, name, value), в блоке
+// history — заглавные (TRADEDATE, CLOSE, SETTLEPRICE, WAPRICE, VOLUME, NUMTRADES, OPENPOSITION).
+func keyrateColumnIndex(columns []string, name string) int {
+	for i, c := range columns {
+		if strings.EqualFold(c, name) {
+			return i
+		}
+	}
+	return -1
+}
+
+// rowString — строковая ячейка строки блока ISS.
+func rowString(row []any, idx int, name string) (string, error) {
+	if idx < 0 || len(row) <= idx {
+		return "", fmt.Errorf("short row %v", row)
+	}
+	v, ok := row[idx].(string)
+	if !ok {
+		return "", errBadCell(name, row[idx])
+	}
+	return v, nil
+}
+
+// rowTraded — колонка is_traded: у календарных спредов ISS отдаёт null (сведений о торгах нет),
+// такую бумагу считаем неторгуемой, а не ошибкой разбора.
+func rowTraded(row []any, idx int) (bool, error) {
+	if idx < 0 || len(row) <= idx {
+		return false, fmt.Errorf("short row %v", row)
+	}
+	switch v := row[idx].(type) {
+	case nil:
+		return false, nil
+	case float64:
+		return v == 1, nil
+	default:
+		return false, errBadCell("is_traded", row[idx])
+	}
+}
+
+// rowCount — целочисленная колонка (объём, число сделок, открытые позиции): ISS отдаёт их числами,
+// значение проверяется на неотрицательность перед приведением к uint64.
+func rowCount(row []any, idx int, name string) (uint64, error) {
+	v, err := rowFloat(row, idx)
+	if err != nil {
+		return 0, err
+	}
+	if v < 0 {
+		return 0, errBadCell(name, row[idx])
+	}
+	return uint64(v), nil
+}
+
+// parseKeyrateDate — дата в формате ISS (moexDate); пустое значение — ошибка: zero time в паспорте
+// серии означал бы «дата заседания неизвестна», и импортёр записал бы её молча.
+func parseKeyrateDate(name, value string) (time.Time, error) {
+	if value == "" {
+		return time.Time{}, fmt.Errorf("empty %s in description", name)
+	}
+	date, err := time.Parse(moexDate, value)
+	if err != nil {
+		return time.Time{}, fmt.Errorf("%s: %w", name, err)
+	}
+	return date, nil
+}
diff --git a/moex/keyrate_parse_test.go b/moex/keyrate_parse_test.go
new file mode 100644
index 0000000..e0f3f9f
--- /dev/null
+++ b/moex/keyrate_parse_test.go
@@ -0,0 +1,240 @@
+package moex
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"testing"
+	"time"
+)
+
+// issFixture читает фикстуру ISS (moex/testdata/<name>) как набор блоков по именам — так же,
+// как ответ ISS разбирает getBlocks.
+func issFixture(t *testing.T, name string) map[string]issBlock {
+	t.Helper()
+	raw, err := os.ReadFile(filepath.Join("testdata", name))
+	if err != nil {
+		t.Fatalf("read fixture %s: %v", name, err)
+	}
+	var blocks map[string]issBlock
+	if err := json.Unmarshal(raw, &blocks); err != nil {
+		t.Fatalf("decode fixture %s: %v", name, err)
+	}
+	return blocks
+}
