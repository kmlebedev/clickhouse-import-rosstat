+++ b/archive/fromenv_test.go
@@ -0,0 +1,144 @@
+package archive
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Пустой ARCHIVE_BACKEND — архивация выключена, и это (nil, nil), а не ошибка: без архива
+// конвейер работает как раньше (спека §3.1), а ошибка на каждом прогоне мусорила бы в логе у всех,
+// кто архив не заводил. Клиент здесь и ниже (&http.Client{}) в сеть не ходит — local и «выключено»
+// работают с файловой системой; но он часть сигнатуры FromEnv, потому что прод передаёт
+// util.HttpClient с национальными TLS-сертификатами РФ (правило 4 AGENTS.md), и подменять её в
+// тестах своим вариантом нельзя.
+func TestFromEnvDisabled(t *testing.T) {
+	t.Setenv(EnvBackend, "")
+
+	store, err := FromEnv(&http.Client{})
+	if err != nil {
+		t.Fatalf("FromEnv без %s: %v", EnvBackend, err)
+	}
+	if store != nil {
+		t.Errorf("FromEnv без %s вернул %v, ожидался nil", EnvBackend, store)
+	}
+}
+
+// local → LocalStore на ARCHIVE_LOCAL_DIR, и каталог доезжает до бэкенда: запись обязана лечь
+// именно в него — так dev-прогон и приёмка видят версии глазами, без Диска.
+func TestFromEnvLocal(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv(EnvBackend, "local")
+	t.Setenv(EnvLocalDir, dir)
+
+	store, err := FromEnv(&http.Client{})
+	if err != nil {
+		t.Fatalf("FromEnv %s=local: %v", EnvBackend, err)
+	}
+	if store == nil {
+		t.Fatalf("FromEnv %s=local вернул nil", EnvBackend)
+	}
+	if store.Name() != "local" {
+		t.Errorf("Name() = %q, ожидалось %q", store.Name(), "local")
+	}
+	key := Key("cbr_m2", "x.xlsx", fp, zeroSum)
+	if err = store.Put(context.Background(), key, []byte("тело")); err != nil {
+		t.Fatalf("Put в local-хранилище: %v", err)
+	}
+	if _, err = os.Stat(filepath.Join(dir, filepath.FromSlash(key))); err != nil {
+		t.Errorf("объект не лёг в %s: %v", dir, err)
+	}
+}
+
+// Пустой ARCHIVE_LOCAL_DIR — ошибка, называющая переменную: иначе дежурный по логу не знает, какую
+// строку править, а хранилище молча оказалось бы каталогом по умолчанию.
+func TestFromEnvLocalWithoutDir(t *testing.T) {
+	t.Setenv(EnvBackend, "local")
+	t.Setenv(EnvLocalDir, "")
+
+	store, err := FromEnv(&http.Client{})
+	if err == nil {
+		t.Fatalf("ожидалась ошибка, получено хранилище %v", store)
+	}
+	if !strings.Contains(err.Error(), EnvLocalDir) {
+		t.Errorf("ошибка %q не называет %s — по логу не понять, что править", err, EnvLocalDir)
+	}
+}
+
+// yandex без токена останавливается на конфигурации: без токена хранилище не собрать, и текст
+// ошибки называет переменную, чтобы дежурный правил одну строку, а не искал причину в API.
+func TestFromEnvYandexRequiresToken(t *testing.T) {
+	t.Setenv(EnvBackend, "yandex")
+	t.Setenv(EnvYandexToken, "")
+
+	store, err := FromEnv(&http.Client{})
+	if err == nil {
+		t.Fatalf("ожидалась ошибка, получено хранилище %v", store)
+	}
+	if !strings.Contains(err.Error(), EnvYandexToken) {
+		t.Errorf("ошибка %q не называет %s", err, EnvYandexToken)
+	}
+}
+
+// Токен задан: корень архива берётся из ARCHIVE_YANDEX_DIR, а при пустом значении — из
+// DefaultYandexDir. Корень проверяется у полученного хранилища, а не по тексту ошибки: конфигурация
+// закрыта, FromEnv отдаёт бэкенд Диска, и название корня важно именно в нём — по нему собирается
+// путь на Диске, то есть ошибка здесь означала бы архив не в том каталоге (или запись в чужой).
+// Значение токена при этом не попадает ни в текст ошибки, ни в лог: лог архивации читает дежурный,
+// и секрет в логе — утечка (правило 1 AGENTS.md).
+func TestFromEnvYandexRoot(t *testing.T) {
+	const token = "SECRET_TOKEN_VALUE"
+	t.Setenv(EnvBackend, "yandex")
+	t.Setenv(EnvYandexToken, token)
+
+	for _, c := range []struct{ name, dir, wantRoot string }{
+		{"корень по умолчанию", "", DefaultYandexDir},
+		{"корень из переменной", "disk:/custom-archive", "disk:/custom-archive"},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			t.Setenv(EnvYandexDir, c.dir)
+
+			store, err := FromEnv(&http.Client{})
+			if err != nil {
+				t.Fatalf("FromEnv %s=yandex: %v", EnvBackend, err)
+			}
+			if store == nil {
+				t.Fatalf("FromEnv %s=yandex вернул nil", EnvBackend)
+			}
+			if store.Name() != "yandex" {
+				t.Errorf("Name() = %q, ожидалось %q", store.Name(), "yandex")
+			}
+			disk, ok := store.(*YandexDisk)
+			if !ok {
+				t.Fatalf("FromEnv вернул %T, ожидался *YandexDisk", store)
+			}
+			if disk.root != c.wantRoot {
+				t.Errorf("корень архива = %q, ожидался %q", disk.root, c.wantRoot)
+			}
+			// Токен доехал до хранилища: без него Диск ответил бы 401, то есть архивации не было бы
+			// вовсе. Значение здесь фиктивное — настоящий токен в тесты не попадает (правило 1
+			// AGENTS.md), и проверять его в логе или тексте ошибки всё равно нечего.
+			if disk.token != token {
+				t.Error("токен из окружения не доехал до хранилища Диска")
+			}
+		})
+	}
+}
+
+// Неизвестное значение ARCHIVE_BACKEND (опечатка) — ошибка с именем переменной и её значением:
+// молчаливое «архивация выключена» заметили бы только при попытке восстановить версию, то есть
+// тогда, когда файла у источника уже нет.
+func TestFromEnvUnknownBackend(t *testing.T) {
+	t.Setenv(EnvBackend, "ftp")
+
+	store, err := FromEnv(&http.Client{})
+	if err == nil {
+		t.Fatalf("ожидалась ошибка, получено хранилище %v", store)
+	}
+	if !strings.Contains(err.Error(), EnvBackend) || !strings.Contains(err.Error(), "ftp") {
+		t.Errorf("ошибка %q не называет %s и его значение", err, EnvBackend)
+	}
+}
diff --git a/archive/key.go b/archive/key.go
new file mode 100644
index 0000000..a3090e9
--- /dev/null
+++ b/archive/key.go
@@ -0,0 +1,77 @@
+package archive
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	// keyNameMaxBytes — потолок имени артефакта в ключе: 200 байт. Компонент пути в хранилище
+	// ограничен 255 байтами (имя файла на Диске, NAME_MAX в ФС), а имя делит компонент с префиксом
+	// версии (≤20 байт: «sha-» и 16 hex) и '_'. Кириллица — два байта на символ, поэтому потолок
+	// режется по границе руны, а не по байту: см. sanitizeName.
+	keyNameMaxBytes = 200
+
+	// keyNameFallback — имя для пустого basename: имя приходит из URL, и пустой путь дал бы
+	// ключ с хвостом «_» — такой объект не читается ни в логе, ни глазами в каталоге архива.
+	keyNameFallback = "file"
+
+	// keyPrefixHex — длина префикса версии в ключе: 16 символов отпечатка (64 бита). Версии одного
+	// файла так различаются с большим запасом, и те же 16 символов видно в логе и в строке
+	// source_publications — ключ архива и таблица версий должны называть версию одинаково.
+	keyPrefixHex = 16
+)
+
+// Key — ключ объекта версии: «<источник>/<префикс версии>_<имя>». Префикс — из отпечатка версии,
+// который даёт префлайт (util.HeadFingerprint): по нему архив и source_publications говорят об
+// одной версии, а проверка «версия уже в архиве?» на no-op-пути обходится без чтения файла.
+// Отпечатка нет (HEAD недоступен) → префикс из sha256 содержимого: без него две версии одного
+// файла схлопнулись бы в один ключ, и новая вытеснила бы прежнюю — ровно та потеря, ради которой
+// архив заведён.
+func Key(source, basename, fingerprint string, sum [sha256.Size]byte) string {
+	prefix := prefix16(fingerprint)
+	if prefix == "" {
+		prefix = "sha-" + prefix16(hex.EncodeToString(sum[:]))
+	}
+	return source + "/" + prefix + "_" + sanitizeName(basename)
+}
+
+// prefix16 — не более 16 символов. Отпечаток короче 16 — нештатная ситуация (HeadFingerprint
+// всегда даёт 32 hex), но падать на срезе нельзя: сбой сборки ключа уронил бы импорт, тогда как
+// короткий префикс версию всё равно называет, а пустой склеил бы разные версии одного файла.
+func prefix16(s string) string {
+	if len(s) > keyPrefixHex {
+		return s[:keyPrefixHex]
+	}
+	return s
+}
+
+// sanitizeName готовит basename к роли компонента ключа: имя приходит из URL источника, а ключ
+// становится путём в хранилище (у LocalStore — путём файловой системы), поэтому разделители пути
+// и запрещённые в именах символы заменяются на '_' — вместе с ними на '_' заменяются и управляющие
+// символы: имя с переводом строки ломает и лог, и список объектов. Кириллица сохраняется —
+// выгрузки ЦБ и Росстата названы по-русски, и переименование исказило бы аудит версии.
+func sanitizeName(name string) string {
+	clean := strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) || strings.ContainsRune(`/\:*?"<>|`, r) {
+			return '_'
+		}
+		return r
+	}, name)
+	if len(clean) > keyNameMaxBytes {
+		// utf8.RuneStart: отступ от потолка до начала руны — разрезанная руна сделала бы имя
+		// объекта невосстановимым (в ключе остались бы битые байты).
+		cut := keyNameMaxBytes
+		for cut > 0 && !utf8.RuneStart(clean[cut]) {
+			cut--
+		}
+		clean = clean[:cut]
+	}
+	if clean == "" {
+		return keyNameFallback
+	}
+	return clean
+}
diff --git a/archive/key_test.go b/archive/key_test.go
new file mode 100644
index 0000000..82ea9b6
--- /dev/null
+++ b/archive/key_test.go
@@ -0,0 +1,108 @@
+package archive
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+	"testing"
+	"unicode/utf8"
+)
+
+// fp — отпечаток версии в том виде, в каком его даёт util.HeadFingerprint (md5 от заголовков,
+// 32 hex-символа), fp16 — те его 16 символов, которые попадают в ключ.
+const (
+	fp   = "8f3c1d2e4a5b6c7d8e9f0a1b2c3d4e5f"
+	fp16 = "8f3c1d2e4a5b6c7d"
+)
+
+var zeroSum [sha256.Size]byte
+
+// Отпечаток префлайта есть — ключ строится из него, и sha256 содержимого на ключ не влияет:
+// «версия уже в архиве?» на no-op-пути решается одним Exists по данным HEAD, без чтения файла
+// (спека §3.2). Если бы содержимое участвовало, проверка (она считает ключ без файла, с нулевой
+// суммой) не нашла бы объект, записанный полным импортом, и каждый прогон шёл бы в полный импорт.
+func TestKeyFromFingerprint(t *testing.T) {
+	got := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum)
+	if want := "cbr_m2/" + fp16 + "_monetary_agg_SA.xlsx"; got != want {
+		t.Errorf("Key() = %q, ожидалось %q", got, want)
+	}
+	first := sha256.Sum256([]byte("версия первая"))
+	second := sha256.Sum256([]byte("версия вторая"))
+	if Key("cbr_m2", "monetary_agg_SA.xlsx", fp, first) != Key("cbr_m2", "monetary_agg_SA.xlsx", fp, second) {
+		t.Error("при непустом отпечатке содержимое изменило ключ: префлайт считает ключ без файла")
+	}
+}
+
+// Отпечатка нет (HEAD недоступен) — ключ из sha256 содержимого. Префикс «sha-» называет
+// происхождение префикса (в логе и на Диске он отличим от отпечатка префлайта), а разные версии
+// файла обязаны давать разные ключи: иначе новая версия заняла бы место прежней — та самая потеря,
+// ради которой архив и заведён (спека §3.1, риск «HEAD недоступен»).
+func TestKeyWithoutFingerprintUsesSHA(t *testing.T) {
+	sum := sha256.Sum256([]byte("версия"))
+	got := Key("cbr_m2", "monetary_agg_SA.xlsx", "", sum)
+	want := "cbr_m2/sha-" + hex.EncodeToString(sum[:])[:16] + "_monetary_agg_SA.xlsx"
+	if got != want {
+		t.Errorf("Key() = %q, ожидалось %q", got, want)
+	}
+	other := sha256.Sum256([]byte("другая версия"))
+	if Key("cbr_m2", "monetary_agg_SA.xlsx", "", other) == got {
+		t.Error("разные суммы sha256 дали один ключ: две версии схлопнулись бы в один объект")
+	}
+}
+
+// Имя приходит из URL источника, а ключ становится путём в хранилище (у LocalStore — путём ФС),
+// поэтому разделители и запрещённые в именах символы заменяются. Кириллица сохраняется: выгрузки
+// ЦБ и Росстата названы по-русски, и переименование исказило бы аудит версии.
+func TestKeySanitizesBasename(t *testing.T) {
+	sum := sha256.Sum256([]byte("версия"))
+	cases := []struct{ name, basename, want string }{
+		{"разделители пути", `monetary/agg\SA.xlsx`, "monetary_agg_SA.xlsx"},
+		{"запрещённые в именах", `a:b*c?d"e<f>g|h.xlsx`, "a_b_c_d_e_f_g_h.xlsx"},
+		{"управляющие символы", "monetary\x00agg\x1fSA.xlsx", "monetary_agg_SA.xlsx"},
+		{"кириллица сохраняется", "выгрузка_ЦБ.xlsx", "выгрузка_ЦБ.xlsx"},
+		{"пустое имя", "", "file"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := Key("cbr_m2", c.basename, fp, sum)
+			if want := "cbr_m2/" + fp16 + "_" + c.want; got != want {
+				t.Errorf("Key(%q) = %q, ожидалось %q", c.basename, got, want)
+			}
+		})
+	}
+
+	// Обрезка длинного имени: компонент ключа обязан влезать в 255 байт (предел имени файла и на
+	// Диске, и в ФС), поэтому имя режется до 200 — префикс версии (≤20) и '_' оставляют запас.
+	// Режется по границе руны: basename здесь — 206 байт (1 на «a» + 200 на сто «я» + 5 на «.xlsx»),
+	// и обрезка даёт 199 байт, а не 200, где последняя «я» была бы разрезана пополам и имя в
+	// хранилище стало бы битым UTF-8.
+	t.Run("длинное имя режется по границе руны", func(t *testing.T) {
+		basename := "a" + strings.Repeat("я", 100) + ".xlsx"
+		got := Key("cbr_m2", basename, fp, sum)
+		if want := "cbr_m2/" + fp16 + "_a" + strings.Repeat("я", 99); got != want {
+			t.Errorf("Key() = %q, ожидалось %q", got, want)
+		}
+		component := strings.TrimPrefix(got, "cbr_m2/")
+		if !utf8.ValidString(component) {
+			t.Errorf("компонент ключа %q — не валидный UTF-8", component)
+		}
+		if len(component) > 255 {
+			t.Errorf("компонент ключа %d байт, предел — 255", len(component))
+		}
+	})
+}
+
+// Короткий отпечаток нештатен (HeadFingerprint всегда даёт 32 hex), но паниковать и отдавать
+// пустой префикс нельзя: паника уронила бы импорт на ровном месте, а пустой префикс склеил бы
+// версии одного файла в один объект («…/_file.xlsx»).
+func TestKeyFingerprintShorterThan16(t *testing.T) {
+	for _, c := range []struct{ fingerprint, want string }{
+		{"abc", "cbr_m2/abc_x.xlsx"},
+		{"f", "cbr_m2/f_x.xlsx"},
+	} {
+		got := Key("cbr_m2", "x.xlsx", c.fingerprint, sha256.Sum256(nil))
+		if got != c.want {
+			t.Errorf("Key(отпечаток %q) = %q, ожидалось %q", c.fingerprint, got, c.want)
+		}
+	}
+}
diff --git a/archive/local.go b/archive/local.go
new file mode 100644
index 0000000..fb41286
--- /dev/null
+++ b/archive/local.go
@@ -0,0 +1,141 @@
+package archive
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// LocalStore — хранилище на каталоге файловой системы: dev-прогоны (ARCHIVE_BACKEND=local) и
+// харнесс тестов. Своей структуры не заводит — ключ и есть относительный путь, поэтому каталог
+// архива читается глазами, а версии одного источника лежат рядом, как и на Диске.
+//
+// ctx у операций не проверяется: файловые вызовы отмены не умеют, а параметр — часть контракта
+// Store, чтобы бэкенды оставались взаимозаменяемыми.
+type LocalStore struct {
+	Dir string
+}
+
+// LocalStore обязан удовлетворять Store: бэкенды подставляются друг вместо друга (тесты util
+// берут local вместо Диска), и расхождение сигнатур должно ломать сборку, а не прогон.
+var _ Store = (*LocalStore)(nil)
+
+// NewLocal — хранилище в каталоге dir. Каталог здесь не создаётся: пустой каталог под архив ничего
+// не значит, а Put заводит и его, и подкаталог источника (MkdirAll родителя) — так dev-прогон и
+// приёмка получают дерево ровно из тех версий, что действительно сохранились.
+func NewLocal(dir string) *LocalStore {
+	return &LocalStore{Dir: dir}
+}
+
+func (s *LocalStore) Name() string {
+	return "local"
+}
+
+func (s *LocalStore) Put(ctx context.Context, key string, body []byte) error {
+	p, err := s.path(key)
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+		return fmt.Errorf("archive local: каталог %s: %w", filepath.Dir(p), err)
+	}
+	// Запись идёт через временный файл и rename (writeFileAtomic), а не os.WriteFile: архив объявлен
+	// источником истины (спека §3.1), и усечённый объект от прерванной записи хуже отсутствующего —
+	// Exists увидел бы «версия есть», no-op-путь пропустил бы повторную архивацию, и версия
+	// потерялась бы молча. Текст ошибки остаётся прежним: к ключу добавляется причина сбоя.
+	if err = writeFileAtomic(p, body); err != nil {
+		return fmt.Errorf("archive local: запись %s: %w", key, err)
+	}
+	return nil
+}
+
+// writeFileAtomic кладёт body в path так, чтобы в path никогда не оказалось половины объекта:
+// временный файл в том же каталоге → Write → Chmod → Sync → Close → Rename. Временный файл обязан
+// лежать рядом с целевым: rename атомарен в пределах одной ФС, в чужом каталоге он выродился бы в
+// копирование — ту же неатомарную запись. При любой неудаче временный файл снимается: .tmp не
+// считает объектом ни реестр, ни приёмка, он просто копился бы в каталоге архива навсегда.
+// Осиротевший .tmp после убийства процесса (SIGKILL снять его уже нечем) безвреден по той же
+// причине: ни реестр, ни префлайт на него не смотрят, а повторный Put перезапишет целевой объект.
+func writeFileAtomic(path string, body []byte) error {
+	dir := filepath.Dir(path)
+	f, err := os.CreateTemp(dir, "*.tmp")
+	if err != nil {
+		return fmt.Errorf("временный файл в %s: %w", dir, err)
+	}
+	tmp := f.Name()
+	flush := func() error {
+		if _, err := f.Write(body); err != nil {
+			return fmt.Errorf("запись: %w", err)
+		}
+		// CreateTemp даёт 0600, а объект архива — обычная выгрузка: 0644, как и было у записи
+		// целиком (иначе читать архив с чужого пользователя стало бы нельзя).
+		if err := f.Chmod(0o644); err != nil {
+			return fmt.Errorf("права: %w", err)
+		}
+		// Sync до rename: без него объект может пережить переименование только в кэше ФС и не дойти
+		// до диска при падении машины — ровно та потеря версии, от которой спасает временный файл.
+		if err := f.Sync(); err != nil {
+			return fmt.Errorf("синхронизация: %w", err)
+		}
+		return f.Close()
+	}
+	if err = flush(); err != nil {
+		_ = f.Close() // при сбое Write/Sync файл ещё открыт
+		_ = os.Remove(tmp)
+		return err
+	}
+	if err = os.Rename(tmp, path); err != nil {
+		_ = os.Remove(tmp)
+		return fmt.Errorf("переименование: %w", err)
+	}
+	return nil
+}
+
+func (s *LocalStore) Get(ctx context.Context, key string) ([]byte, error) {
+	p, err := s.path(key)
+	if err != nil {
+		return nil, err
+	}
+	body, err := os.ReadFile(p)
+	if err != nil {
+		return nil, fmt.Errorf("archive local: чтение %s: %w", key, err)
+	}
+	return body, nil
+}
+
+// Exists — отсутствие файла это «версии нет» (false, nil), а не ошибка: так на него смотрит и
+// префлайт — «нет» отправляет в полный импорт и самолечение архива, тогда как ошибка означала бы
+// сбой проверки. Дежурный по логу должен различать эти два случая.
+func (s *LocalStore) Exists(ctx context.Context, key string) (bool, error) {
+	p, err := s.path(key)
+	if err != nil {
+		return false, err
+	}
+	if _, err = os.Stat(p); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return false, nil
+		}
+		return false, fmt.Errorf("archive local: проверка %s: %w", key, err)
+	}
+	return true, nil
+}
+
+// path переводит ключ в путь внутри Dir и отвергает выход за каталог. Ключ относительный (его
+// собирает Key), но проверка нужна: путь — единственное, что отделяет строку от файловой системы,
+// а ключ с «..» записал бы объект рядом с архивом (тот потерялся бы при переносе каталога и разошёлся
+// бы с реестром). Сравниваются абсолютные пути: Join чистит «.» и «..» в ключе, поэтому префиксная
+// проверка по неочищенному корню отсекла бы валидные ключи при относительном Dir (и при Dir = «.»).
+func (s *LocalStore) path(key string) (string, error) {
+	root, err := filepath.Abs(s.Dir)
+	if err != nil {
+		return "", fmt.Errorf("archive local: каталог %q: %w", s.Dir, err)
+	}
+	p := filepath.Join(root, filepath.FromSlash(key))
+	if !strings.HasPrefix(p, root+string(filepath.Separator)) {
+		return "", fmt.Errorf("archive local: ключ %q вне каталога %q", key, s.Dir)
+	}
+	return p, nil
+}
diff --git a/archive/local_test.go b/archive/local_test.go
new file mode 100644
index 0000000..077e1ac
--- /dev/null
+++ b/archive/local_test.go
@@ -0,0 +1,166 @@
+package archive
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// Round-trip Put → Get → Exists: локальный бэкенд — это dev-прогон (ARCHIVE_BACKEND=local) и
+// харнесс тестов, поэтому проверяется ровно то, на что опирается вызывающий: положили байты,
+// прочитали те же байты, наличие видно.
+func TestLocalRoundTrip(t *testing.T) {
+	store := NewLocal(t.TempDir())
+	ctx := context.Background()
+	key := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, sha256.Sum256([]byte("версия")))
+	body := []byte("байты выгрузки")
+
+	if store.Name() != "local" {
+		t.Errorf("Name() = %q, ожидалось %q", store.Name(), "local")
+	}
+	if err := store.Put(ctx, key, body); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+	got, err := store.Get(ctx, key)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if !bytes.Equal(got, body) {
+		t.Errorf("Get() = %q, ожидалось %q", got, body)
+	}
+	exists, err := store.Exists(ctx, key)
+	if err != nil {
+		t.Fatalf("Exists: %v", err)
+	}
+	if !exists {
+		t.Error("Exists после Put = false, ожидалось true")
+	}
+}
+
+// Отсутствие объекта — не ошибка (false, nil): Exists зовётся на каждом no-op-прогоне, и ошибка
+// вместо ответа «нет» превращала бы штатное «версия новая» в сбой архивации. Get при этом обязан
+// падать: пустые байты как версия файла — молчаливая потеря.
+func TestLocalMissingKey(t *testing.T) {
+	store := NewLocal(t.TempDir())
+	ctx := context.Background()
+
+	exists, err := store.Exists(ctx, "cbr_m2/none.xlsx")
+	if err != nil {
+		t.Fatalf("Exists отсутствующего ключа: %v", err)
+	}
+	if exists {
+		t.Error("Exists отсутствующего ключа = true, ожидалось false")
+	}
+	if _, err = store.Get(ctx, "cbr_m2/none.xlsx"); err == nil {
+		t.Error("Get отсутствующего ключа вернул байты без ошибки")
+	}
+}
+
+// Ключ с «..» отвергается всеми операциями, и файла вне каталога архива не появляется. Ключи
+// собирает Key из данных источника, но путь — единственное, что отделяет строку от файловой
+// системы: объект, записанный рядом с каталогом архива, потерялся бы при его переносе (и молча
+// разошёлся бы с реестром).
+func TestLocalRejectsParentKey(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	escaped := filepath.Join(dir, "..", "escaped.xlsx")
+
+	if err := store.Put(ctx, "../escaped.xlsx", []byte("нет")); err == nil {
+		t.Error("Put ключа с «..» не дал ошибки")
+	}
+	if _, err := store.Get(ctx, "../escaped.xlsx"); err == nil {
+		t.Error("Get ключа с «..» не дал ошибки")
+	}
+	if _, err := store.Exists(ctx, "../escaped.xlsx"); err == nil {
+		t.Error("Exists ключа с «..» не дал ошибки")
+	}
+	if _, err := os.Stat(escaped); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("файл вне каталога архива существует (%v), ожидалось его отсутствие", err)
+	}
+}
+
+// Вложенный ключ (…/<источник>/<префикс>_<имя>) создаёт подкаталог источника: каталог архива
+// читается глазами, и версии одного источника лежат рядом — как и на Диске по тому же ключу.
+func TestLocalNestedKey(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	key := "cbr_m2/x_y.xlsx"
+
+	if err := store.Put(ctx, key, []byte("тело")); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+	info, err := os.Stat(filepath.Join(dir, "cbr_m2"))
+	if err != nil {
+		t.Fatalf("подкаталог источника не создан: %v", err)
+	}
+	if !info.IsDir() {
+		t.Errorf("%s не каталог", filepath.Join(dir, "cbr_m2"))
+	}
+	got, err := store.Get(ctx, key)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if string(got) != "тело" {
+		t.Errorf("Get() = %q, ожидалось %q", got, "тело")
+	}
+}
+
+// Объект появляется на целевом пути только целиком — запись идёт через временный файл рядом и
+// rename. Иначе прерванная запись (kill, полный диск) оставила бы усечённый объект: Exists увидел
+// бы его как «версия есть», no-op-путь пропустил бы повторную архивацию, и версия потерялась бы
+// молча — а архив объявлен источником истины (спека §3.1). Наблюдаемое здесь: временных файлов
+// после Put не остаётся, и повторная запись того же ключа отдаёт новое содержимое, а не дозапись
+// (ключ и есть версия, но объект мог быть перезаписан — в том числе при самолечении архива).
+func TestLocalPutIsAtomic(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	key := "cbr_m2/x_y.xlsx"
+
+	if err := store.Put(ctx, key, []byte("первая версия")); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+	assertNoTempLeftovers(t, filepath.Join(dir, "cbr_m2"))
+	if got, err := store.Get(ctx, key); err != nil {
+		t.Fatalf("Get после первого Put: %v", err)
+	} else if string(got) != "первая версия" {
+		t.Errorf("Get() = %q, ожидалось %q", got, "первая версия")
+	}
+	// Права объекта: CreateTemp даёт 0600, а выгрузка в архиве обязана читаться как обычный файл —
+	// 0644, как и предписывал бриф для записи целиком.
+	if info, err := os.Stat(filepath.Join(dir, filepath.FromSlash(key))); err != nil {
+		t.Fatalf("Stat объекта: %v", err)
+	} else if perm := info.Mode().Perm(); perm != 0o644 {
+		t.Errorf("права объекта %o, ожидалось 644", perm)
+	}
+
+	if err := store.Put(ctx, key, []byte("вторая версия")); err != nil {
+		t.Fatalf("повторный Put: %v", err)
+	}
+	assertNoTempLeftovers(t, filepath.Join(dir, "cbr_m2"))
+	if got, err := store.Get(ctx, key); err != nil {
+		t.Fatalf("Get после повторного Put: %v", err)
+	} else if string(got) != "вторая версия" {
+		t.Errorf("Get() = %q, ожидалось %q (перезапись не должна дописывать и не должна оставлять хвост прежней версии)", got, "вторая версия")
+	}
+}
+
+// assertNoTempLeftovers — временный файл записи лежит в том же каталоге, что и объект (rename
+// атомарен только в пределах одной ФС), поэтому утечка .tmp видна прямо в каталоге архива.
+// Мусор из них опасен тем, что его не считает объектом ни реестр, ни приёмка: он просто копится.
+func assertNoTempLeftovers(t *testing.T, dir string) {
+	t.Helper()
+	leftovers, err := filepath.Glob(filepath.Join(dir, "*.tmp"))
+	if err != nil {
+		t.Fatalf("Glob %s: %v", dir, err)
+	}
+	if len(leftovers) != 0 {
+		t.Errorf("после Put в %s остались временные файлы: %v", dir, leftovers)
+	}
+}
diff --git a/archive/registry.go b/archive/registry.go
new file mode 100644
index 0000000..523e1d1
--- /dev/null
+++ b/archive/registry.go
@@ -0,0 +1,189 @@
+package archive
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+)
+
+// RegistryKey — ключ реестра версий: файл в корне хранилища, рядом с каталогами источников. Ключ
+// фиксирован (в отличие от Key): реестр один на всё хранилище, и по одному имени его находит и
+// вызывающий, и режим ARCHIVE_ACTION=registry, и git-зеркало.
+const RegistryKey = "registry.jsonl"
+
+// Entry — одна сохранённая версия файла источника, то есть строка реестра. Поля — из §3.4 спеки:
+// fingerprint — отпечаток HEAD (как в source_publications, чтобы архив и таблица версий называли
+// версию одинаково), sha256 — фактическое содержимое (при неизменных заголовках оно могло
+// смениться), key — объект в хранилище, first_seen — когда конвейер увидел версию, url — аудит.
+// Идентичность строки — Key. Секретов в записи нет: все восемь полей (source, name, fingerprint,
+// sha256, size, url, key, first_seen) публичны — запись и есть реестр версий, он уезжает в
+// git-зеркало и служит входом будущего восстановления (§3.4).
+type Entry struct {
+	Source      string    `json:"source"`
+	Name        string    `json:"name"`
+	Fingerprint string    `json:"fingerprint"`
+	SHA256      string    `json:"sha256"`
+	Size        int64     `json:"size"`
+	URL         string    `json:"url"`
+	Key         string    `json:"key"`
+	FirstSeen   time.Time `json:"first_seen"`
+}
+
+// registryMu — мьютекс процесса, под которым идёт весь read-modify-write файла реестра и чтение
+// состояния для Entries. Пакетный, а не на экземпляр: файл читается целиком на каждой записи, и
+// два Registry в одном процессе (самолечение архива в соседнем импортёре, ручной прогон рядом с
+// dagu) без общего замка не видели бы строк друг друга и затёрли бы их своими состояниями.
+// Писателей между процессами он не разводит — для этого штатный писатель один (последовательная
+// цепочка dagu), а строка, потерянная конкурентным ручным прогоном, самолечится префлайтом (§3.4).
+var registryMu sync.Mutex
+
+// Registry — реестр версий: JSONL-файл в хранилище плюс состояние последнего завершённого Ensure
+// в памяти — только для Entries, потому что читать реестр (и тем более писать) вызывающий не должен
+// уметь мимо мьютекса. Чтение — на каждой записи: файл целиком перечитывается под registryMu, а
+// прогон, который до архивации не дошёл, в хранилище не ходит вовсе. Запись — upsert по Key (та же
+// версия с тем же sha256 не меняет ни строку, ни байты файла, иначе строка заменяется и уезжает в
+// конец, новый ключ дописывается туда же), а весь файл уходит в хранилище одним Put: объект там
+// пишется целиком, дописывания по строке нет.
+type Registry struct {
+	store Store
+
+	// entries — копия содержимого файла после последнего завершённого Ensure этого экземпляра.
+	// До первого Ensure пусто: реестр читается на записи, а не в конструкторе. Поле пишет Ensure и
+	// читает Entries — оба под registryMu.
+	entries []Entry
+}
+
+// NewRegistry — реестр поверх хранилища. В хранилище конструктор не ходит (ни Exists, ни Get) и
+// файла не заводит: пустой реестр от несуществующего отличается только на записи, и решает это
+// read — так прогон, который до архивации не дошёл, не создаёт пустой registry.jsonl.
+func NewRegistry(store Store) *Registry {
+	return &Registry{store: store}
+}
+
+// Ensure записывает версию в реестр. Ошибка — сбой архивации (§3.3): вызывающий не пишет строку
+// версии в source_publications, и следующий прогон повторит архив целиком, поэтому заметить и
+// разобрать сбой можно до того, как версия будет объявлена импортированной.
+func (r *Registry) Ensure(ctx context.Context, e Entry) error {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+
+	entries, err := r.read(ctx)
+	if err != nil {
+		return err
+	}
+	next, changed := upsert(entries, e)
+	if !changed {
+		// Изменений нет и Put не нужен: состояние — только что прочитанный файл, а не прежний слайс
+		// этого экземпляра, поэтому строки, добавленные соседним Registry, видны и в Entries.
+		r.entries = entries
+		return nil
+	}
+	body, err := marshalEntries(next)
+	if err != nil {
+		return err
+	}
+	if err = r.store.Put(ctx, RegistryKey, body); err != nil {
+		return fmt.Errorf("archive registry: запись %s: %w", RegistryKey, err)
+	}
+	// Состояние принимается только после успешного Put: иначе неудачная запись одной версии утекла
+	// бы в файл следующим Ensure — строкой на объект, которого в хранилище нет (Put объекта идёт до
+	// реестра и к этому моменту мог не состояться).
+	r.entries = next
+	return nil
+}
+
+// Entries — копия состояния после последнего завершённого Ensure этого экземпляра: вызывающий не
+// должен менять реестр через возвращённый слайс, а расхождение с файлом у источника истины дороже
+// копии в десяток записей. Замок тот же пакетный и здесь: поле пишет Ensure, а читает это чтение
+// параллельно с ним (гонку на поле ловит -race). До первого Ensure список пуст — реестр читается
+// на записи; прочитать файл целиком (зеркало, восстановление) можно Store.Get, реестр для того и
+// лежит в хранилище.
+func (r *Registry) Entries() []Entry {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	return append([]Entry(nil), r.entries...)
+}
+
+// read перечитывает реестр целиком — на каждой записи, потому что состояние реестра в процессе
+// общее, а экземпляры могут быть разными (см. комментарий к registryMu). Отсутствие файла — не
+// ошибка: самый первый прогон заводит его сам, поэтому «нет файла» и «файл пуст» — пустой реестр
+// (Review Focus №1). Битая строка, наоборот, ошибка: реестр объявлен источником истины, и
+// пропустить строку молча значит потерять версию — следующий Put записал бы файл уже без неё.
+func (r *Registry) read(ctx context.Context) ([]Entry, error) {
+	exists, err := r.store.Exists(ctx, RegistryKey)
+	if err != nil {
+		return nil, fmt.Errorf("archive registry: проверка %s: %w", RegistryKey, err)
+	}
+	if !exists {
+		return nil, nil
+	}
+	body, err := r.store.Get(ctx, RegistryKey)
+	if err != nil {
+		return nil, fmt.Errorf("archive registry: чтение %s: %w", RegistryKey, err)
+	}
+	return parseEntries(body)
+}
+
+// parseEntries разбирает JSONL и нумерует строки с единицы — по номеру дежурный находит битую
+// строку и в зеркале (docs/archive/registry.jsonl), и в файле на Диске. Пустая строка записи не
+// несёт и ошибкой не считается: перевод строки отделяет записи, и лишний мог оставить ручной
+// разбор или инструмент зеркала, тогда как терять при этом нечего.
+func parseEntries(body []byte) ([]Entry, error) {
+	var entries []Entry
+	for i, line := range strings.Split(string(body), "\n") {
+		if strings.TrimSpace(line) == "" {
+			continue
+		}
+		var e Entry
+		if err := json.Unmarshal([]byte(line), &e); err != nil {
+			return nil, fmt.Errorf("archive registry: %s: строка %d: %w", RegistryKey, i+1, err)
+		}
+		entries = append(entries, e)
+	}
+	return entries, nil
+}
+
+// upsert возвращает новое состояние реестра и признак изменения. Та же версия (совпали и Key, и
+// sha256) — изменений нет: сравниваются ровно эти поля, потому что версию называет key, а смену
+// содержимого — sha256 (§3.4). Замена — с переносом строки в конец: у изменившейся версии first_seen
+// новый (её увидели заново), а файл обязан быть упорядочен по first_seen, иначе порядок строк
+// перестал бы соответствовать полю, которым он объявлен. Возвращается копия, а не правка слайса
+// на месте: состояние принимается лишь после успешного Put, а строки соседей могли быть прочитаны
+// из файла в том же слайсе.
+func upsert(entries []Entry, e Entry) ([]Entry, bool) {
+	for i, old := range entries {
+		if old.Key != e.Key {
+			continue
+		}
+		if old.SHA256 == e.SHA256 {
+			return nil, false
+		}
+		next := append(slices.Clone(entries[:i]), entries[i+1:]...)
+		return append(next, e), true
+	}
+	return append(slices.Clone(entries), e), true
+}
+
+// marshalEntries собирает файл: одна запись — одна строка JSON, перевод строки — разделитель
+// (JSONL). Собирается весь файл целиком, потому что объект в хранилище пишется целиком. Encoder, а
+// не Marshal: SetEscapeHTML(false) оставляет «&» в url дословным (?id=1&lang=ru) — реестр уезжает в
+// git-зеркало и читается глазами, а \u0026 там только мешает искать. HTML-экранирование для JSON не
+// обязательно, на разбор строки это не влияет (Entry разбирается тем же encoding/json).
+func marshalEntries(entries []Entry) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	for _, e := range entries {
+		if err := enc.Encode(e); err != nil {
+			// Entry — плоские строки, число и время: сюда попасть нельзя. Но молча потерять запись
+			// хуже ошибки — её видит вызывающий и не пишет строку версии в source_publications.
+			return nil, fmt.Errorf("archive registry: %s: запись %q: %w", RegistryKey, e.Key, err)
+		}
+	}
+	return buf.Bytes(), nil
+}
diff --git a/archive/registry_test.go b/archive/registry_test.go
new file mode 100644
index 0000000..8bcdcd3
--- /dev/null
+++ b/archive/registry_test.go
@@ -0,0 +1,489 @@
+package archive
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// registryTestEntry — запись в том виде, в каком её собирает util после архивации версии: ключ из
+// Key (префикс отпечатка HEAD), sha256 фактического содержимого, размер, URL аудита. Имя входит и
+// в name, и в URL: выгрузки ЦБ и Росстата названы по-русски, и запись обязана доехать до зеркала
+// без искажений.
+func registryTestEntry(name, sum string, size int64) Entry {
+	return Entry{
+		Source:      "cbr_m2",
+		Name:        name,
+		Fingerprint: fp,
+		SHA256:      sum,
+		Size:        size,
+		URL:         "https://www.cbr.ru/vfs/macro/" + name,
+		Key:         Key("cbr_m2", name, fp, zeroSum),
+		FirstSeen:   time.Date(2026, 10, 14, 9, 20, 11, 0, time.FixedZone("MSK", 3*60*60)),
+	}
+}
+
+// sumHex — sha256 содержимого в hex, как его пишет util: у двух версий одного файла различается
+// ровно это поле (отпечаток HEAD при неизменных заголовках остаётся прежним, §3.2).
+func sumHex(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return hex.EncodeToString(sum[:])
+}
+
+// registryPutCounter считает записи в хранилище. Байты файла одинаковы и при перезаписи тем же
+// содержимым, поэтому «повторный Ensure не делает Put» иначе не отличить от «перезаписал то же
+// самое»; хранилище при этом настоящее — LocalStore в t.TempDir().
+type registryPutCounter struct {
+	Store
+	puts int
+}
+
+func (s *registryPutCounter) Put(ctx context.Context, key string, body []byte) error {
+	s.puts++
+	return s.Store.Put(ctx, key, body)
+}
+
+// registryBytes — байты registry.jsonl с диска, а не через Store: проверяется ровно тот файл,
+// который уезжает в git-зеркало и станет входом будущего восстановления.
+func registryBytes(t *testing.T, dir string) []byte {
+	t.Helper()
+	body, err := os.ReadFile(filepath.Join(dir, RegistryKey))
+	if err != nil {
+		t.Fatalf("чтение %s: %v", RegistryKey, err)
+	}
+	return body
+}
+
+// registryLines — строки файла реестра. JSONL: перевод строки отделяет записи, поэтому файл обязан
+// им заканчиваться, а последний перевод строки новой записи не создаёт.
+func registryLines(t *testing.T, dir string) []string {
+	t.Helper()
+	body := string(registryBytes(t, dir))
+	if body == "" {
+		return nil
+	}
+	if !strings.HasSuffix(body, "\n") {
+		t.Fatalf("реестр не заканчивается переводом строки: %q", body)
+	}
+	return strings.Split(strings.TrimSuffix(body, "\n"), "\n")
+}
+
+// decodedEntries — разобранные строки файла: тесты проверяют и порядок строк, и содержимое, но
+// именно по файлу, а не по памяти процесса.
+func decodedEntries(t *testing.T, dir string) []Entry {
+	t.Helper()
+	lines := registryLines(t, dir)
+	out := make([]Entry, 0, len(lines))
+	for i, line := range lines {
+		var e Entry
+		if err := json.Unmarshal([]byte(line), &e); err != nil {
+			t.Fatalf("строка %d реестра не разбирается как запись: %v (%s)", i+1, err, line)
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+// assertRegistryEntry — сравнение по полям: time.Time несравним через ==, а поле, потерянное из-за
+// неверного тега, видно именно здесь.
+func assertRegistryEntry(t *testing.T, got, want Entry) {
+	t.Helper()
+	if got.Source != want.Source || got.Name != want.Name || got.Fingerprint != want.Fingerprint ||
+		got.SHA256 != want.SHA256 || got.Size != want.Size || got.URL != want.URL || got.Key != want.Key {
+		t.Errorf("запись реестра = %+v, ожидалось %+v", got, want)
+	}
+	if !got.FirstSeen.Equal(want.FirstSeen) {
+		t.Errorf("first_seen = %s, ожидалось %s", got.FirstSeen, want.FirstSeen)
+	}
+}
+
+// Самый первый прогон: файла нет, и это не ошибка — Ensure заводит реестр одной строкой (Review
+// Focus №1). Формат пинится по файлу: одна JSON-строка, перевод строки в конце, ровно восемь
+// полей спеки §3.4 — потерянное поле лишает восстановление key/url/sha256.
+func TestRegistryEnsureCreatesMissingFile(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	want := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+
+	if err := NewRegistry(store).Ensure(ctx, want); err != nil {
+		t.Fatalf("Ensure в пустое хранилище: %v", err)
+	}
+	// Имя файла — часть контракта: по нему реестр находят зеркало, ARCHIVE_ACTION=registry и будущее
+	// восстановление, поэтому проверяется литералом на диске, а не сравнением с константой, из
+	// которой собран путь в хелперах теста.
+	if _, err := os.Stat(filepath.Join(dir, "registry.jsonl")); err != nil {
+		t.Errorf("файла с ожидаемым именем в каталоге архива нет: %v", err)
+	}
+
+	lines := registryLines(t, dir)
+	if len(lines) != 1 {
+		t.Fatalf("строк в реестре %d, ожидалась 1:\n%s", len(lines), strings.Join(lines, "\n"))
+	}
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(lines[0]), &raw); err != nil {
+		t.Fatalf("строка реестра не JSON-объект: %v (%s)", err, lines[0])
+	}
+	if len(raw) != 8 {
+		t.Errorf("полей в строке %d, ожидалось 8: %s", len(raw), lines[0])
+	}
+	for _, field := range []string{"source", "name", "fingerprint", "sha256", "size", "url", "key", "first_seen"} {
+		if _, ok := raw[field]; !ok {
+			t.Errorf("в строке реестра нет поля %q: %s", field, lines[0])
+		}
+	}
+	assertRegistryEntry(t, decodedEntries(t, dir)[0], want)
+}
+
+// Пустой файл — тоже пустой реестр (Review Focus №1): обнулённый или потерянный реестр не должен
+// ронять архивацию, Ensure заводит в нём первую строку. Ошибка здесь означала бы, что после сбоя
+// инструмента зеркала архив перестал пополняться, и версии терялись бы молча.
+func TestRegistryEnsureEmptyFile(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	want := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+	if err := os.WriteFile(filepath.Join(dir, RegistryKey), nil, 0o644); err != nil {
+		t.Fatalf("подготовка пустого %s: %v", RegistryKey, err)
+	}
+
+	if err := NewRegistry(store).Ensure(ctx, want); err != nil {
+		t.Fatalf("Ensure в пустой реестр: %v", err)
+	}
+
+	if lines := registryLines(t, dir); len(lines) != 1 {
+		t.Fatalf("строк в реестре %d, ожидалась 1:\n%s", len(lines), strings.Join(lines, "\n"))
+	}
+	assertRegistryEntry(t, decodedEntries(t, dir)[0], want)
+}
+
+// Повторная архивация той же версии (тот же Key, тот же sha256) — не запись: байты файла обязаны
+// остаться прежними, а Put — не состояться (перезапись тем же содержимым стоила бы запроса к
+// хранилищу на каждый прогон каждого импортёра, а на Диске это ещё и лишний трафик). Первый
+// повтор идёт в тот же Registry (версия уже в памяти), второй — в новый (следующий прогон: реестр
+// читается с нуля, и «уже записано» видно по файлу).
+func TestRegistryEnsureIsIdempotent(t *testing.T) {
+	dir := t.TempDir()
+	store := &registryPutCounter{Store: NewLocal(dir)}
+	ctx := context.Background()
+	e := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+
+	reg := NewRegistry(store)
+	if err := reg.Ensure(ctx, e); err != nil {
+		t.Fatalf("первый Ensure: %v", err)
+	}
+	if store.puts != 1 {
+		t.Fatalf("после первой записи Put вызван %d раз, ожидался 1", store.puts)
+	}
+	before := registryBytes(t, dir)
+
+	for _, repeat := range []*Registry{reg, NewRegistry(store)} {
+		if err := repeat.Ensure(ctx, e); err != nil {
+			t.Fatalf("повторный Ensure: %v", err)
+		}
+	}
+	if after := registryBytes(t, dir); !bytes.Equal(before, after) {
+		t.Errorf("повторный Ensure изменил файл реестра:\nдо:    %q\nпосле: %q", before, after)
+	}
+	if store.puts != 1 {
+		t.Errorf("повторный Ensure сделал Put (%d вызовов против 1): содержимое не менялось", store.puts)
+	}
+	if lines := registryLines(t, dir); len(lines) != 1 {
+		t.Errorf("строк в реестре %d, ожидалась 1", len(lines))
+	}
+}
+
+// Содержимое версии под тем же Key изменилось (заголовки те же — sha256 другой): строка заменяется,
+// число строк не растёт (last-wins, §3.4). Прежняя версия в реестре не остаётся: две строки на один
+// key сломали бы поиск версии при восстановлении. Заменённая строка уезжает в конец с новым
+// first_seen — версию увидели заново, а файл обязан быть упорядочен по этому полю (§3.4), иначе
+// порядок строк перестал бы соответствовать ему. Ensure идёт из нового Registry: версия могла
+// смениться между прогонами, и решение принимается по файлу, а не по памяти процесса.
+func TestRegistryEnsureReplacesChangedContent(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	first := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+	other := registryTestEntry("other.xlsx", sumHex("другой файл"), 10)
+	// Время версий разное: по нему проверяется порядок строк, а не только их число.
+	other.FirstSeen = other.FirstSeen.Add(time.Hour)
+	second := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия вторая"), 601233)
+	second.FirstSeen = other.FirstSeen.Add(time.Hour)
+	if first.Key != second.Key {
+		t.Fatalf("ключи тестовых записей разошлись: %q и %q", first.Key, second.Key)
+	}
+
+	reg := NewRegistry(store)
+	for _, e := range []Entry{first, other} {
+		if err := reg.Ensure(ctx, e); err != nil {
+			t.Fatalf("Ensure %s: %v", e.Key, err)
+		}
+	}
+	if err := NewRegistry(store).Ensure(ctx, second); err != nil {
+		t.Fatalf("Ensure изменившейся версии: %v", err)
+	}
+
+	entries := decodedEntries(t, dir)
+	if len(entries) != 2 {
+		t.Fatalf("строк в реестре %d, ожидалось 2 (замена, а не дописывание):\n%+v", len(entries), entries)
+	}
+	assertRegistryEntry(t, entries[0], other)  // соседка поднялась выше
+	assertRegistryEntry(t, entries[1], second) // изменившаяся версия — последняя строка
+	for i := 1; i < len(entries); i++ {
+		if entries[i].FirstSeen.Before(entries[i-1].FirstSeen) {
+			t.Errorf("строка %d (%s) старее предыдущей (%s): файл перестал быть упорядочен по first_seen",
+				i+1, entries[i].FirstSeen, entries[i-1].FirstSeen)
+		}
+	}
+}
+
+// Новый ключ дописывается строкой ниже: порядок строк — порядок добавления (first_seen, §3.4),
+// поэтому реестр читается сверху вниз как история архива, а не как случайный набор версий.
+func TestRegistryAppendsNewKeys(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	first := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+	second := registryTestEntry("other.xlsx", sumHex("другой файл"), 10)
+
+	if err := NewRegistry(store).Ensure(ctx, first); err != nil {
+		t.Fatalf("Ensure первой версии: %v", err)
+	}
+	// Второй ключ — из нового Registry: так выглядит следующий прогон, реестр читается из файла.
+	if err := NewRegistry(store).Ensure(ctx, second); err != nil {
+		t.Fatalf("Ensure второй версии: %v", err)
+	}
+
+	entries := decodedEntries(t, dir)
+	if len(entries) != 2 {
+		t.Fatalf("строк в реестре %d, ожидалось 2:\n%+v", len(entries), entries)
+	}
+	assertRegistryEntry(t, entries[0], first)
+	assertRegistryEntry(t, entries[1], second)
+}
+
+// Entries отдаёт копию: правка возвращённого слайса не должна менять ни состояние реестра, ни
+// файл — иначе случайная мутация у вызывающего разошлась бы с реестром, объявленным источником
+// истины. До первого Ensure список пуст: файл читается лениво и только тогда, когда нужен записи.
+func TestRegistryEntriesReturnsCopy(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	e := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+
+	reg := NewRegistry(store)
+	if got := reg.Entries(); len(got) != 0 {
+		t.Errorf("до первого Ensure Entries вернул %d записей, ожидалось 0", len(got))
+	}
+	if err := reg.Ensure(ctx, e); err != nil {
+		t.Fatalf("Ensure: %v", err)
+	}
+	before := registryBytes(t, dir)
+
+	got := reg.Entries()
+	if len(got) != 1 {
+		t.Fatalf("Entries вернул %d записей, ожидалась 1", len(got))
+	}
+	got[0].SHA256 = sumHex("подмена")
+	got[0].Key = "cbr_m2/подмена.xlsx"
+	got[0].FirstSeen = time.Now()
+
+	again := reg.Entries()
+	if len(again) != 1 {
+		t.Fatalf("после правки копии Entries вернул %d записей, ожидалась 1", len(again))
+	}
+	assertRegistryEntry(t, again[0], e)
+	if after := registryBytes(t, dir); !bytes.Equal(before, after) {
+		t.Errorf("правка копии изменила файл реестра:\nдо:    %q\nпосле: %q", before, after)
+	}
+}
+
+// Битая строка реестра — ошибка, а не пропуск: реестр объявлен источником истины, и молча
+// потерянная строка означает потерянную версию — следующий Ensure записал бы файл уже без неё.
+// По той же причине при ошибке разбора файл не перезаписывается: прежнее содержимое остаётся для
+// разбора дежурным (номер битой строки — в тексте ошибки).
+func TestRegistryBrokenLineIsError(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	good := `{"source":"cbr_m2","name":"full.xlsx","fingerprint":"` + fp + `","sha256":"b7d1","size":1,` +
+		`"url":"https://www.cbr.ru/vfs/macro/full.xlsx","key":"cbr_m2/` + fp16 + `_full.xlsx",` +
+		`"first_seen":"2026-10-14T09:20:11+03:00"}`
+	body := []byte(good + "\n" + `{"source":"cbr_m2",` + "\n")
+	if err := os.WriteFile(filepath.Join(dir, RegistryKey), body, 0o644); err != nil {
+		t.Fatalf("подготовка реестра: %v", err)
+	}
+
+	err := NewRegistry(store).Ensure(ctx, registryTestEntry("other.xlsx", sumHex("версия вторая"), 10))
+	if err == nil {
+		t.Fatal("Ensure на реестре с битой строкой не дал ошибки")
+	}
+	if !strings.Contains(err.Error(), "строка 2") {
+		t.Errorf("в ошибке нет номера битой строки: %v", err)
+	}
+	if after := registryBytes(t, dir); !bytes.Equal(body, after) {
+		t.Errorf("при ошибке разбора реестр перезаписан:\nбыло:  %q\nстало: %q", body, after)
+	}
+}
+
+// registryFailOnceStore — хранилище, у которого первая запись падает. Хранилище настоящее
+// (LocalStore в t.TempDir()): отказывает только Put, поэтому проверяется поведение реестра, а не
+// подмена хранилища.
+type registryFailOnceStore struct {
+	Store
+	fail bool
+}
+
+func (s *registryFailOnceStore) Put(ctx context.Context, key string, body []byte) error {
+	if s.fail {
+		s.fail = false
+		return errors.New("registry_test: запись в хранилище недоступна")
+	}
+	return s.Store.Put(ctx, key, body)
+}
+
+// Два экземпляра реестра на одном хранилище — это один реестр: файл перечитывается на каждой записи
+// под пакетным мьютексом, поэтому строки, добавленные «соседом» (самолечение архива в другом
+// импортёре, два вызывающих в одном процессе), не теряются. С кэшем на экземпляре трасса ниже
+// оставляла бы в файле A и C: второй Ensure первого Registry не видел строки B и затёр бы её своим
+// состоянием.
+func TestRegistryInstancesShareState(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	first := registryTestEntry("first.xlsx", sumHex("версия первая"), 1)
+	second := registryTestEntry("second.xlsx", sumHex("версия вторая"), 2)
+	third := registryTestEntry("third.xlsx", sumHex("версия третья"), 3)
+
+	r1, r2 := NewRegistry(store), NewRegistry(store)
+	for _, step := range []struct {
+		reg *Registry
+		e   Entry
+	}{{r1, first}, {r2, second}, {r1, third}} {
+		if err := step.reg.Ensure(ctx, step.e); err != nil {
+			t.Fatalf("Ensure %s: %v", step.e.Key, err)
+		}
+	}
+
+	entries := decodedEntries(t, dir)
+	if len(entries) != 3 {
+		t.Fatalf("строк в реестре %d, ожидалось 3 (строка второго Registry потеряна):\n%+v", len(entries), entries)
+	}
+	for i, want := range []Entry{first, second, third} {
+		assertRegistryEntry(t, entries[i], want)
+	}
+	if got := r1.Entries(); len(got) != 3 {
+		t.Errorf("Entries первого Registry вернул %d записей, ожидалось 3: состояние берётся из файла, а не из кэша экземпляра", len(got))
+	}
+}
+
+// url выгрузки почти всегда с query-параметрами, и «&» обязан лежать в файле дословно: реестр —
+// ещё и git-зеркало, которое читают и ищут глазами (docs/archive/registry.jsonl), а \u0026 ищется не
+// как url у источника. HTML-экранирование для JSON не обязательно, на разбор строки не влияет.
+func TestRegistryURLWithoutHTMLEscaping(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	e := registryTestEntry("list.xlsx", sumHex("версия первая"), 10)
+	e.URL = "https://www.cbr.ru/vfs/macro/list.xlsx?id=1&lang=ru"
+
+	if err := NewRegistry(store).Ensure(ctx, e); err != nil {
+		t.Fatalf("Ensure: %v", err)
+	}
+
+	line := registryLines(t, dir)[0]
+	if !strings.Contains(line, e.URL) {
+		t.Errorf("url лежит в файле не дословно: %s", line)
+	}
+	if strings.Contains(line, `\u0026`) {
+		t.Errorf("«&» в url экранирован: %s", line)
+	}
+	assertRegistryEntry(t, decodedEntries(t, dir)[0], e)
+}
+
+// Сбой Put — сбой архивации (§3.3): файл остаётся ровно таким, каким был, состояние не принимается
+// (Entries не показывает строку, которой в файле нет), а следующий Ensure повторяет запись, и версия
+// доезжает. Без этого неудачная запись одной версии «вылечилась» бы следующим Ensure, который
+// записал бы состояние в памяти — строкой на объект, которого в хранилище нет.
+func TestRegistryPutFailureKeepsState(t *testing.T) {
+	dir := t.TempDir()
+	store := &registryFailOnceStore{Store: NewLocal(dir)}
+	ctx := context.Background()
+	first := registryTestEntry("monetary_agg_SA.xlsx", sumHex("версия первая"), 583746)
+	second := registryTestEntry("other.xlsx", sumHex("другой файл"), 10)
+	reg := NewRegistry(store)
+	if err := reg.Ensure(ctx, first); err != nil {
+		t.Fatalf("Ensure первой версии: %v", err)
+	}
+	before := registryBytes(t, dir)
+
+	store.fail = true
+	if err := reg.Ensure(ctx, second); err == nil {
+		t.Fatal("Ensure при падающем Put не дал ошибки")
+	}
+	if after := registryBytes(t, dir); !bytes.Equal(before, after) {
+		t.Errorf("после сбоя Put файл реестра изменился:\nдо:    %q\nпосле: %q", before, after)
+	}
+	if got := reg.Entries(); len(got) != 1 {
+		t.Errorf("после сбоя Put Entries вернул %d записей, ожидалась 1 (состояние не принято):\n%+v", len(got), got)
+	}
+
+	if err := reg.Ensure(ctx, second); err != nil {
+		t.Fatalf("Ensure после восстановления хранилища: %v", err)
+	}
+	entries := decodedEntries(t, dir)
+	if len(entries) != 2 {
+		t.Fatalf("строк в реестре %d, ожидалось 2 (повторная запись не состоялась):\n%+v", len(entries), entries)
+	}
+	assertRegistryEntry(t, entries[0], first)
+	assertRegistryEntry(t, entries[1], second)
+}
+
+// Мьютекс разводит писателей внутри процесса: файл пишется целиком, поэтому два Ensure из горутин
+// одного процесса (самолечение архива в соседнем импортёре, ручной прогон рядом с dagu) в
+// read-modify-write затёрли бы строку друг друга. Проверяется на -race: гонки нет, и все записи
+// на месте.
+func TestRegistryConcurrentEnsure(t *testing.T) {
+	dir := t.TempDir()
+	store := NewLocal(dir)
+	ctx := context.Background()
+	reg := NewRegistry(store)
+	const writers = 8
+
+	var wg sync.WaitGroup
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			name := fmt.Sprintf("file_%d.xlsx", i)
+			if err := reg.Ensure(ctx, registryTestEntry(name, sumHex(name), int64(i))); err != nil {
+				t.Errorf("Ensure %s: %v", name, err)
+			}
+			reg.Entries() // чтение параллельно записи: так реестр читает соседний вызывающий
+		}(i)
+	}
+	wg.Wait()
+
+	entries := decodedEntries(t, dir)
+	if len(entries) != writers {
+		t.Fatalf("строк в реестре %d, ожидалось %d (потеря записи при конкурентном Ensure):\n%+v",
+			len(entries), writers, entries)
+	}
+	seen := make(map[string]bool, writers)
+	for _, e := range entries {
+		seen[e.Key] = true
+	}
+	if len(seen) != writers {
+		t.Errorf("уникальных ключей в реестре %d, ожидалось %d", len(seen), writers)
+	}
+}
diff --git a/archive/store.go b/archive/store.go
new file mode 100644
index 0000000..bb101e3
--- /dev/null
+++ b/archive/store.go
@@ -0,0 +1,38 @@
+// Package archive хранит версии файлов источников: одна версия файла — один объект в хранилище
+// плюс строка реестра увиденных версий. Нужен потому, что выгрузки источников обновляются реже
+// прогонов конвейера: после публикации новой версии прежняя с сайта исчезает, и восстановить по
+// ней ряд (или объяснить расхождение в витрине) уже нечем. Архив не дублирует данные — истина о
+// рядах остаётся в ClickHouse; архив отвечает только на вопрос «что именно импортировали тогда».
+package archive
+
+import (
+	"context"
+	"errors"
+)
+
+// ErrAuth — токен не принят (401): отозван, истёк или выдан без нужного scope. Отдельный
+// sentinel, а не текст: действие дежурного по логу другое, чем при квоте, — обновить токен.
+// Обёртывается через %w, поэтому проверяется errors.Is, а не сравнением строк.
+var ErrAuth = errors.New("archive: токен не принят (401)")
+
+// ErrQuota — квота или лимит хранилища (403/413/423/507): место кончилось либо файл больше
+// разрешённого. Второй различимый случай (спека §3.3): «токен» и «квота» требуют разных действий.
+var ErrQuota = errors.New("archive: квота или лимит хранилища (403/413/423/507)")
+
+// Store — объектное хранилище версий файлов. Контракт минимален под два бэкенда: Яндекс.Диск
+// (upload/download/resources) сегодня и S3 (PutObject/GetObject/HeadObject) — потом; вызывающему
+// нужны ровно три операции — записать байты, прочитать их и спросить наличие. Ключи относительные,
+// с «/»-разделителями; корень навешивает бэкенд, поэтому смена хранилища или его каталога не
+// меняет ключи (и не расходится с ними реестр).
+type Store interface {
+	// Name — "local" | "yandex": попадает в логи и реестр, чтобы по записи было видно бэкенд.
+	Name() string
+	// Put записывает версию целиком (ключ и есть версия: второй Put того же ключа — не ошибка).
+	Put(ctx context.Context, key string, body []byte) error
+	// Get отдаёт байты версии: реестр, тесты и восстановление из архива — названный follow-up
+	// этого пункта (спека §1.3), ради которого объекты и хранятся целиком, а не хешами.
+	Get(ctx context.Context, key string) ([]byte, error)
+	// Exists — есть ли версия. Единственная операция префлайта на no-op-пути: «версия известна, но
+	// не в архиве» проверяется без чтения реестра и без ClickHouse (спека §3.2).
+	Exists(ctx context.Context, key string) (bool, error)
+}
diff --git a/archive/yandex.go b/archive/yandex.go
new file mode 100644
index 0000000..d442e41
--- /dev/null
+++ b/archive/yandex.go
@@ -0,0 +1,359 @@
+package archive
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// defaultYandexAPI — адрес REST API Диска. Константа, а не переменная окружения: адрес API — не
+// конфигурация конвейера, а его знание; подменяется он только тестами (httptest) через baseURL.
+const defaultYandexAPI = "https://cloud-api.yandex.net/v1/disk"
+
+// opTimeout — дедлайн одной операции Store (Put/Get/Exists). Переменная, а не константа, потому что
+// тесты подменяют её коротким значением. Дедлайн обязателен именно здесь: util.HttpClient создан
+// без Timeout (правило 4 AGENTS.md), а зависший Диск не должен держать прогон — архив объявлен
+// опцией, сбой которой не останавливает данные (спека §3.1).
+var opTimeout = 2 * time.Minute
+
+// retrySleeps — паузы между попытками шага: две паузы — до трёх попыток. 429 и 503 Диск отдаёт на
+// всплеск запросов и на свои работы, а повтор дешевле сбоя архивации: сбой архивации — это сбой
+// записи версии (спека §3.3), то есть следующий прогон пойдёт в полный импорт. Переменная: тесты
+// подменяют паузы миллисекундой.
+var retrySleeps = []time.Duration{time.Second, 2 * time.Second}
+
+// Операции в текстах ошибок: дежурный по логу видит, на каком шаге сломалось, и правит либо токен,
+// либо корень архива, а не ищет шаг по коду.
+const (
+	opMkdir        = "создание папки"
+	opUploadHref   = "получение ссылки на загрузку"
+	opUpload       = "загрузка"
+	opDownloadHref = "получение ссылки на скачивание"
+	opDownload     = "скачивание"
+	opExists       = "проверка наличия"
+)
+
+// YandexDisk — хранилище версий на Яндекс.Диске через REST API (resources/upload/download).
+// Своего каталога не знает: путь на Диске собирается из корня архива и относительного ключа,
+// поэтому смена корня не меняет ключи, а смена бэкенда — реестр и таблицу версий. Каталоги бэкенд
+// заводит сам: иначе первая же архивация в новый корень падала бы «путь не найден», то есть архив
+// пришлось бы заводить руками — и пропущенный шаг заметили бы только при попытке восстановления,
+// когда файла у источника уже нет.
+type YandexDisk struct {
+	token   string       // OAuth-токен: живёт в этом поле и в заголовке к API, дальше никуда не идёт
+	root    string       // корень архива на Диске вида disk:/rosstat-archive
+	baseURL string       // адрес API; в проде пуст → defaultYandexAPI, в тестах — httptest-сервер
+	hc      *http.Client // клиент вызывающего: у прода util.HttpClient (TLS-сертификаты РФ)
+}
+
+// YandexDisk обязан удовлетворять Store: бэкенды подставляются друг вместо друга (local в dev и
+// на приёмке, Диск в проде), и расхождение сигнатур должно ломать сборку, а не прогон.
+var _ Store = (*YandexDisk)(nil)
+
+// NewYandex — хранилище на Диске. hc обязателен и не подменяется своим: прод передаёт
+// util.HttpClient, единственный в проекте клиент с национальными TLS-сертификатами (правило 4
+// AGENTS.md). baseURL пуст в проде и задаётся тестами.
+func NewYandex(token, root, baseURL string, hc *http.Client) *YandexDisk {
+	if baseURL == "" {
+		baseURL = defaultYandexAPI
+	}
+	return &YandexDisk{token: token, root: root, baseURL: baseURL, hc: hc}
+}
+
+func (s *YandexDisk) Name() string {
+	return "yandex"
+}
+
+func (s *YandexDisk) Put(ctx context.Context, key string, body []byte) error {
+	// Дедлайн — на операцию целиком, а не на отдельный запрос: файл выгрузки уходит на Диск одним
+	// телом, и таймаут на запрос обрывал бы загрузку на медленном канале, тогда как смысл дедлайна —
+	// не дать зависшему хранилищу держать прогон.
+	ctx, cancel := context.WithTimeout(ctx, opTimeout)
+	defer cancel()
+
+	diskPath := s.diskPath(key)
+	for _, dir := range dirsToCreate(diskPath) {
+		if err := s.mkdir(ctx, dir); err != nil {
+			return err
+		}
+	}
+	href, err := s.signedHref(ctx, opUploadHref, diskPath, "/resources/upload",
+		url.Values{"path": {diskPath}, "overwrite": {"true"}})
+	if err != nil {
+		return err
+	}
+	return s.upload(ctx, diskPath, href, body)
+}
+
+func (s *YandexDisk) Get(ctx context.Context, key string) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(ctx, opTimeout)
+	defer cancel()
+
+	diskPath := s.diskPath(key)
+	href, err := s.signedHref(ctx, opDownloadHref, diskPath, "/resources/download",
+		url.Values{"path": {diskPath}})
+	if err != nil {
+		return nil, err
+	}
+	body, status, err := s.do(ctx, opDownload, diskPath, http.MethodGet, href, nil, false)
+	if err != nil {
+		return nil, err
+	}
+	if status != http.StatusOK {
+		// Тело не передаётся: ответ пришёл от хоста по подписанной ссылке, а её подпись в тексте
+		// ошибки — утечка (statusError).
+		return nil, statusError(opDownload, diskPath, status, nil)
+	}
+	return body, nil
+}
+
+// Exists — есть ли версия: GET ресурса отвечает метаданными объекта (200) или «не найдено» (404).
+// Отдельной ручки «проверить» у Диска нет, но метаданных и достаточно: префлайт спрашивает только
+// «есть или нет», чтобы не качать файл зря (спека §3.2).
+func (s *YandexDisk) Exists(ctx context.Context, key string) (bool, error) {
+	ctx, cancel := context.WithTimeout(ctx, opTimeout)
+	defer cancel()
+
+	diskPath := s.diskPath(key)
+	reqURL := s.apiURL("/resources", url.Values{"path": {diskPath}})
+	body, status, err := s.do(ctx, opExists, diskPath, http.MethodGet, reqURL, nil, true)
+	if err != nil {
+		return false, err
+	}
+	switch status {
+	case http.StatusOK:
+		return true, nil
+	case http.StatusNotFound:
+		// «Нет объекта» — ответ, а не ошибка: тем же (false, nil) заканчивается LocalStore.Exists,
+		// иначе префлайт принимал бы штатный ответ «версии нет» за сбой проверки.
+		return false, nil
+	}
+	// body — запрос к API с токеном: тело безопасно для лога и различает причины одного кода (statusError).
+	return false, statusError(opExists, diskPath, status, body)
+}
+
+// mkdir заводит один каталог. 409 — успех: так Диск отвечает на уже существующую папку, и без
+// этого второй Put в тот же каталог источника падал бы всегда, то есть архив работал бы ровно один
+// раз на источник.
+func (s *YandexDisk) mkdir(ctx context.Context, dir string) error {
+	const endpoint = "/resources"
+	body, status, err := s.do(ctx, opMkdir, dir, http.MethodPut, s.apiURL(endpoint, url.Values{"path": {dir}}), nil, true)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusCreated && status != http.StatusConflict {
+		// body — запрос к API с токеном: по фрагменту ответа дежурный различает «нет прав» и «нет места».
+		return statusError(opMkdir, dir, status, body)
+	}
+	return nil
+}
+
+// signedHref спрашивает у ручки ресурсов подписанную ссылку на загрузку или скачивание. Сама ссылка
+// дальше живёт в локальной переменной: в лог и в тексты ошибок она не попадает — в её query вшито
+// право на запись/чтение объекта, то есть временный секрет (спека §3.3).
+func (s *YandexDisk) signedHref(ctx context.Context, op, diskPath, endpoint string, params url.Values) (string, error) {
+	body, status, err := s.do(ctx, op, diskPath, http.MethodGet, s.apiURL(endpoint, params), nil, true)
+	if err != nil {
+		return "", err
+	}
+	if status != http.StatusOK {
+		// body — ответ ручки API, а не хоста по ссылке: href в нём не содержится, и фрагмент помогает
+		// отличить «нет прав» (токен выдан без scope) от квоты (statusError).
+		return "", statusError(op, diskPath, status, body)
+	}
+	var resp struct {
+		Href string `json:"href"`
+	}
+	if err = json.Unmarshal(body, &resp); err != nil {
+		return "", fmt.Errorf("%s %s: разбор ответа: %w", op, diskPath, err)
+	}
+	// Пустая ссылка — ошибка сразу: запрос на пустой URL дал бы «unsupported protocol scheme», и по
+	// такому тексту дежурный не понял бы, что Диск не выдал ссылку.
+	if resp.Href == "" {
+		return "", fmt.Errorf("%s %s: Диск не вернул ссылку", op, diskPath)
+	}
+	return resp.Href, nil
+}
+
+// upload кладёт тело на подписанную ссылку. Токен туда не добавляется: ссылка уже авторизована, а
+// лишний заголовок унёс бы секрет на хост загрузчика. 201 и 202 равноправны — 202 Диск отдаёт,
+// когда загрузка встаёт в очередь.
+func (s *YandexDisk) upload(ctx context.Context, diskPath, href string, body []byte) error {
+	_, status, err := s.do(ctx, opUpload, diskPath, http.MethodPut, href, body, false)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusCreated && status != http.StatusAccepted {
+		// Тело не передаётся: отвечал хост по подписанной ссылке (см. statusError).
+		return statusError(opUpload, diskPath, status, nil)
+	}
+	return nil
+}
+
+// do выполняет один HTTP-шаг с повторами и возвращает тело и статус последней попытки. Повтор — на
+// шаг, а не на операцию: повторять ручку ссылки дешевле, чем перекачивать тело файла выгрузки.
+// Запрос строится заново на каждую попытку, потому что body — reader, израсходованный первой
+// попыткой. withToken включает авторизацию: к API — с токеном, по подписанной ссылке — без него.
+func (s *YandexDisk) do(ctx context.Context, op, diskPath, method, rawURL string, body []byte, withToken bool) ([]byte, int, error) {
+	for attempt := 0; ; attempt++ {
+		if attempt > 0 {
+			if err := sleep(ctx, retrySleeps[attempt-1]); err != nil {
+				return nil, 0, fmt.Errorf("%s %s: %w", op, diskPath, err)
+			}
+		}
+		req, err := http.NewRequestWithContext(ctx, method, rawURL, bytes.NewReader(body))
+		if err != nil {
+			// Разбор URL тоже отдаёт *url.Error с адресом запроса, а им бывает подписанная ссылка.
+			return nil, 0, fmt.Errorf("%s %s: %w", op, diskPath, transportError(err))
+		}
+		if withToken {
+			req.Header.Set("Authorization", "OAuth "+s.token)
+		}
+		resp, err := s.hc.Do(req)
+		if err != nil {
+			// Причина сбоя — без URL запроса: у запросов по ссылке URL и есть подписанный href,
+			// а текст ошибки уходит в лог (см. transportError).
+			return nil, 0, fmt.Errorf("%s %s: %w", op, diskPath, transportError(err))
+		}
+		respBody, readErr := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		if readErr != nil {
+			return nil, 0, fmt.Errorf("%s %s: чтение ответа: %w", op, diskPath, readErr)
+		}
+		// 429 и 503 — «сбавь темп», а не отказ: шаг повторяется, пока в запасе есть пауза.
+		if resp.StatusCode == http.StatusTooManyRequests || resp.StatusCode == http.StatusServiceUnavailable {
+			if attempt < len(retrySleeps) {
+				continue
+			}
+		}
+		return respBody, resp.StatusCode, nil
+	}
+}
+
+// errSnippetLimit — сколько байт тела ответа Диска остаётся в тексте ошибки: дежурному нужна причина
+// («недостаточно прав», «квота»), а не весь ответ ручки.
+const errSnippetLimit = 200
+
+// errSnippet сжимает тело ответа до одной строки не длиннее errSnippetLimit байт. Локальная копия
+// util.ErrorSnippet, а не импорт: util уже импортирует archive, и обратная зависимость замкнула бы
+// цикл импортов. Пустое тело — пустая строка: текст ошибки и без того называет шаг и путь, и
+// подставлять в него «(пустое тело)» незачем. Обрезка идёт по байту, а нечитаемая руна на срезе
+// вычищается ToValidUTF8: в ответах Диска бывает кириллица, и разрезанная посреди неё строка
+// уехала бы в лог мусором.
+func errSnippet(body []byte) string {
+	snippet := strings.Join(strings.Fields(string(body)), " ")
+	if snippet == "" {
+		return ""
+	}
+	if len(snippet) > errSnippetLimit {
+		snippet = strings.ToValidUTF8(snippet[:errSnippetLimit], "") + "…"
+	}
+	return snippet
+}
+
+// statusError — ошибка шага по коду ответа. 401 и «квота» (403/413/423/507) оборачивают sentinel-
+// ошибки из store.go: по ним дежурный различает «обновить токен» и «освободить место» (спека §3.2),
+// и проверяются они через errors.Is, а не по тексту. Остальные коды — обычная ошибка с номером, по
+// которому причину ищут в API Диска. В тексте — путь на Диске, а не URL запроса: правится именно он.
+//
+// Тело ответа добавляется к тексту фрагментом (errSnippet): один и тот же 403 Диск отдаёт и при
+// исчерпанной квоте, и при нехватке прав у токена (выдан без scope на disk:/, часто при app:/), а
+// дежурному по одному коду не выбрать — освобождать место или перевыпускать токен. Фрагмент
+// передаётся только у запросов к API: ответы хостов по подписанной ссылке (загрузчик, файловый хост)
+// бывают HTML-страницей, повторяющей URL запроса вместе с подписью, а подпись — временный секрет
+// (см. signedHref), поэтому там тело в текст ошибки не берётся.
+func statusError(op, diskPath string, status int, body []byte) error {
+	tail := ""
+	if snippet := errSnippet(body); snippet != "" {
+		tail = "; ответ Диска: " + snippet
+	}
+	switch status {
+	case http.StatusUnauthorized:
+		return fmt.Errorf("%s %s: %w%s", op, diskPath, ErrAuth, tail)
+	case http.StatusForbidden, http.StatusRequestEntityTooLarge, http.StatusLocked, http.StatusInsufficientStorage:
+		return fmt.Errorf("%s %s: %w%s", op, diskPath, ErrQuota, tail)
+	default:
+		return fmt.Errorf("%s %s: статус %d%s", op, diskPath, status, tail)
+	}
+}
+
+// transportError убирает URL из ошибки транспорта: http.Client оборачивает сбой в *url.Error, чей
+// текст содержит адрес запроса, а адрес загрузки и скачивания — подписанная ссылка href. Причина
+// сбоя (отказ соединения, дедлайн) сохраняется: она и нужна логу, чтобы дежурный понял, что чинить.
+func transportError(err error) error {
+	var uerr *url.Error
+	if errors.As(err, &uerr) {
+		return uerr.Err
+	}
+	return err
+}
+
+// sleep — пауза между попытками, прерываемая отменой контекста: остановленный прогон не должен
+// ждать её до конца.
+func sleep(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+// diskPath — путь объекта на Диске: корень архива плюс относительный ключ. Ключ задаёт вызывающий
+// (Key), корень навешивает бэкенд — поэтому один и тот же архив читается из разных корней.
+func (s *YandexDisk) diskPath(key string) string {
+	return s.root + "/" + key
+}
+
+// apiURL — адрес ручки API с query-параметрами. path идёт значением параметра, а не частью пути:
+// иначе «disk:/» и кириллица в имени файла разъехались бы по URL.
+func (s *YandexDisk) apiURL(endpoint string, params url.Values) string {
+	return s.baseURL + endpoint + "?" + params.Encode()
+}
+
+// dirsToCreate — каталоги, которые надо завести перед записью объекта: все уровни пути на Диске,
+// кроме последнего (самого объекта). Ручка ресурсов заводит одну папку за вызов и требует
+// существующего родителя, поэтому уровни перебираются от корня архива: корень бывает вложенным
+// (в dev и на приёмке ARCHIVE_YANDEX_DIR разный), а всё выше схемы — диск пользователя, он есть
+// всегда. Схема («disk:») отделяется, чтобы склейка не дала «disk://rosstat-archive».
+func dirsToCreate(diskPath string) []string {
+	scheme, rest := "", diskPath
+	if i := strings.Index(diskPath, ":"); i >= 0 {
+		scheme, rest = diskPath[:i+1], diskPath[i+1:]
+	}
+	parts := splitDiskPath(rest)
+	dirs := make([]string, 0, len(parts))
+	for i := 1; i < len(parts); i++ {
+		dirs = append(dirs, joinDiskPath(scheme, parts[:i]))
+	}
+	return dirs
+}
+
+// splitDiskPath режет путь на компоненты, выбрасывая пустые: «/a//b» и «/a/b» — один путь, и лишний
+// слэш на стыке корня и ключа не должен превращаться в отдельный уровень.
+func splitDiskPath(path string) []string {
+	var parts []string
+	for _, part := range strings.Split(path, "/") {
+		if part != "" {
+			parts = append(parts, part)
+		}
+	}
+	return parts
+}
+
+// joinDiskPath склеивает компоненты обратно со схемой: «disk:» + «/rosstat-archive/cbr_m2».
+func joinDiskPath(scheme string, parts []string) string {
+	if scheme == "" {
+		return strings.Join(parts, "/")
+	}
+	return scheme + "/" + strings.Join(parts, "/")
+}
diff --git a/archive/yandex_test.go b/archive/yandex_test.go
new file mode 100644
index 0000000..adc1eb8
--- /dev/null
+++ b/archive/yandex_test.go
@@ -0,0 +1,721 @@
+package archive
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Фиктивные токен и корень: настоящий токен в тесты не попадает (правило 1 AGENTS.md), а значение
+// из теста работает ещё и маркером утечки — его не должно быть ни в текстах ошибок, ни в запросах
+// по подписанной ссылке.
+const (
+	fakeToken = "SECRET_TOKEN_VALUE"
+	fakeRoot  = "disk:/rosstat-archive"
+
+	// Адреса подписанных ссылок эмулятора: их выдаёт ручка ресурсов, по ним уходит тело объекта.
+	fakeUploadTarget   = "/upload-target/1"
+	fakeDownloadTarget = "/download-target/1"
+
+	// Ручки эмулятора — ключи очереди статусов и счётчика запросов.
+	fakeMkdir    = "mkdir"    // PUT /resources — создание каталога
+	fakeUpload   = "upload"   // GET /resources/upload — ссылка на загрузку
+	fakeBody     = "body"     // PUT /upload-target/1 — тело объекта
+	fakeDownload = "download" // GET /resources/download — ссылка на скачивание
+	fakeData     = "data"     // GET /download-target/1 — байты объекта
+	fakeExists   = "exists"   // GET /resources — наличие объекта
+)
+
+// fakeDir — что эмулятор отвечал про каталог: существует ли он и какие коды ушли на его создание
+// (201 — завели, 409 — уже был).
+type fakeDir struct {
+	exists bool
+	codes  []int
+}
+
+// fakeFail — подменённый ответ ручки: код и тело. Тело нужно там, где проверяется фрагмент ответа в
+// тексте ошибки: один и тот же 403 Диск отдаёт и при нехватке прав у токена, и при квоте, и
+// различить их можно только тем, что Диск написал в теле (statusError).
+type fakeFail struct {
+	code int
+	body string
+}
+
+// fakeDisk — эмулятор REST API Диска на httptest-сервере: держит каталоги и объекты в памяти и
+// ведёт журнал запросов клиента. Мок стоит на уровне http.Handler, а не на уровне методов клиента,
+// поэтому тесты видят настоящие запросы — путь в query, заголовок авторизации, метод, тело — и
+// ловят то, что иначе прошло бы незамеченным: токен на подписанной ссылке, потерянный overwrite,
+// запрос не тем методом.
+type fakeDisk struct {
+	server *httptest.Server
+
+	// Поля ниже пишутся и из хендлеров (горутина сервера), и из теста, поэтому доступ к ним —
+	// только под mu: пакет гоняется с -race.
+	mu      sync.Mutex
+	dirs    map[string]*fakeDir
+	objects map[string][]byte     // путь объекта → байты; «удаление» — delete
+	queue   map[string][]fakeFail // ручка → подменённые ответы (код и тело) раньше штатного
+	calls   map[string]int        // ручка → число запросов
+
+	apiAuth  []string // Authorization запросов к API Диска
+	hrefAuth []string // Authorization запросов по подписанной ссылке
+
+	uploadPaths   []string // path из resources/upload
+	downloadPaths []string // path из resources/download
+	existsPaths   []string // path из GET resources
+	overwrites    []string // overwrite из resources/upload
+
+	uploadPath   string // объект, на который выдана последняя ссылка загрузки
+	downloadPath string // объект, на который выдана последняя ссылка скачивания
+
+	// uploadHref подменяет адрес ссылки загрузки: тесту про утечку href нужна ссылка в никуда.
+	uploadHref string
+}
+
+// fakeState — снимок журналов под мьютексом: хендлеры живут в горутинах сервера, и читать поля
+// эмулятора из теста без блокировки нельзя.
+type fakeState struct {
+	dirCodes      map[string][]int
+	objects       map[string][]byte
+	calls         map[string]int
+	apiAuth       []string
+	hrefAuth      []string
+	uploadPaths   []string
+	downloadPaths []string
+	existsPaths   []string
+	overwrites    []string
+}
+
+// newFakeDisk поднимает эмулятор и закрывает его по окончании теста.
+func newFakeDisk(t *testing.T) *fakeDisk {
+	t.Helper()
+	f := &fakeDisk{
+		dirs:    map[string]*fakeDir{},
+		objects: map[string][]byte{},
+		queue:   map[string][]fakeFail{},
+		calls:   map[string]int{},
+	}
+	f.server = httptest.NewServer(http.HandlerFunc(f.handle))
+	t.Cleanup(f.server.Close)
+	return f
+}
+
+// newFakeStore — клиент, направленный на эмулятор. Клиент без Timeout, как util.HttpClient в
+// проде (правило 4 AGENTS.md): дедлайн операции живёт в самом бэкенде, и тест это проверяет.
+func newFakeStore(f *fakeDisk) *YandexDisk {
+	return NewYandex(fakeToken, fakeRoot, f.server.URL, &http.Client{})
+}
+
+// failNext ставит ручке статус-ответы раньше штатных: «первый ответ 429, второй нормальный» — ровно
+// тот сценарий, ради которого шаг повторяется. Тела у этих ответов нет: он нужен только там, где
+// проверяется фрагмент ответа в тексте ошибки (failNextWithBody).
+func (f *fakeDisk) failNext(endpoint string, codes ...int) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for _, code := range codes {
+		f.queue[endpoint] = append(f.queue[endpoint], fakeFail{code: code})
+	}
+}
+
+// failNextWithBody — тот же подменённый ответ, но с телом: им проверяется, что причина одного кода
+// (403 — нехватка прав против квоты) доезжает до текста ошибки, а не теряется за sentinel-ом.
+func (f *fakeDisk) failNextWithBody(endpoint string, code int, body string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.queue[endpoint] = append(f.queue[endpoint], fakeFail{code: code, body: body})
+}
+
+// overrideUploadHref заменяет адрес, который ручка загрузки отдаёт в href: так проверяется путь
+// «ссылка протухла или загрузчик недоступен».
+func (f *fakeDisk) overrideUploadHref(href string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.uploadHref = href
+}
+
+// remove «удаляет» объект из эмулятора: ветка Exists=false проверяется без второго сервера.
+func (f *fakeDisk) remove(path string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	delete(f.objects, path)
+}
+
+func (f *fakeDisk) state() fakeState {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	s := fakeState{
+		dirCodes: map[string][]int{},
+		objects:  map[string][]byte{},
+		calls:    map[string]int{},
+	}
+	for path, d := range f.dirs {
+		s.dirCodes[path] = append([]int(nil), d.codes...)
+	}
+	for path, body := range f.objects {
+		s.objects[path] = append([]byte(nil), body...)
+	}
+	for endpoint, n := range f.calls {
+		s.calls[endpoint] = n
+	}
+	s.apiAuth = append([]string(nil), f.apiAuth...)
+	s.hrefAuth = append([]string(nil), f.hrefAuth...)
+	s.uploadPaths = append([]string(nil), f.uploadPaths...)
+	s.downloadPaths = append([]string(nil), f.downloadPaths...)
+	s.existsPaths = append([]string(nil), f.existsPaths...)
+	s.overwrites = append([]string(nil), f.overwrites...)
+	return s
+}
+
+func (f *fakeDisk) handle(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	switch r.URL.Path {
+	case "/resources":
+		if r.Method == http.MethodPut {
+			f.handleMkdir(w, r)
+			return
+		}
+		f.handleExists(w, r)
+	case "/resources/upload":
+		f.handleHref(w, r, fakeUpload, f.server.URL+fakeUploadTarget, http.MethodPut)
+	case "/resources/download":
+		f.handleHref(w, r, fakeDownload, f.server.URL+fakeDownloadTarget, http.MethodGet)
+	case fakeUploadTarget:
+		f.handleBody(w, r)
+	case fakeDownloadTarget:
+		f.handleData(w, r)
+	default:
+		w.WriteHeader(http.StatusNotFound)
+	}
+}
+
+// handleMkdir отвечает на создание каталога: 201 в первый раз и 409 на повтор. 409 здесь — не
+// сбой, а «уже существует»; второй Put в тот же каталог обязан пройти.
+func (f *fakeDisk) handleMkdir(w http.ResponseWriter, r *http.Request) {
+	f.note(r, fakeMkdir)
+	path := r.URL.Query().Get("path")
+	d := f.dir(path)
+	if fail, ok := f.take(fakeMkdir); ok {
+		d.codes = append(d.codes, fail.code)
+		f.fail(w, fail)
+		return
+	}
+	code := http.StatusCreated
+	if d.exists {
+		code = http.StatusConflict
+	}
+	d.exists = true
+	d.codes = append(d.codes, code)
+	w.WriteHeader(code)
+}
+
+// handleHref выдаёт подписанную ссылку: на загрузку — только после проверки, что вызывающий
+// передал overwrite=true (иначе Диск откажется перезаписывать объект), на скачивание — только на
+// существующий объект (иначе 404, как у настоящего API).
+func (f *fakeDisk) handleHref(w http.ResponseWriter, r *http.Request, endpoint, target, method string) {
+	f.note(r, endpoint)
+	path := r.URL.Query().Get("path")
+	switch endpoint {
+	case fakeUpload:
+		f.uploadPaths = append(f.uploadPaths, path)
+		f.overwrites = append(f.overwrites, r.URL.Query().Get("overwrite"))
+		f.uploadPath = path
+	case fakeDownload:
+		f.downloadPaths = append(f.downloadPaths, path)
+		f.downloadPath = path
+	}
+	if fail, ok := f.take(endpoint); ok {
+		f.fail(w, fail)
+		return
+	}
+	if endpoint == fakeDownload {
+		if _, ok := f.objects[path]; !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+	}
+	if endpoint == fakeUpload && f.uploadHref != "" {
+		target = f.uploadHref
+	}
+	body, _ := json.Marshal(map[string]string{"href": target, "method": method})
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write(body)
+}
+
+// handleBody принимает тело на ссылку загрузки и кладёт его по пути, который назвала ручка ссылки:
+// у самой ссылки path нет — она и есть право на запись объекта.
+func (f *fakeDisk) handleBody(w http.ResponseWriter, r *http.Request) {
+	f.note(r, fakeBody)
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	if fail, ok := f.take(fakeBody); ok {
+		f.fail(w, fail)
+		return
+	}
+	f.objects[f.uploadPath] = body
+	w.WriteHeader(http.StatusCreated)
+}
+
+// handleData отдаёт байты объекта по ссылке скачивания.
+func (f *fakeDisk) handleData(w http.ResponseWriter, r *http.Request) {
+	f.note(r, fakeData)
+	if fail, ok := f.take(fakeData); ok {
+		f.fail(w, fail)
+		return
+	}
+	body, ok := f.objects[f.downloadPath]
+	if !ok {
+		w.WriteHeader(http.StatusNotFound)
+		return
+	}
+	_, _ = w.Write(body)
+}
+
+func (f *fakeDisk) handleExists(w http.ResponseWriter, r *http.Request) {
+	f.note(r, fakeExists)
+	path := r.URL.Query().Get("path")
+	f.existsPaths = append(f.existsPaths, path)
+	if fail, ok := f.take(fakeExists); ok {
+		f.fail(w, fail)
+		return
+	}
+	if _, ok := f.objects[path]; ok {
+		w.WriteHeader(http.StatusOK)
+		return
+	}
+	w.WriteHeader(http.StatusNotFound)
+}
+
+// note считает запросы к ручке и раскладывает Authorization по журналам: у запросов к API он
+// обязан быть, у запросов по подписанной ссылке — нет. Вызывается под f.mu.
+func (f *fakeDisk) note(r *http.Request, endpoint string) {
+	f.calls[endpoint]++
+	if strings.HasPrefix(r.URL.Path, "/resources") {
+		f.apiAuth = append(f.apiAuth, r.Header.Get("Authorization"))
+		return
+	}
+	f.hrefAuth = append(f.hrefAuth, r.Header.Get("Authorization"))
+}
+
+// take снимает с ручки очередной подменённый ответ. Вызывается под f.mu.
+func (f *fakeDisk) take(endpoint string) (fakeFail, bool) {
+	queue := f.queue[endpoint]
+	if len(queue) == 0 {
+		return fakeFail{}, false
+	}
+	f.queue[endpoint] = queue[1:]
+	return queue[0], true
+}
+
+// fail отвечает подменённым ответом: код, затем — если Диск его назвал — тело. Тело пишется после
+// WriteHeader: так статус не подменяется неявным 200 при записи тела.
+func (f *fakeDisk) fail(w http.ResponseWriter, fail fakeFail) {
+	w.WriteHeader(fail.code)
+	if fail.body != "" {
+		_, _ = io.WriteString(w, fail.body)
+	}
+}
+
+// dir возвращает запись каталога, заводя её при первом обращении. Вызывается под f.mu.
+func (f *fakeDisk) dir(path string) *fakeDir {
+	d, ok := f.dirs[path]
+	if !ok {
+		d = &fakeDir{}
+		f.dirs[path] = d
+	}
+	return d
+}
+
+// assertYandexAuth: к API Диска запросы идут с токеном, а по подписанной ссылке — без него. На href
+// токен не нужен (ссылка уже подписана), и лишний заголовок унёс бы секрет на хост загрузчика,
+// который токен не проверяет.
+func assertYandexAuth(t *testing.T, s fakeState) {
+	t.Helper()
+	for i, got := range s.apiAuth {
+		if want := "OAuth " + fakeToken; got != want {
+			t.Errorf("Authorization запроса к API #%d = %q, ожидалось %q", i, got, want)
+		}
+	}
+	for i, got := range s.hrefAuth {
+		if got != "" {
+			t.Errorf("Authorization запроса по подписанной ссылке #%d = %q, ожидалось пусто", i, got)
+		}
+	}
+}
+
+// Round-trip Put → Get → Exists на живом HTTP: эмулятор отвечает теми же ручками и кодами, что
+// Диск, и пинит то, чем архив пользуется, — путь в query, создание каталогов, тело на подписанной
+// ссылке. Ошибка тут означала бы не «не тот URL», а нерабочую архивацию: версия не сохранилась бы
+// или не прочиталась.
+func TestYandexPutGetExists(t *testing.T) {
+	f := newFakeDisk(t)
+	store := newFakeStore(f)
+	ctx := context.Background()
+	key := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum)
+	body := []byte("байты выгрузки cbr_m2")
+	diskPath := fakeRoot + "/" + key
+	sourceDir := fakeRoot + "/cbr_m2"
+
+	if store.Name() != "yandex" {
+		t.Errorf("Name() = %q, ожидалось %q", store.Name(), "yandex")
+	}
+	if err := store.Put(ctx, key, body); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+
+	s := f.state()
+	// Каталоги: корень архива и папка источника — по одному 201 на каждый. Повтор (409) проверяет
+	// TestYandexFoldersIdempotent.
+	for dir, want := range map[string][]int{
+		fakeRoot:  {http.StatusCreated},
+		sourceDir: {http.StatusCreated},
+	} {
+		if got := s.dirCodes[dir]; !reflect.DeepEqual(got, want) {
+			t.Errorf("коды создания каталога %s = %v, ожидались %v", dir, got, want)
+		}
+	}
+	if got, want := s.uploadPaths, []string{diskPath}; !reflect.DeepEqual(got, want) {
+		t.Errorf("path запроса ссылки на загрузку = %q, ожидался %q", got, want)
+	}
+	if got, want := s.overwrites, []string{"true"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("overwrite запроса ссылки на загрузку = %q, ожидался %q", got, want)
+	}
+	if got := s.objects[diskPath]; !bytes.Equal(got, body) {
+		t.Errorf("объект на Диске = %q, ожидались исходные байты %q", got, body)
+	}
+	assertYandexAuth(t, s)
+
+	got, err := store.Get(ctx, key)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if !bytes.Equal(got, body) {
+		t.Errorf("Get() = %q, ожидались исходные байты %q", got, body)
+	}
+	if got, want := f.state().downloadPaths, []string{diskPath}; !reflect.DeepEqual(got, want) {
+		t.Errorf("path запроса ссылки на скачивание = %q, ожидался %q", got, want)
+	}
+
+	exists, err := store.Exists(ctx, key)
+	if err != nil {
+		t.Fatalf("Exists: %v", err)
+	}
+	if !exists {
+		t.Error("Exists после Put = false, ожидалось true")
+	}
+	if got, want := f.state().existsPaths, []string{diskPath}; !reflect.DeepEqual(got, want) {
+		t.Errorf("path запроса наличия = %q, ожидался %q", got, want)
+	}
+
+	f.remove(diskPath)
+	exists, err = store.Exists(ctx, key)
+	if err != nil {
+		t.Fatalf("Exists удалённого объекта: %v", err)
+	}
+	if exists {
+		t.Error("Exists удалённого объекта = true, ожидалось false")
+	}
+	// Get удалённого объекта — ошибка, а не пустые байты: пустая версия в архиве — молчаливая
+	// потеря, ради которой архив и заводился (спека §3.1).
+	if _, err = store.Get(ctx, key); err == nil {
+		t.Error("Get удалённого объекта вернул байты без ошибки")
+	}
+	assertYandexAuth(t, f.state())
+}
+
+// Второй Put в тот же каталог источника: эмулятор отвечает 409 («уже существует»), и это не сбой.
+// Без этого архив работал бы ровно один раз на источник: вторая версия файла не уехала бы на Диск,
+// а Exists на no-op-прогоне говорил бы «в архиве нет» — то есть полный импорт на каждом прогоне.
+func TestYandexFoldersIdempotent(t *testing.T) {
+	f := newFakeDisk(t)
+	store := newFakeStore(f)
+	ctx := context.Background()
+	first := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum)
+	second := Key("cbr_m2", "monetary_agg_SA_other.xlsx", fp, zeroSum)
+
+	for _, key := range []string{first, second} {
+		if err := store.Put(ctx, key, []byte("байты "+key)); err != nil {
+			t.Fatalf("Put %s: %v", key, err)
+		}
+	}
+
+	s := f.state()
+	if got, want := s.dirCodes[fakeRoot+"/cbr_m2"], []int{http.StatusCreated, http.StatusConflict}; !reflect.DeepEqual(got, want) {
+		t.Errorf("коды создания папки источника = %v, ожидались %v", got, want)
+	}
+	for _, key := range []string{first, second} {
+		if _, ok := s.objects[fakeRoot+"/"+key]; !ok {
+			t.Errorf("объект %s не загружен на Диск", key)
+		}
+	}
+}
+
+// 429 от ручки ссылки — «сбавь темп», а не отказ: шаг повторяется, и Put доходит. Пауза повтора
+// подменяется миллисекундой — тест проверяет повтор, а не терпение.
+func TestYandexRetriesOn429(t *testing.T) {
+	f := newFakeDisk(t)
+	f.failNext(fakeUpload, http.StatusTooManyRequests)
+	old := retrySleeps
+	retrySleeps = []time.Duration{time.Millisecond}
+	t.Cleanup(func() { retrySleeps = old })
+
+	store := newFakeStore(f)
+	key := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum)
+	if err := store.Put(context.Background(), key, []byte("байты")); err != nil {
+		t.Fatalf("Put с повтором на 429: %v", err)
+	}
+
+	s := f.state()
+	if got, want := s.calls[fakeUpload], 2; got != want {
+		t.Errorf("запросов к resources/upload = %d, ожидалось %d (первый 429, второй успешный)", got, want)
+	}
+	if _, ok := s.objects[fakeRoot+"/"+key]; !ok {
+		t.Error("после повтора объект не загружен на Диск")
+	}
+}
+
+// 401 — токен не принят: ошибка обёртывает ErrAuth (дежурный обновляет токен), и в её тексте нет
+// значения токена: лог читают люди, а секрет в логе — утечка (правило 1 AGENTS.md).
+func TestYandexAuthError(t *testing.T) {
+	f := newFakeDisk(t)
+	f.failNext(fakeUpload, http.StatusUnauthorized)
+
+	store := newFakeStore(f)
+	err := store.Put(context.Background(), Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum), []byte("байты"))
+	if !errors.Is(err, ErrAuth) {
+		t.Errorf("Put при 401: %v, ожидалась обёртка ErrAuth", err)
+	}
+	if err != nil && strings.Contains(err.Error(), fakeToken) {
+		t.Errorf("в тексте ошибки %q есть значение токена", err)
+	}
+}
+
+// Квота Диска — второй различимый случай (спека §3.2): все четыре кода сводятся к ErrQuota, потому
+// что дежурному важно отличить «место» от «токена», а не разобрать код. 413 и 423 приходят от
+// API-прокси Диска на слишком большой файл и на занятый ресурс.
+func TestYandexQuotaError(t *testing.T) {
+	for _, status := range []int{
+		http.StatusForbidden,
+		http.StatusRequestEntityTooLarge,
+		http.StatusLocked,
+		http.StatusInsufficientStorage,
+	} {
+		t.Run(strconv.Itoa(status), func(t *testing.T) {
+			f := newFakeDisk(t)
+			f.failNext(fakeUpload, status)
+
+			store := newFakeStore(f)
+			err := store.Put(context.Background(), Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum), []byte("байты"))
+			if !errors.Is(err, ErrQuota) {
+				t.Errorf("Put при %d: %v, ожидалась обёртка ErrQuota", status, err)
+			}
+		})
+	}
+}
+
+// Тело ответа Диска доезжает до текста ошибки: один и тот же 403 Диск отдаёт и при нехватке прав у
+// токена (выдан без scope на disk:/), и при исчерпанной квоте, а ErrQuota у них один — по коду
+// дежурный не выберет, освобождать место или перевыпускать токен, и различает причины именно
+// фрагмент тела (statusError). Проверяются оба утверждения сразу: маппинг кодов не изменился
+// (errors.Is на ErrQuota), и Диск в логе говорит, что именно пошло не так.
+func TestYandexForbiddenKeepsBodySnippet(t *testing.T) {
+	const diskSays = "ForbiddenError: недостаточно прав на запись в disk:/rosstat-archive"
+	f := newFakeDisk(t)
+	f.failNextWithBody(fakeUpload, http.StatusForbidden, diskSays)
+
+	store := newFakeStore(f)
+	err := store.Put(context.Background(), Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum), []byte("байты"))
+	if !errors.Is(err, ErrQuota) {
+		t.Errorf("Put при 403: %v, ожидалась обёртка ErrQuota", err)
+	}
+	if err == nil || !strings.Contains(err.Error(), diskSays) {
+		t.Errorf("текст ошибки %v не называет ответ Диска %q — причину 403 (права против квоты) в логе не различить", err, diskSays)
+	}
+	// Фрагмент — из ответа API по запросу с токеном: сам токен в тело ответа не попадает, и в текст
+	// ошибки он тоже попасть не должен (правило 1 AGENTS.md).
+	if err != nil && strings.Contains(err.Error(), fakeToken) {
+		t.Errorf("в тексте ошибки %q есть значение токена", err)
+	}
+}
+
+// Тело ответа в тексте ошибки — одна строка не длиннее лимита: ответ ручки бывает HTML-страницей
+// прокси, и её переводы строк разорвали бы запись лога, а весь ответ вытеснил бы сам диагноз. Тело
+// обрезается по байту, поэтому на срезе руна может распасться — она вычищается, а не уезжает в лог.
+func TestErrSnippet(t *testing.T) {
+	for _, c := range []struct{ name, body, want string }{
+		{"пустое тело", "", ""},
+		{"пробелы и переводы строк сжимаются", "{\n  \"message\":\t\"нет места\"\n}\n", `{ "message": "нет места" }`},
+		{
+			"длинное тело режется по лимиту без разрезанной руны",
+			strings.Repeat("я", errSnippetLimit) + "хвост",
+			strings.Repeat("я", errSnippetLimit/2) + "…",
+		},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			got := errSnippet([]byte(c.body))
+			if got != c.want {
+				t.Errorf("errSnippet(%q) = %q, ожидалось %q", c.body, got, c.want)
+			}
+			// Инварианты, которые и защищают лог: одна строка и предел длины.
+			if strings.ContainsAny(got, "\n\r\t") {
+				t.Errorf("фрагмент %q не сжат в одну строку", got)
+			}
+			if len(got) > errSnippetLimit+len("…") {
+				t.Errorf("фрагмент %q длиннее лимита %d байт", got, errSnippetLimit)
+			}
+		})
+	}
+}
+
+// Прочий код ответа — обычная ошибка с номером статуса и путём на Диске. Путь, а не URL запроса:
+// чинится корень архива (ARCHIVE_YANDEX_DIR), и подписанной ссылки в тексте быть не должно.
+func TestYandexUnexpectedStatus(t *testing.T) {
+	f := newFakeDisk(t)
+	f.failNext(fakeExists, http.StatusInternalServerError)
+
+	store := newFakeStore(f)
+	key := Key("cbr_m2", "monetary_agg_SA.xlsx", fp, zeroSum)
+	_, err := store.Exists(context.Background(), key)
+	if err == nil {
+		t.Fatal("Exists при 500 вернул ответ без ошибки")
+	}
+	for _, want := range []string{"статус 500", fakeRoot + "/" + key} {
+		if !strings.Contains(err.Error(), want) {
+			t.Errorf("ошибка %q не называет %q", err, want)
+		}
+	}
+	if strings.Contains(err.Error(), "/resources") {
+		t.Errorf("в текст ошибки попал URL запроса API: %q", err)
+	}
+}
+
+// Подписанная ссылка — временный секрет: её утечка в лог равна утечке доступа к файлу. Сетевой сбой
+// и разбор URL http.Client оборачивает в *url.Error, чей текст содержит адрес запроса, поэтому
+// ошибка транспорта разворачивается до причины; проверяется, что в тексте нет ни ссылки, ни её
+// подписи, ни токена.
+func TestYandexHrefNotInError(t *testing.T) {
+	const signature = "SIGNED_QUERY_SECRET"
+	// Ссылка ведёт на уже закрытый сервер: адрес есть, отвечать по нему некому — ровно то, что
+	// видит клиент, когда подписанная ссылка протухла или загрузчик недоступен.
+	dead := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	deadURL := dead.URL
+	dead.Close()
+
+	for _, c := range []struct{ name, href string }{
+		{"загрузчик недоступен", deadURL + fakeUploadTarget + "?signature=" + signature},
+		{"ссылка не парсится", "://bad" + fakeUploadTarget + "?signature=" + signature},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			f := newFakeDisk(t)
+			f.overrideUploadHref(c.href)
+
+			store := newFakeStore(f)
+			err := store.Put(context.Background(), Key("cbr_m2", "x.xlsx", fp, zeroSum), []byte("байты"))
+			if err == nil {
+				t.Fatal("Put по нерабочей подписанной ссылке вернул успех")
+			}
+			if !strings.Contains(err.Error(), opUpload) {
+				t.Errorf("ошибка %q не называет шаг %q", err, opUpload)
+			}
+			for _, leak := range []string{c.href, fakeUploadTarget, signature, fakeToken} {
+				if strings.Contains(err.Error(), leak) {
+					t.Errorf("в тексте ошибки %q есть %q", err, leak)
+				}
+			}
+		})
+	}
+}
+
+// Дедлайн операции: util.HttpClient создан без Timeout, поэтому без своего дедлайна зависший Диск
+// держал бы прогон вечно — а архив объявлен опцией, которая не останавливает данные (спека §3.1).
+// opTimeout подменяется коротким: проверяется применение дедлайна, а не две минуты терпения.
+func TestYandexOperationDeadline(t *testing.T) {
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+		select {
+		case <-release:
+		case <-time.After(5 * time.Second): // предохранитель: без дедлайна тест не должен висеть
+		}
+	}))
+	defer server.Close()
+	// close раньше Close (defer'ы LIFO): сервер ждёт завершения хендлера, и освобождать его надо первым.
+	defer close(release)
+
+	old := opTimeout
+	opTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { opTimeout = old })
+
+	store := NewYandex(fakeToken, fakeRoot, server.URL, &http.Client{})
+	started := time.Now()
+	err := store.Put(context.Background(), Key("cbr_m2", "x.xlsx", fp, zeroSum), []byte("байты"))
+	if err == nil {
+		t.Fatal("Put к зависшему Диску вернул успех")
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Errorf("Put вернулся через %v, ожидалось около %v: дедлайн операции не применён", elapsed, opTimeout)
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Errorf("Put по дедлайну: %v, ожидалась причина context.DeadlineExceeded", err)
+	}
+}
+
+// Пустой baseURL — прод-адрес API, а не пустая строка: иначе первый же запрос ушёл бы в никуда.
+// Проверяется на поле, а не запросом: сети в тестах нет.
+func TestYandexDefaultBaseURL(t *testing.T) {
+	store := NewYandex(fakeToken, fakeRoot, "", &http.Client{})
+	if store.baseURL != defaultYandexAPI {
+		t.Errorf("baseURL = %q, ожидался %q", store.baseURL, defaultYandexAPI)
+	}
+}
+
+// Путь на Диске состоит из корня архива и ключа, а каталоги перебираются от корня до папки
+// источника: ручка ресурсов заводит одну папку за вызов. Вложенный корень (dev и приёмка задают
+// ARCHIVE_YANDEX_DIR по-разному) потому и разбирается по уровням — пропущенный уровень вернул бы
+// «родитель не найден», и объект не уехал бы на Диск.
+func TestYandexDirsToCreate(t *testing.T) {
+	for _, c := range []struct {
+		name, diskPath string
+		want           []string
+	}{
+		{
+			"корень и папка источника",
+			fakeRoot + "/cbr_m2/8f3c_x.xlsx",
+			[]string{"disk:/rosstat-archive", "disk:/rosstat-archive/cbr_m2"},
+		},
+		{
+			"вложенный корень",
+			"disk:/backup/archive/cbr_m2/8f3c_x.xlsx",
+			[]string{"disk:/backup", "disk:/backup/archive", "disk:/backup/archive/cbr_m2"},
+		},
+		{
+			"объект в корне",
+			fakeRoot + "/x.xlsx",
+			[]string{"disk:/rosstat-archive"},
+		},
+		{
+			"путь без схемы",
+			"rosstat-archive/cbr_m2/x.xlsx",
+			[]string{"rosstat-archive", "rosstat-archive/cbr_m2"},
+		},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			if got := dirsToCreate(c.diskPath); !reflect.DeepEqual(got, c.want) {
+				t.Errorf("dirsToCreate(%q) = %q, ожидалось %q", c.diskPath, got, c.want)
+			}
+		})
+	}
+}
