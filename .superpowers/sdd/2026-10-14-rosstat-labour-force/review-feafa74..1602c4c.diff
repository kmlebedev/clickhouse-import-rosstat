+// точки → производные (AfterImport) → строка версии.
+func (s *LabourForceStat) Import(ctx context.Context, conn driver.Conn) (count int64, err error) {
+	url, err := labourForceDataUrl()
+	if err != nil {
+		return count, err
+	}
+	s.DataUrl = url
+	return s.ClickHouseImport.Import(ctx, conn)
+}
