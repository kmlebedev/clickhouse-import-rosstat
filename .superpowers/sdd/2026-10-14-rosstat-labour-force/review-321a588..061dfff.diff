+		if sheet == labourForceSheet {
+			sheetFound = true
+			break
+		}
+	}
+	if !sheetFound {
+		return nil, fmt.Errorf("%s: в книге нет листа %q", rosstatLabourForceTable, labourForceSheet)
+	}
