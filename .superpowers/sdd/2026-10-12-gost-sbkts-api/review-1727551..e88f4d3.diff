+func TestGostSinceDaysCapsStaleAnchor(t *testing.T) {
+	t.Run("свежий якорь — обычное окно", func(t *testing.T) {
+		fresh := gostTime(t, "2026-10-09")
+		conn := &gostFakeConn{maxDate: &fresh}
