+// gostDayStrings — дни для сообщений об ошибках: список в формате прогона.
+func gostDayStrings(days []time.Time) []string {
+	out := make([]string, 0, len(days))
+	for _, day := range days {
+		out = append(out, day.Format(gostDateLayout))
+	}
+	return out
+}
