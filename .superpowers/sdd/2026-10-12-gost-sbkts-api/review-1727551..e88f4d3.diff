+// gostFakeBatch — батч в память: тест проверяет число и состав записанных строк.
+type gostFakeBatch struct {
+	driver.Batch
+	query string
+	rows  [][]any
+	sent  bool
+	abort bool
+}
+
+func (b *gostFakeBatch) Append(v ...any) error {
+	b.rows = append(b.rows, append([]any(nil), v...))
+	return nil
+}
+
+func (b *gostFakeBatch) Send() error { b.sent = true; return nil }
+
+func (b *gostFakeBatch) Abort() error { b.abort = true; return nil }
+
+func (b *gostFakeBatch) Rows() int { return len(b.rows) }
+
+// inserted разбирает записанные строки по колонкам DDL: порядок аргументов Append — контракт
+// (он же порядок колонок), и перепутанные поля обязаны валить тест, а не уезжать в базу.
+func (b *gostFakeBatch) inserted(t *testing.T) []gostRow {
+	t.Helper()
+	rows := make([]gostRow, 0, len(b.rows))
+	for i, v := range b.rows {
+		if len(v) != 10 {
+			t.Fatalf("строка батча %d: значений %d, want 10 (mark, type, date, certificate_number, ecoclass, enginetrademark, yearofmanufacturing, nameofmanufacturer, uid, publication_date)", i, len(v))
+		}
+		mark, ok := v[0].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: mark = %T (want string)", i, v[0])
+		}
+		typ, ok := v[1].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: type = %T (want string)", i, v[1])
+		}
+		date, ok := v[2].(time.Time)
+		if !ok {
+			t.Fatalf("строка батча %d: date = %T (want time.Time)", i, v[2])
+		}
+		number, ok := v[3].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: certificate_number = %T (want string)", i, v[3])
+		}
+		ecoclass, ok := v[4].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: ecoclass = %T (want string)", i, v[4])
+		}
+		engine, ok := v[5].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: enginetrademark = %T (want string)", i, v[5])
+		}
+		year, ok := v[6].(uint16)
+		if !ok {
+			t.Fatalf("строка батча %d: yearofmanufacturing = %T (want uint16)", i, v[6])
+		}
+		manufacturer, ok := v[7].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: nameofmanufacturer = %T (want string)", i, v[7])
+		}
+		uid, ok := v[8].(string)
+		if !ok {
+			t.Fatalf("строка батча %d: uid = %T (want string)", i, v[8])
+		}
+		pub, ok := v[9].(time.Time)
+		if !ok {
+			t.Fatalf("строка батча %d: publication_date = %T (want time.Time)", i, v[9])
+		}
+		rows = append(rows, gostRow{
+			Mark: mark, Type: typ, Date: date, CertificateNumber: number, EcoClass: ecoclass,
+			EngineTrademark: engine, YearOfManufacturing: year, NameOfManufacturer: manufacturer, UID: uid,
+			PublicationDate: pub,
+		})
+	}
+	return rows
+}
+
+// gostFakeRows — строки ответа фейкового соединения: очередь «установщиков» приёмников.
+// Пустой список — пустой ответ (таблицы нет или в окне нет строк).
+type gostFakeRows struct {
+	driver.Rows
+	setters []func(dest ...any) error
+	idx     int
+	err     error // её отдаёт Err() — обрыв обхода после Next
+}
+
+func (r *gostFakeRows) Next() bool {
+	if r.idx >= len(r.setters) {
+		return false
+	}
+	r.idx++
+	return true
+}
+
+func (r *gostFakeRows) Scan(dest ...any) error {
+	if r.err != nil {
+		return r.err
+	}
+	return r.setters[r.idx-1](dest...)
+}
+
+func (r *gostFakeRows) Err() error { return r.err }
+
+func (r *gostFakeRows) Close() error { return nil }
+
+// gostFakeRow — одна строка (QueryRow): Scan — тот же установщик приёмников, а заданная ошибка
+// возвращается из Scan (как у живого драйвера: QueryRow об ошибке сообщает именно её).
+type gostFakeRow struct {
+	driver.Row
+	scan func(dest ...any) error
+	err  error
+}
+
+func (r *gostFakeRow) Scan(dest ...any) error {
+	if r.err != nil {
+		return r.err
+	}
+	return r.scan(dest...)
+}
+
+func (r *gostFakeRow) Err() error { return r.err }
+
+// gostFakeConn — фейковое соединение импортёра: встраивание driver.Conn оставляет
+// неиспользуемые методы nil (паника, если тест зайдёт дальше сценария), а переопределены ровно
+// четыре метода прогона: Exec (DDL), QueryRow (якорь since и легаси-строки), Query (счётчики и
+// номера check) и PrepareBatch (запись дня). Ответы выбираются по виду запроса, а не по номеру
+// вызова.
+type gostFakeConn struct {
+	driver.Conn
+	mu       sync.Mutex
+	calls    []string
+	maxDate  *time.Time // NULL — пустая таблица: строк с настоящей датой выдачи нет
+	maxPub   *time.Time // NULL — настоящих publication_date нет (только дефолт 1970-01-01)
+	legacy   uint64
+	counters map[string]uint64   // счётчики uniqExact(certificate_number) по дню publication_date
+	dayNums  map[string][]string // номера таблицы по дню publication_date (запрос номеров дня)
+	numbers  map[string]bool     // номера, встречающиеся в таблице вообще (запрос перепубликаций)
+	queryErr error               // Query/QueryRow вернут её вместо строк
+	rowsErr  error               // её отдаст rows.Err()
+	batches  []*gostFakeBatch
+}
+
+func (c *gostFakeConn) record(call string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.calls = append(c.calls, call)
+}
+
+func (c *gostFakeConn) callList() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]string(nil), c.calls...)
+}
+
+func (c *gostFakeConn) batchList() []*gostFakeBatch {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]*gostFakeBatch(nil), c.batches...)
+}
+
+func (c *gostFakeConn) Exec(_ context.Context, query string, _ ...any) error {
+	c.record("exec: " + query)
+	return nil
+}
+
+func (c *gostFakeConn) PrepareBatch(_ context.Context, query string, _ ...driver.PrepareBatchOption) (driver.Batch, error) {
+	c.record("preparebatch: " + query)
+	batch := &gostFakeBatch{query: query}
+	c.mu.Lock()
+	c.batches = append(c.batches, batch)
+	c.mu.Unlock()
+	return batch, nil
+}
+
+func (c *gostFakeConn) Query(_ context.Context, query string, args ...any) (driver.Rows, error) {
+	c.record("query: " + query)
+	if c.queryErr != nil {
+		return nil, c.queryErr
+	}
+	switch {
+	case strings.Contains(query, "uniqExact(certificate_number)"):
+		var from, to time.Time
+		if len(args) == 2 {
+			from, _ = args[0].(time.Time)
+			to, _ = args[1].(time.Time)
+		}
+		return &gostFakeRows{setters: gostCounterSetters(c.counters, from, to), err: c.rowsErr}, nil
+	case strings.Contains(query, "WHERE publication_date = ?"):
+		// Номера дня публикации: аргумент — сам день, набор — из dayNums.
+		if len(args) != 1 {
+			return nil, fmt.Errorf("фейковый запрос номеров дня: аргументов %d (want 1)", len(args))
+		}
+		day, ok := args[0].(time.Time)
+		if !ok {
+			return nil, fmt.Errorf("фейковый запрос номеров дня: аргумент %T (want time.Time)", args[0])
+		}
+		return &gostFakeRows{setters: gostNumberSetters(c.dayNums[day.Format(gostDateLayout)]), err: c.rowsErr}, nil
+	case strings.Contains(query, "certificate_number IN (?)"):
+		// Номера, встречающиеся в таблице вообще: список приходит одним аргументом-срезом.
+		if len(args) != 1 {
+			return nil, fmt.Errorf("фейковый запрос номеров таблицы: аргументов %d (want 1)", len(args))
+		}
+		numbers, ok := args[0].([]string)
+		if !ok {
+			return nil, fmt.Errorf("фейковый запрос номеров таблицы: аргумент %T (want []string)", args[0])
+		}
+		return &gostFakeRows{setters: gostKnownNumberSetters(c.numbers, numbers), err: c.rowsErr}, nil
+	}
+	return nil, fmt.Errorf("gostFakeConn: неожиданный запрос %q", query)
+}
+
+func (c *gostFakeConn) QueryRow(_ context.Context, query string, _ ...any) driver.Row {
+	c.record("queryrow: " + query)
+	switch {
+	case strings.Contains(query, "maxOrNull(date)"):
+		return &gostFakeRow{err: c.queryErr, scan: func(dest ...any) error {
+			if len(dest) != 2 {
+				return fmt.Errorf("фейковый якорь: приёмников %d (want 2)", len(dest))
+			}
+			issue, ok := dest[0].(**time.Time)
+			if !ok {
+				return fmt.Errorf("фейковый якорь: приёмник max(date) %T (want **time.Time)", dest[0])
+			}
+			pub, ok := dest[1].(**time.Time)
+			if !ok {
+				return fmt.Errorf("фейковый якорь: приёмник publication_date %T (want **time.Time)", dest[1])
+			}
+			*issue, *pub = c.maxDate, c.maxPub
+			return nil
+		}}
+	case strings.Contains(query, "1970-01-01"):
+		return &gostFakeRow{err: c.queryErr, scan: func(dest ...any) error {
+			if len(dest) != 1 {
+				return fmt.Errorf("фейковые легаси-строки: приёмников %d (want 1)", len(dest))
+			}
+			count, ok := dest[0].(*uint64)
+			if !ok {
+				return fmt.Errorf("фейковые легаси-строки: приёмник count() %T (want *uint64)", dest[0])
+			}
+			*count = c.legacy
+			return nil
+		}}
+	}
+	return &gostFakeRow{err: c.queryErr, scan: func(...any) error {
+		return fmt.Errorf("gostFakeConn: неожиданный QueryRow %q", query)
+	}}
+}
+
+// gostCounterSetters — строки ответа запроса счётчиков: только дни окна [from, to], у которых
+// в таблице есть строки (GROUP BY по дню не отдаёт пустых дней).
+func gostCounterSetters(counters map[string]uint64, from, to time.Time) []func(dest ...any) error {
+	setters := make([]func(dest ...any) error, 0, len(counters))
+	for day := from; !day.After(to); day = day.AddDate(0, 0, 1) {
+		count, ok := counters[day.Format(gostDateLayout)]
+		if !ok {
+			continue
+		}
+		// Переменные цикла в Go ≥1.22 у каждой итерации свои: замыкание захватывает их
+		// безопасно, копия не нужна.
+		setters = append(setters, func(dest ...any) error {
+			if len(dest) != 2 {
+				return fmt.Errorf("фейковые счётчики: приёмников %d (want 2)", len(dest))
+			}
+			d, ok := dest[0].(*time.Time)
+			if !ok {
+				return fmt.Errorf("фейковые счётчики: приёмник publication_date %T (want *time.Time)", dest[0])
+			}
+			n, ok := dest[1].(*uint64)
+			if !ok {
+				return fmt.Errorf("фейковые счётчики: приёмник uniqExact %T (want *uint64)", dest[1])
+			}
+			*d, *n = day, count
+			return nil
+		})
+	}
+	return setters
+}
+
+// gostNumberSetters — строки ответа запроса номеров дня публикации: по одному *string на номер.
+func gostNumberSetters(numbers []string) []func(dest ...any) error {
+	setters := make([]func(dest ...any) error, 0, len(numbers))
+	for _, number := range numbers {
+		// Переменные цикла в Go ≥1.22 у каждой итерации свои: замыкание захватывает их
+		// безопасно, копия не нужна.
+		setters = append(setters, func(dest ...any) error {
+			if len(dest) != 1 {
+				return fmt.Errorf("фейковые номера дня: приёмников %d (want 1)", len(dest))
+			}
+			n, ok := dest[0].(*string)
+			if !ok {
+				return fmt.Errorf("фейковые номера дня: приёмник certificate_number %T (want *string)", dest[0])
+			}
+			*n = number
+			return nil
+		})
+	}
+	return setters
+}
+
+// gostKnownNumberSetters — строки ответа запроса «какие номера есть в таблице вообще»: только те
+// из запрошенных, что лежат в множестве таблицы, в порядке запроса (порядок строк ответа в
+// ClickHouse не гарантирован, и тест не должен зависеть от него).
+func gostKnownNumberSetters(known map[string]bool, numbers []string) []func(dest ...any) error {
+	setters := make([]func(dest ...any) error, 0, len(numbers))
+	for _, number := range numbers {
+		if !known[number] {
+			continue
+		}
+		setters = append(setters, func(dest ...any) error {
+			if len(dest) != 1 {
+				return fmt.Errorf("фейковые номера таблицы: приёмников %d (want 1)", len(dest))
+			}
+			n, ok := dest[0].(*string)
+			if !ok {
+				return fmt.Errorf("фейковые номера таблицы: приёмник certificate_number %T (want *string)", dest[0])
+			}
+			*n = number
+			return nil
+		})
+	}
+	return setters
+}
+
+// gostDaySpec — форма ответа ручки на день: Count — сколько совпадений ручка называет (count
+// ответа), Noise — сколько документов из них пришли с чужой, но разбираемой датой публикации
+// (в count они входят, клиентский фильтр дня их отбрасывает), Invalid — сколько документов
+// не разбираются вовсе (нет даты выдачи), Status — статус вместо ответа.
+type gostDaySpec struct {
+	Count   int
+	Noise   int
+	Invalid int
+	Status  int
+}
+
+// gostDayServer отдаёт заданные формы дней; неизвестный день — 404, чтобы «прочитал лишний
+// день» падало ошибкой прогона, а не тихим успехом.
+func gostDayServer(t *testing.T, days map[string]gostDaySpec) http.HandlerFunc {
+	t.Helper()
+	return func(w http.ResponseWriter, r *http.Request) {
+		day := r.URL.Query().Get("query")
+		spec, ok := days[day]
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		gostDayResponse(t, w, r, day, spec)
+	}
+}
+
+// gostEveryDayServer отдаёт одну форму на любой день: нужна тестам, где день запроса
+// вычисляет импортёр (окно since по пустой таблице).
+func gostEveryDayServer(t *testing.T, spec gostDaySpec) http.HandlerFunc {
+	t.Helper()
+	return func(w http.ResponseWriter, r *http.Request) {
+		gostDayResponse(t, w, r, r.URL.Query().Get("query"), spec)
+	}
+}
+
+// gostDayResponse собирает ответ ручки: документы дня среза плюс, если он задан, текстовый шум.
+// count ответа — полное число совпадений (Count), а не размер страницы: так ведёт себя ручка.
+func gostDayResponse(t *testing.T, w http.ResponseWriter, r *http.Request, day string, spec gostDaySpec) {
+	t.Helper()
+	if spec.Status != 0 {
+		w.WriteHeader(spec.Status)
+		return
+	}
+	size, err := strconv.Atoi(r.URL.Query().Get("size"))
+	if err != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	n := spec.Count
+	if n > size {
+		n = size
+	}
+	docs := make([]gostDoc, 0, n)
+	for i := 0; i < n; i++ {
+		switch {
+		case i < spec.Invalid:
+			docs = append(docs, gostInvalidDoc(day, i+1))
+		case i < spec.Invalid+spec.Noise:
+			docs = append(docs, gostForeignDoc(day, i+1))
+		default:
+			docs = append(docs, gostDayDoc(day, i+1))
+		}
+	}
+	// Тело собирается без t: хендлер живёт в горутине сервера, и t.Fatalf оттуда недопустим.
+	body, err := json.Marshal(gostSearchResponse{Count: spec.Count, Data: docs})
+	if err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+	_, _ = w.Write(body)
+}
+
+// gostDayDoc — документ, попадающий в срез дня: дата публикации равна дню запроса.
+func gostDayDoc(day string, id int) gostDoc {
+	issue := gostIssueMS
+	return gostDoc{ID: int64(id), Fields: gostFields{
+		Product:                  "Toyota",
+		Type:                     "ZGE25",
+		NumberOfCertificate:      fmt.Sprintf("ТС RU А-JP.ОМ80.%05d", id),
+		DateOfIssueOfCertificate: &issue,
+		EcoClass:                 "4",
+		EngineTrademark:          "2ZR-FE",
+		YearOfManufacturing:      "2016",
+		NameOfManufacturer:       "TOYOTA",
+		UniqueIdentifier:         fmt.Sprintf("uid-%05d", id),
+		DateOfPublication:        day + " 00:00:00 ZE3",
+	}}
+}
+
+// gostForeignDoc — документ того же ответа, но чужого дня публикации: ручка ищет текстом и
+// отдаёт соседние окна, а в срез дня такой документ не входит.
+func gostForeignDoc(day string, id int) gostDoc {
+	doc := gostDayDoc(day, id)
+	doc.Fields.DateOfPublication = gostForeignPublication
+	return doc
+}
+
+// gostInvalidDoc — документ, который срез дня не разберёт вовсе: нет даты выдачи. Так выглядит
+// поломка формата или данных (а не штатное окно текстового поиска), и день из таких документов
+// обязан валить прогон.
+func gostInvalidDoc(day string, id int) gostDoc {
+	doc := gostDayDoc(day, id)
+	doc.Fields.DateOfIssueOfCertificate = nil
+	return doc
+}
diff --git a/craw/gost_views.go b/craw/gost_views.go
new file mode 100644
index 0000000..832daa4
--- /dev/null
+++ b/craw/gost_views.go
@@ -0,0 +1,80 @@
+package craw
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
+)
+
+// Витрины v_gost_* — читательский контур реестра СБКТС (правило 11 AGENTS.md): сырая
+// gost_vehicle_safety_certificate агенту не выдаётся, читать реестр он обязан через витрину.
+// Витрин две, потому что вопросы к реестру разные: «какие сертификаты выданы» (строки) и
+// «сколько машин въехало» (дневной поток) — второй считается uniqExact по номерам, а не
+// count() строк таблицы (изменения сертификата дают вторую строку при том же номере).
+//
+// Публикуются витрины импортёром в начале пишущего прогона (до первого обращения к API) — по образцу
+// news/, чтобы правка определения уезжала вместе с импортом, а не отдельным ручным шагом.
+
+// Имена витрин — контракт с sql/mcp_kimi_reader.sql (гранты), ARCHITECTURE.md §6.3
+// и scripts/mcp_check.py: промах в имени — это витрина, которой агент не видит.
+const (
+	// gostRowsView — строковая витрина реестра: один сертификат — одна строка (FINAL
+	// схлопывает вытесненные копии ReplacingMergeTree).
+	gostRowsView = "v_gost_vehicle_safety_certificate"
+	// gostDailyView — дневной поток выдачи: день выдачи × марка.
+	gostDailyView = "v_gost_vehicle_safety_daily"
+)
+
+// gostViewStatements — стейтменты витрин по порядку: два определения, затем комментарии
+// таблиц и колонок (ALTER TABLE … MODIFY COMMENT / COMMENT COLUMN — DDL-стиль проекта,
+// не COMMENT ON). Комментарии — часть контракта витрины: агент читает их как описание
+// данных, и именно в них живут оговорки (лаг публикации, строки до бэкфилла, amendments, год
+// выпуска 0, uniqExact, пустой день).
+//
+// В строковой витрине нет ORDER BY: 3.4 млн строк не сортируются на каждом запросе, вместо
+// этого комментарий велит фильтровать по `date`. Технический `uid` в витрину не выводится —
+// он провенанс импортёра, а не данные о сертификате. Дневная витрина, наоборот, сортирована
+// (строк ~дни × марки): `date DESC` — свежий день сверху, `mark` — стабильный порядок внутри дня.
+var gostViewStatements = []string{
+	`CREATE OR REPLACE VIEW ` + gostRowsView + ` DEFINER = default SQL SECURITY DEFINER AS
+	SELECT date, publication_date, mark, type, certificate_number, ecoclass, enginetrademark, yearofmanufacturing, nameofmanufacturer
+	FROM ` + gostTable + ` FINAL`,
+
+	`CREATE OR REPLACE VIEW ` + gostDailyView + ` DEFINER = default SQL SECURITY DEFINER AS
+	SELECT date, mark, uniqExact(certificate_number) AS certificates
+	FROM ` + gostTable + ` FINAL
+	GROUP BY date, mark
+	ORDER BY date DESC, mark`,
+
+	"ALTER TABLE " + gostRowsView + " MODIFY COMMENT 'Реестр СБКТС Росстандарта (свидетельства о безопасности конструкции ТС): источник — REST API портала gost.ru, импортёр gost_vehicle_safety_certificate, режимы since (ежечасно) / full (история с 2016). `date` — дата выдачи СБКТС (МСК); `publication_date` — дата батча публикации у источника; строка может обновляться (ReplacingMergeTree FINAL); изменения сертификата дают вторую строку при том же номере; в витрине нет технического `uid`; фильтруйте по `date` — витрина не сортирована'",
+
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN date '`date` — дата выдачи (МСК)'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN publication_date '`publication_date` — дата публикации среза у источника (лаг к выдаче ~2 суток); у строк до бэкфилла — 1970-01-01'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN mark '`mark` — марка ТС (`product`)'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN type '`type` — тип/модель ТС (`type`)'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN certificate_number '`certificate_number` — номер СБКТС («ТС RU …»)'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN ecoclass '`ecoclass` — экологический класс, `-` — не применимо'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN enginetrademark '`enginetrademark` — двигатель (модель, топливо: дизель/бензин/электро)'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN yearofmanufacturing '`yearofmanufacturing` — год выпуска, `0` — не указан или строка до бэкфилла'",
+	"ALTER TABLE " + gostRowsView + " COMMENT COLUMN nameofmanufacturer '`nameofmanufacturer` — производитель'",
+
+	"ALTER TABLE " + gostDailyView + " MODIFY COMMENT 'Дневной поток выдачи СБКТС: одна строка на (день выдачи × марка), `certificates` — число уникальных номеров (`uniqExact`), а не строк таблицы; счётчик импорта автомобилей по реестру Росстандарта; пустой день отсутствует (не 0)'",
+
+	"ALTER TABLE " + gostDailyView + " COMMENT COLUMN date '`date` — день выдачи (МСК)'",
+	"ALTER TABLE " + gostDailyView + " COMMENT COLUMN mark '`mark` — марка ТС'",
+	"ALTER TABLE " + gostDailyView + " COMMENT COLUMN certificates '`certificates` — выдано сертификатов за день (уникальные номера)'",
+}
+
+// gostPublishViews публикует витрины: стейтменты исполняются по порядку (определение →
+// комментарии), первый сбой останавливает публикацию. Ошибка фатальна для прогона: витрина,
+// определения которой нет, — это чтение агента по устаревшей или отсутствующей схеме, а
+// не «прогон прошёл без витрин». Вызывается только в пишущих режимах (since/full).
+func gostPublishViews(ctx context.Context, conn driver.Conn) error {
+	for _, stmt := range gostViewStatements {
+		if err := conn.Exec(ctx, stmt); err != nil {
+			return fmt.Errorf("%s: публикация витрин: %w", gostTable, err)
+		}
+	}
+	return nil
+}
diff --git a/craw/gost_views_test.go b/craw/gost_views_test.go
new file mode 100644
index 0000000..462eebf
--- /dev/null
+++ b/craw/gost_views_test.go
@@ -0,0 +1,236 @@
+package craw
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+// Тесты витрин v_gost_* офлайн: соединение — фейковое (gostFakeConn из gost_test.go),
+// источник — httptest (gostNewTestAPI/gostEveryDayServer). Пинятся три контракта:
+// состав и форма стейтментов (число, определения витрин, комментарии), смысл комментариев
+// (оговорки, без которых витрина читается неверно) и порядок публикации в Import —
+// витрины публикуются в пишущем прогоне и до первого обращения к API.
+//
+// Число стейтментов — 16, а не 14 из плана: 2 × CREATE OR REPLACE VIEW + комментарий
+// таблицы и 9 комментариев колонок строковой витрины + комментарий таблицы и 3 комментария
+// колонок дневной. 3.4 млн строк витрины обязаны быть описаны для агента, и «14» в плане
+// было арифметической ошибкой (решение контроллера, зафиксировано здесь).
+
+// gostRowViewColumns — колонки строковой витрины по порядку определения: технический `uid`
+// в витрину не выводится (провенанс остаётся в сырой таблице).
+var gostRowViewColumns = []string{
+	"date", "publication_date", "mark", "type", "certificate_number",
+	"ecoclass", "enginetrademark", "yearofmanufacturing", "nameofmanufacturer",
+}
+
+// gostDailyViewColumns — колонки дневной витрины: день × марка и счётчик сертификатов.
+var gostDailyViewColumns = []string{"date", "mark", "certificates"}
+
+// gostCommentCount считает стейтменты-комментарии витрины: MODIFY COMMENT — комментарий
+// таблицы, COMMENT COLUMN — комментарии колонок (DDL-стиль проекта: не COMMENT ON).
+func gostCommentCount(t *testing.T, stmts []string, prefix string) int {
+	t.Helper()
+	count := 0
+	for _, stmt := range stmts {
+		if strings.HasPrefix(stmt, prefix) {
+			count++
+		}
+	}
+	return count
+}
+
+// gostColumnComment ищет единственный комментарий колонки витрины. Префикс заканчивается
+// на `"' "` — иначе `date` совпал бы с колонкой, начинающейся на `date` (в news это
+// date/date_msk, здесь — страховка на будущее).
+func gostColumnComment(t *testing.T, stmts []string, view, column string) string {
+	t.Helper()
+	prefix := "ALTER TABLE " + view + " COMMENT COLUMN " + column + " '"
+	var found []string
+	for _, stmt := range stmts {
+		if strings.HasPrefix(stmt, prefix) {
+			found = append(found, stmt)
+		}
+	}
+	if len(found) != 1 {
+		t.Fatalf("комментариев колонки %s.%s: %d, ожидался один", view, column, len(found))
+	}
+	return found[0]
+}
+
+func TestGostViewStatementsShape(t *testing.T) {
+	stmts := gostViewStatements
+	if len(stmts) != 16 {
+		t.Fatalf("стейтментов %d, ожидалось 16 (2 витрины + комментарий таблицы и 9 колонок строковой + комментарий таблицы и 3 колонки дневной)", len(stmts))
+	}
+
+	rows := stmts[0]
+	for _, want := range []string{
+		"CREATE OR REPLACE VIEW " + gostRowsView,
+		"DEFINER = default SQL SECURITY DEFINER",
+		"FROM " + gostTable + " FINAL",
+		"SELECT date, publication_date, mark, type, certificate_number, ecoclass, enginetrademark, yearofmanufacturing, nameofmanufacturer",
+	} {
+		if !strings.Contains(rows, want) {
+			t.Errorf("строковая витрина без %q: %q", want, rows)
+		}
+	}
+	if strings.Contains(rows, "uid") {
+		t.Errorf("строковая витрина выводит техническую колонку uid: %q", rows)
+	}
+	// 3.4 млн строк: сортировка на каждом запросе не нужна, фильтровать агент обязан по date,
+	// а об этом говорит комментарий витрины (TestGostViewsDocumentSemantics).
+	if strings.Contains(rows, "ORDER BY") {
+		t.Errorf("строковая витрина сортируется: %q", rows)
+	}
+
+	daily := stmts[1]
+	for _, want := range []string{
+		"CREATE OR REPLACE VIEW " + gostDailyView,
+		"DEFINER = default SQL SECURITY DEFINER",
+		"uniqExact(certificate_number)",
+		"GROUP BY date, mark",
+		"ORDER BY date DESC, mark",
+	} {
+		if !strings.Contains(daily, want) {
+			t.Errorf("дневная витрина без %q: %q", want, daily)
+		}
+	}
+	// certificates — число уникальных номеров, а не строк таблицы: изменения сертификата
+	// (amendments) дают вторую строку с тем же номером, и count() завысил бы день.
+	if strings.Contains(daily, "count()") {
+		t.Errorf("дневная витрина считает строки вместо уникальных номеров: %q", daily)
+	}
+
+	// Комментарии — только после определений витрин: агент читает витрину с описанием, а не
+	// комментарии к ещё не созданному объекту.
+	comments := stmts[2:]
+	if got := gostCommentCount(t, comments, "ALTER TABLE "+gostRowsView+" MODIFY COMMENT"); got != 1 {
+		t.Errorf("комментариев таблицы строковой витрины %d, ожидался один", got)
+	}
+	if got := gostCommentCount(t, comments, "ALTER TABLE "+gostDailyView+" MODIFY COMMENT"); got != 1 {
+		t.Errorf("комментариев таблицы дневной витрины %d, ожидался один", got)
+	}
+	if got := gostCommentCount(t, comments, "ALTER TABLE "+gostRowsView+" COMMENT COLUMN "); got != len(gostRowViewColumns) {
+		t.Errorf("комментариев колонок строковой витрины %d, ожидалось %d", got, len(gostRowViewColumns))
+	}
+	if got := gostCommentCount(t, comments, "ALTER TABLE "+gostDailyView+" COMMENT COLUMN "); got != len(gostDailyViewColumns) {
+		t.Errorf("комментариев колонок дневной витрины %d, ожидалось %d", got, len(gostDailyViewColumns))
+	}
+	// Каждая колонка обеих витрин обязана быть описана: колонка без комментария — это колонка,
+	// смысл которой агент угадывает.
+	for _, column := range gostRowViewColumns {
+		gostColumnComment(t, comments, gostRowsView, column)
+	}
+	for _, column := range gostDailyViewColumns {
+		gostColumnComment(t, comments, gostDailyView, column)
+	}
+}
+
+func TestGostViewsDocumentSemantics(t *testing.T) {
+	// Тексты комментариев — часть контракта витрин: агент читает их как описание данных.
+	// Проверяются оговорки, без которых витрина читается неверно (даты, лаг публикации,
+	// строки до бэкфилла, amendments, год выпуска 0, uniqExact, пустой день), а не дословные
+	// формулировки.
+	var text strings.Builder
+	for _, stmt := range gostViewStatements[2:] {
+		text.WriteString(stmt)
+		text.WriteString("\n")
+	}
+	comments := text.String()
+	// Регистр — потому что комментарий таблицы начинается с «Реестр СБКТС Росстандарта».
+	lowered := strings.ToLower(comments)
+
+	for _, want := range []string{
+		"реестр сбктс росстандарта",
+		"rest api",
+		"gost.ru",
+		"дата выдачи сбктс (мск)",
+		"дата публикации среза",
+		"лаг к выдаче ~2 суток",
+		"1970-01-01",
+		"изменения сертификата дают вторую строку",
+		"replacingmergetree final",
+		"фильтруйте по `date`",
+		"витрина не сортирована",
+		"год выпуска",
+		"`0` — не указан",
+		"до бэкфилла",
+		"uniqexact",
+		"уникальных номеров",
+		"пустой день отсутствует",
+	} {
+		if !strings.Contains(lowered, want) {
+			t.Errorf("в комментариях витрин нет %q:\n%s", want, comments)
+		}
+	}
+
+	// «Одна строка каждый»: перенос внутри комментария — это либо незакрытая кавычка,
+	// либо комментарий, у которого потерялась половина смысла.
+	for i, stmt := range gostViewStatements[2:] {
+		if strings.Contains(stmt, "\n") {
+			t.Errorf("комментарий %d не одной строкой: %q", i, stmt)
+		}
+	}
+
+	// Оговорка о строках до бэкфилла обязана жить именно в комментарии publication_date:
+	// дефолт колонки (1970-01-01) выглядит настоящей датой публикации, и агент должен знать,
+	// что это «не бэкфилено», а не публикация 1970 года (импортёр предупреждает о таких строках
+	// в логе прогона, но лог агент не читает).
+	pubComment := gostColumnComment(t, gostViewStatements[2:], gostRowsView, "publication_date")
+	if !strings.Contains(pubComment, "1970-01-01") || !strings.Contains(pubComment, "до бэкфилла") {
+		t.Errorf("комментарий publication_date без оговорки о строках до бэкфилла: %q", pubComment)
+	}
+}
+
+func TestGostImportWritesPublishViews(t *testing.T) {
+	gostPinClock(t, gostTestNow)
+	gostEnv(t, map[string]string{gostModeEnv: gostModeSince, gostAppIDEnv: gostTestAppID})
+	gostNewTestAPI(t, gostEveryDayServer(t, gostDaySpec{Count: 1}))
+	conn := &gostFakeConn{} // пустая таблица: свой прогон дней, но порядок шагов тот же
+
+	if _, err := (&gostImporter{}).Import(context.Background(), conn); err != nil {
+		t.Fatalf("since по пустой таблице: %v", err)
+	}
+
+	calls := conn.callList()
+	want := make(map[string]bool, len(gostViewStatements))
+	for _, stmt := range gostViewStatements {
+		want[stmt] = true
+	}
+
+	var viewIdx []int
+	for i, call := range calls {
+		stmt := strings.TrimPrefix(call, "exec: ")
+		if stmt != call && want[stmt] {
+			viewIdx = append(viewIdx, i)
+		}
+	}
+	if len(viewIdx) != len(gostViewStatements) {
+		t.Fatalf("Exec стейтментов витрин %d, ожидалось %d; вызовы: %v", len(viewIdx), len(gostViewStatements), calls)
+	}
+	// Порядок стейтментов — порядок среза: колонка обязана быть описана после создания витрины,
+	// а дневная витрина — после строковой (её определение читает таблицу, а не витрину, но
+	// отчёт о сбое без порядка не читается).
+	for n, i := range viewIdx {
+		if got := strings.TrimPrefix(calls[i], "exec: "); got != gostViewStatements[n] {
+			t.Errorf("стейтмент витрин %d = %q, ожидался %q", n, got, gostViewStatements[n])
+		}
+	}
+	// Публикация — до первого обращения к API: правка определения витрины обязана уехать вместе
+	// с прогоном, а не после него (и не после первой записи дня).
+	firstBatch := -1
+	for i, call := range calls {
+		if strings.HasPrefix(call, "preparebatch:") {
+			firstBatch = i
+			break
+		}
+	}
+	if firstBatch < 0 {
+		t.Fatalf("ни одного батча в прогоне: %v", calls)
+	}
+	if viewIdx[len(viewIdx)-1] > firstBatch {
+		t.Errorf("витрины публикуются после первого батча: последний стейтмент — вызов %d, батч — %d",
+			viewIdx[len(viewIdx)-1], firstBatch)
+	}
+}
