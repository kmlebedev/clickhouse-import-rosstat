+# значения токена в репозитории нет (правило 1). В env-файле держат только токен:
+# режимные переменные (GOST_MODE/GOST_FROM/GOST_TO/GOST_SETTLE_DAYS) задаёт сам DAG
+# (env шага), иначе значение из файла перекрыло бы префикс команды ручного запуска.
 steps:
   - id: gost_vehicle_safety_certificate
     run: "$ROSSTAT_IMPORT_BIN"
     env:
       - CLICKHOUSE_IMPORT_STAT=gost_vehicle_safety_certificate
+      - GOST_MODE=since
