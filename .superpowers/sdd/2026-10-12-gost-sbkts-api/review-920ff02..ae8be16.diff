 func (a *gostAPI) dayCount(ctx context.Context, day time.Time) (int, error) {
 	resp, err := a.fetchPage(ctx, day, 1, 1)
 	if err != nil {
 		return 0, err
 	}
 	return resp.Count, nil
 }
 
