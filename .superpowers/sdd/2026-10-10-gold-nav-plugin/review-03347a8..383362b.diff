+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if _, err := scenarioTargetDate(tt.scenario); err == nil {
+				t.Fatalf("expected error for %v", tt.scenario)
+			}
+		})
+	}
+}
