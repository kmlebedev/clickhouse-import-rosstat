diff --git a/cbr/mo_br.go b/cbr/mo_br.go
new file mode 100644
index 0000000..55cb897
--- /dev/null
+++ b/cbr/mo_br.go
@@ -0,0 +1,177 @@
+package cbr
+
+import (
+	"context"
+	"fmt"
+	"path"
+	"time"
+
+	"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
+	"github.com/kmlebedev/clickhouse-import-rosstat/util"
+	log "github.com/sirupsen/logrus"
+	"github.com/xuri/excelize/v2"
+)
+
+const (
+	// moBrPageUrl — страница макроэкономического опроса ЦБ; имя файла волны в коде
+	// не фиксируется: ссылка ищется в Import() (§3.1, ARCHITECTURE.md §8.6).
+	moBrPageUrl = "https://www.cbr.ru/statistics/ddkp/mo_br/"
+	// moBrLinkSel — селектор ссылки на полную книгу волны (full.xlsx).
+	moBrLinkSel = `a[href$="full.xlsx"]`
+	// moBrName — имя импортёра в CLICKHOUSE_IMPORT_STAT и в id шага dagu/cbr.yaml;
+	// moBrTable — общая macro_series (source='cbr_mo_br', см. moBrSource), поэтому
+	// имя не совпадает с таблицей (как у cbr_mp_survey).
+	moBrName  = "cbr_mo_br"
+	moBrTable = "macro_series"
+)
+
+// moBrCountPoints — количественный чек известной версии (спека §3.4, п. 2): число
+// точек своего source в macro_series. Литерал, как и таблицы в реестре: запрос —
+// часть утверждения «эти точки мои», и незамеченная смена source увела бы чек к
+// чужим рядам общей таблицы. FINAL — как в витрине v_cbr_mo_br.
+const moBrCountPoints = `SELECT count() FROM macro_series FINAL WHERE source = 'cbr_mo_br'`
+
+// moBrDdl — своя копия DDL macro_series по прецеденту пакета (у cbr_mp_survey —
+// mpSurveyDdl): общая константа связала бы импортёры, которые делят таблицу, но не
+// код. Комментарий source дополнен 'cbr_mo_br'. Исполняется через
+// fmt.Sprintf(sql, TableName) в util.ClickHouseImport.Import, поэтому %s обязателен.
+const moBrDdl = `CREATE TABLE IF NOT EXISTS %s (
+    source LowCardinality(String),   -- 'fred','bls','bea','eia','manual','webbridge','imf','wgc','bold','cbr_survey','cbr_mo_br'
+    series LowCardinality(String),   -- 'DFII10','distillate_stocks',...
+    date Date32,                     -- Date32, т.к. Date не покрывает даты до 1970 (CPIAUCSL с 1947, FEDFUNDS с 1954)
+    value Float64
+) ENGINE = ReplacingMergeTree ORDER BY (source, series, date);`
+
+type moBrStat struct {
+	util.ClickHouseImport
+}
+
+func (s *moBrStat) Name() string { return moBrName }
+
+// Import идёт по спеке §3.4: ссылка на полную книгу ищется на странице (имя файла
+// меняется с каждой волной), затем HEAD-префлайт отвечает, знакома ли версия. Знакома
+// и число точек в macro_series совпадает с записанным — это no-op ежедневного прогона
+// (волны выходят 8 раз в год). Незнакома или точек не столько — полный импорт; после
+// успешного Send сохраняется версия, каталог и витрина.
+func (s *moBrStat) Import(ctx context.Context, conn driver.Conn) (count int64, err error) {
+	page, err := getPage(moBrPageUrl)
+	if err != nil {
+		return count, fmt.Errorf("%s: %s: %w", moBrName, moBrPageUrl, err)
+	}
+	href, err := findLink(page, moBrLinkSel)
+	if err != nil {
+		return count, fmt.Errorf("%s: не найдена ссылка на xlsx на %s: %w", moBrName, moBrPageUrl, err)
+	}
+	url := cbrUrl + href
+	name := path.Base(url)
+
+	// HEAD-префлайт. Недоступный HEAD — деградация, а не сбой: источник мог не
+	// ответить на HEAD, не отдав при этом ничего нового. Тогда импорт полный, но
+	// версия не записывается (fp пуст) — иначе следующий прогон счёл бы файл уже
+	// импортированным и оставил бы данные устаревшими (спека §3.4, п. 3).
+	fp, fpErr := util.HeadFingerprint(url)
+	if fpErr != nil {
+		log.Warnf("%s: HEAD %s недоступен (%v) — полный импорт без записи версии", moBrName, url, fpErr)
+		fp = ""
+	}
+
+	if fp != "" {
+		if err = util.EnsurePublications(ctx, conn); err != nil {
+			return count, err
+		}
+		points, known, knownErr := util.PublicationKnown(ctx, conn, moBrName, name, fp)
+		if knownErr != nil {
+			// Сбой SELECT'а версии не должен ронять ежедневный прогон: падаем в
+			// полный импорт (он идемпотентен на ReplacingMergeTree), а версия потом
+			// перезаписывается. Новая волна важнее диагностики старой записи.
+			log.Warnf("%s: проверка версии %s в %s не удалась (%v) — полный импорт", moBrName, fp, util.PublicationsTable, knownErr)
+			known = false
+		}
+		if known {
+			var dbPoints uint64
+			if err = conn.QueryRow(ctx, moBrCountPoints).Scan(&dbPoints); err != nil {
+				return count, fmt.Errorf("%s: count точек в %s: %w", moBrName, moBrTable, err)
+			}
+			if dbPoints == points {
+				log.Infof("%s: no-op, версия %s уже импортирована, %d точек на месте", moBrName, fp, points)
+				return int64(points), nil
+			}
+			// Версия в source_publications есть, а точек в таблице не столько (ручная
+			// чистка, недоехавший батч) — self-heal полным импортом, а не тихий no-op.
+			log.Warnf("%s: версия %s известна, но в %s %d точек вместо %d — полный импорт", moBrName, fp, moBrTable, dbPoints, points)
+		}
+	}
+
+	// Полный путь — через локальную копию встроенной структуры: меты разбора
+	// нужны снаружи (каталог), а мутировать общую структуру импортёра нельзя —
+	// DataUrl и ImportFunc зависят от волны.
+	local := s.ClickHouseImport
+	local.DataUrl = url
+	var meta []util.SeriesMeta
+	local.ImportFunc = func(xlsx *excelize.File, batch driver.Batch) error {
+		points, metas, err := parseMoBr(xlsx)
+		if err != nil {
+			return err
+		}
+		meta = metas
+		log.Infof("%s: собрано %d точек", moBrName, len(points))
+		for _, p := range points {
+			if err = batch.Append(moBrSource, p.Series, p.Date, p.Value); err != nil {
+				return fmt.Errorf("append %s %s: %w", p.Series, p.Date.Format("2006-01-02"), err)
+			}
+		}
+		return nil
+	}
+	count, err = local.Import(ctx, conn) // DDL → GetXlsx → разбор+батч → count=batch.Rows() → Send
+	if err != nil {
+		return count, err
+	}
+	// Только после успешного Send: строка версии утверждает «эти точки записаны».
+	if fp != "" {
+		if err = util.SavePublication(ctx, conn, util.Publication{
+			Source:      moBrName,
+			Name:        name,
+			Fingerprint: fp,
+			Url:         url,
+			FirstSeen:   time.Now(),
+			Points:      uint64(count),
+		}); err != nil {
+			return count, err
+		}
+	}
+	if err = util.UpsertSeriesCatalog(ctx, conn, meta); err != nil {
+		return count, err
+	}
+	if _, err = util.CreateView(ctx, conn, vCbrMoBrView); err != nil {
+		return count, err
+	}
+	log.Infof("Imported %d rows of %s", count, moBrName)
+	return count, nil
+}
+
+// vCbrMoBrView — витрина рядов макроэкономического опроса ЦБ (source='cbr_mo_br',
+// импортёр cbr_mo_br); общая витрина cbrMacroView и v_cbr_survey её не покрывают.
+// Комментарии — по спеке §3.5: дата — волна опроса, значение — прогноз, а не факт.
+var vCbrMoBrView = util.View{
+	Name:   "v_cbr_mo_br",
+	Tables: []string{"macro_series"},
+	Select: `SELECT source, series, date, value FROM macro_series FINAL WHERE source = 'cbr_mo_br'`,
+	Comment: "Макроэкономический опрос Банка России (mo_br): прогнозы аналитиков по 17 показателям (ИПЦ, ВВП, ключевая ставка, курс USD/RUB, нефть и др.), 8 волн в год. " +
+		"Дата — волна опроса (1-е число месяца волны); волна публикуется на 2–6 дней позже, точная дата доступности версии файла — во внутренней source_publications (агенту не выдана). " +
+		"Значения — прогнозы аналитиков, а не факты: по каждому показателю и прогнозному году лежат медиана, квартильный интервал (p10/p90), диапазон (min/max) и число ответов (answers). " +
+		"Перед использованием читать v_series_catalog по (source='cbr_mo_br', series): единицы и смысл статистик различаются между рядами",
+	Columns: map[string]string{
+		"source": "Всегда cbr_mo_br",
+		"series": "Код ряда: <показатель>_<год прогноза>_<статистика>, у показателей без прогнозного года — <показатель>_<статистика>; статистики — median, p10, p90, min, max (прогнозы) и answers (число ответов). Описания — в v_series_catalog (source='cbr_mo_br')",
+		"date":   "Волна опроса: 1-е число месяца волны (Date32). Публикация волны — через 2–6 дней после этой даты; фактические даты доступности версий файла ведёт служебная source_publications (агенту не выдана)",
+		"value":  "У median/p10/p90/min/max — прогноз аналитиков в единицах показателя (медиана, границы центральной тенденции и всего диапазона ответов), у answers — число ответов участников по показателю и году в этой волне (не прогноз); см. unit и description в v_series_catalog",
+	},
+}
+
+// moBrImporter — макроэкономический опрос ЦБ: Name() = cbr_mo_br, таблица — общая
+// macro_series (source='cbr_mo_br'). DataUrl и ImportFunc вычисляются в Import()
+// (ссылка на файл волны меняется), регистрация — реестром cbr/importers.go.
+var moBrImporter = &moBrStat{ClickHouseImport: util.ClickHouseImport{
+	TableName:   moBrTable,
+	CreateTable: []string{moBrDdl},
+}}
diff --git a/cbr/mo_br_meta.go b/cbr/mo_br_meta.go
new file mode 100644
index 0000000..2da5791
--- /dev/null
+++ b/cbr/mo_br_meta.go
@@ -0,0 +1,136 @@
+package cbr
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/kmlebedev/clickhouse-import-rosstat/util"
+)
+
+// moBrSource — источник рядов макроэкономического опроса Банка России (импортёр cbr_mo_br):
+// в macro_series это source, в series_catalog — Source.
+const moBrSource = "cbr_mo_br"
+
+// moBrFrequency — частота выпуска волн опроса ЦБ (8 раз в год, полевая неделя раз в ~6 недель).
+// Отличается от кодов частот M/Q/R: значения — прогнозы аналитиков по волнам, а не регулярный
+// ряд, поэтому частота записана текстом и в series_catalog видна агенту как есть.
+const moBrFrequency = "8/год (волны опроса)"
+
+// moBrIndicator — дескриптор листа-показателя книги макроэкономического опроса ЦБ (full.xlsx):
+// номер листа (Sheet), базовое имя ряда в macro_series (Base — §3.3 спеки), заголовок каталога
+// (Title — показатель вместе с единицей измерения, как в mpSurveySeriesMeta) и единица (Unit).
+// NoYears отмечает листы 16–17: там блок статистики занимает одну строку, а прогнозного года
+// нет, поэтому имя ряда — <base>_<stat> без года.
+type moBrIndicator struct {
+	Sheet, Base, Title, Unit string
+	NoYears                  bool
+}
+
+// moBrIndicators — реестр 17 показателей опроса, дословно по таблице §2 спеки
+// (номер листа, показатель, единица). Незнакомый лист-показатель в книге — ошибка разбора:
+// структура источника изменилась, реестр нужно дополнять кодом.
+var moBrIndicators = []moBrIndicator{
+	{Sheet: "1", Base: "cpi_dec", Title: "ИПЦ, % дек. к дек. пред. года", Unit: "% дек. к дек. пред. года"},
+	{Sheet: "2", Base: "cpi_avg", Title: "ИПЦ, % к пред. году, в среднем за год", Unit: "% к пред. году, в среднем за год"},
+	{Sheet: "3", Base: "key_rate_avg", Title: "Ключевая ставка, % годовых, в среднем за год (с учётом выходных дней)", Unit: "% годовых, в среднем за год (с учётом выходных дней)"},
+	{Sheet: "4", Base: "gdp_yoy", Title: "ВВП, %, г/г", Unit: "%, г/г"},
+	{Sheet: "5", Base: "unemp_avg", Title: "Уровень безработицы, %, в среднем за год", Unit: "%, в среднем за год"},
+	{Sheet: "6", Base: "unemp_dec_nsa", Title: "Уровень безработицы, %, дек., без исключения сезонности", Unit: "%, дек., без исключения сезонности"},
+	{Sheet: "7", Base: "wage_nominal", Title: "Номинальная заработная плата, %, г/г, в среднем за год", Unit: "%, г/г, в среднем за год"},
+	{Sheet: "8", Base: "budget_balance", Title: "Баланс консолидированного бюджета, % ВВП за соответствующий год", Unit: "% ВВП за соответствующий год"},
+	{Sheet: "9", Base: "exports", Title: "Экспорт товаров и услуг, млрд долл. США в год", Unit: "млрд долл. США в год"},
+	{Sheet: "10", Base: "imports", Title: "Импорт товаров и услуг, млрд долл. США в год", Unit: "млрд долл. США в год"},
+	{Sheet: "11", Base: "usd_rub", Title: "Курс USD/RUB, руб. за долл., в среднем за год", Unit: "руб. за долл., в среднем за год"},
+	{Sheet: "12", Base: "oil_tax", Title: "Цена нефти для налогообложения, долл. США за баррель, в среднем за год", Unit: "долл. США за баррель, в среднем за год"},
+	{Sheet: "13", Base: "brent", Title: "Цена на нефть марки Brent, долл. США за баррель, в среднем за год", Unit: "долл. США за баррель, в среднем за год"},
+	{Sheet: "14", Base: "urals", Title: "Цена на нефть марки Urals, долл. США за баррель, в среднем за год", Unit: "долл. США за баррель, в среднем за год"},
+	{Sheet: "15", Base: "cds_5y", Title: "CDS-спред по России, б.п., в среднем за год", Unit: "б.п., в среднем за год"},
+	{Sheet: "16", Base: "neutral_rate", Title: "Нейтральная ключевая ставка, % годовых", Unit: "% годовых", NoYears: true},
+	{Sheet: "17", Base: "gdp_long_term", Title: "Долгосрочный рост ВВП, %, г/г", Unit: "%, г/г", NoYears: true},
+}
+
+// moBrStatSuffix — метки блоков статистик колонки B → суффиксы имён рядов. В файле метки
+// приходят с хвостовыми пробелами («Медиана »), поэтому парсер сопоставляет по trim; метки
+// вне набора («Среднее», 3-й и 1-й квартили) молча пропускаются — они вне объёма (§2 спеки).
+var moBrStatSuffix = map[string]string{
+	"Медиана":         "median",
+	"90-й процентиль": "p90",
+	"10-й процентиль": "p10",
+	"Мин":             "min",
+	"Макс":            "max",
+	"Всего ответов":   "answers",
+}
+
+// moBrStatLabel — каноническое имя блока статистики для Origin каталога и сообщений.
+var moBrStatLabel = map[string]string{
+	"median":  "Медиана",
+	"p90":     "90-й процентиль",
+	"p10":     "10-й процентиль",
+	"min":     "Мин",
+	"max":     "Макс",
+	"answers": "Всего ответов",
+}
+
+// moBrStatDesc — расшифровка статистики для Description каталога. Шаблоны различаются по
+// статистикам: агент должен видеть, что median/p10/p90/min/max — прогнозы аналитиков,
+// а answers — число ответов, а не прогноз (§3.5, риск «число ответов — не прогноз»).
+var moBrStatDesc = map[string]string{
+	"median":  "медиана прогнозов аналитиков",
+	"p10":     "10-й процентиль — нижняя граница центральной тенденции прогнозов",
+	"p90":     "90-й процентиль — верхняя граница центральной тенденции прогнозов",
+	"min":     "минимум прогнозов — нижняя граница всего диапазона ответов",
+	"max":     "максимум прогнозов — верхняя граница всего диапазона ответов",
+	"answers": "число ответов участников опроса по этому показателю (не прогноз)",
+}
+
+// moBrIndicatorBySheet — дескриптор листа-показателя по имени листа; ok=false, если лист
+// не из реестра 17 (разбор такого листа обязан упасть).
+func moBrIndicatorBySheet(sheet string) (moBrIndicator, bool) {
+	for _, ind := range moBrIndicators {
+		if ind.Sheet == sheet {
+			return ind, true
+		}
+	}
+	return moBrIndicator{}, false
+}
+
+// moBrStatLabels — метки блоков статистик в объёме, отсортированные (для сообщений об ошибке).
+func moBrStatLabels() []string {
+	out := make([]string, 0, len(moBrStatSuffix))
+	for label := range moBrStatSuffix {
+		out = append(out, label)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// moBrSeriesName — имя ряда в macro_series и series_catalog: <base>_<year>_<stat> для годовых
+// показателей и <base>_<stat> для листов 16–17 (год — четыре цифры даты прогнозного года).
+func moBrSeriesName(base, year, stat string) string {
+	if year == "" {
+		return base + "_" + stat
+	}
+	return base + "_" + year + "_" + stat
+}
+
+// moBrSeriesMeta — запись каталога series_catalog для комбинации (дескриптор, год, статистика).
+// Description — шаблон «прогноз аналитиков: <title> на <year> год; <расшифровка статистики>»
+// (для листов 16–17 без года), Origin — источник, файл, лист и блок статистики.
+func moBrSeriesMeta(ind moBrIndicator, year, stat string) util.SeriesMeta {
+	origin := fmt.Sprintf("ЦБ, макроэкономический опрос (full.xlsx, mo_br), лист «%s», блок «%s»",
+		ind.Sheet, moBrStatLabel[stat])
+	description := fmt.Sprintf("прогноз аналитиков: %s; %s", ind.Title, moBrStatDesc[stat])
+	if year != "" {
+		origin += fmt.Sprintf(", год %s", year)
+		description = fmt.Sprintf("прогноз аналитиков: %s на %s год; %s", ind.Title, year, moBrStatDesc[stat])
+	}
+	return util.SeriesMeta{
+		Source:      moBrSource,
+		Series:      moBrSeriesName(ind.Base, year, stat),
+		Title:       ind.Title,
+		Unit:        ind.Unit,
+		Frequency:   moBrFrequency,
+		Origin:      origin,
+		Description: description,
+	}
+}
diff --git a/cbr/mo_br_parse.go b/cbr/mo_br_parse.go
new file mode 100644
index 0000000..8e5d4ba
--- /dev/null
+++ b/cbr/mo_br_parse.go
@@ -0,0 +1,245 @@
+package cbr
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/kmlebedev/clickhouse-import-rosstat/util"
+	"github.com/xuri/excelize/v2"
+)
+
+// moBrPoint — одна точка ряда макроэкономического опроса ЦБ (full.xlsx): имя ряда в
+// macro_series (Series), дата волны опроса (Date — 1-е число месяца волны) и значение
+// прогноза или статистики (Value).
+type moBrPoint struct {
+	Series string
+	Date   time.Time
+	Value  float64
+}
+
+const (
+	// moBrNavigationMarker — подстрока имени навигационного листа полной книги ЦБ
+	// (в живом файле — «Навигация (Navigation) » с хвостовым пробелом, поэтому сравнение
+	// по вхождению). Наличие такого листа означает полную книгу: все 17 листов реестра
+	// обязаны быть на месте.
+	moBrNavigationMarker = "Навигация"
+
+	// Индексы колонок листа (0-based): B — метки блоков статистик, D — прогнозные годы.
+	moBrLabelCol = 1
+	moBrYearCol  = 3
+
+	// moBrMinHeaderDates — сколько дат должно быть в строке, чтобы считать её шапкой волн
+	// (у одиночных дат-годов в колонке D эта проверка не срабатывает).
+	moBrMinHeaderDates = 3
+
+	// Окно правдоподобных лет даты Excel: и дата волны, и год прогноза обязаны в него
+	// попадать. Значения-прогнозы (0–100) при переводе дают 1900 год и датами не считаются —
+	// это и отсеивает их при поиске шапки и колонок-волн.
+	moBrMinYear = 2000
+	moBrMaxYear = 2100
+
+	// moBrDash — маркер отсутствующего значения волны в файле.
+	moBrDash = "-"
+)
+
+// moBrWave — колонка-волна листа: индекс колонки (0-based) и дата волны из шапки.
+type moBrWave struct {
+	col  int
+	date time.Time
+}
+
+// parseMoBr читает книгу макроэкономического опроса ЦБ (full.xlsx) и возвращает точки рядов
+// и их описания для series_catalog. Функция чистая: на вход — открытая книга, без сети и БД.
+//
+// Числа и даты читаются только в raw-виде (RawCellValue): форматированные строки теряют
+// точность (14.599246575342466 вместо 14.5) и превращают даты в текст. Обход — по
+// GetSheetList (порядок книги), а не по реестру: лист с «Навигация» в имени пропускается,
+// лист реестра 17 разбирается, любой другой лист — ошибка (структура источника изменилась).
+// Если навигационный лист был (полная книга ЦБ), все 17 листов реестра обязаны присутствовать;
+// в сокращённой книге (например, фикстура) их отсутствие не ошибка.
+//
+// Разбор fail-fast: ошибка на любом листе или отсутствие точек — возврат без частичных данных,
+// поэтому импортёр не отправит неполный батч.
+func parseMoBr(xlsx *excelize.File) ([]moBrPoint, []util.SeriesMeta, error) {
+	var (
+		points []moBrPoint
+		metas  []util.SeriesMeta
+	)
+	present := make(map[string]bool, len(moBrIndicators))
+	full := false
+	for _, sheet := range xlsx.GetSheetList() {
+		if strings.Contains(sheet, moBrNavigationMarker) {
+			full = true
+			continue
+		}
+		ind, ok := moBrIndicatorBySheet(sheet)
+		if !ok {
+			return nil, nil, fmt.Errorf("неизвестный лист-показатель %q: структура книги изменилась, дополните реестр moBrIndicators", sheet)
+		}
+		present[sheet] = true
+		pts, sheetMetas, err := parseMoBrSheet(xlsx, ind)
+		if err != nil {
+			return nil, nil, err
+		}
+		points = append(points, pts...)
+		metas = append(metas, sheetMetas...)
+	}
+	if full {
+		var missing []string
+		for _, ind := range moBrIndicators {
+			if !present[ind.Sheet] {
+				missing = append(missing, fmt.Sprintf("«%s»", ind.Sheet))
+			}
+		}
+		if len(missing) > 0 {
+			return nil, nil, fmt.Errorf("полная книга (навигационный лист есть): нет %d листов-показателей из %d — %s",
+				len(missing), len(moBrIndicators), strings.Join(missing, ", "))
+		}
+	}
+	if len(points) == 0 {
+		return nil, nil, fmt.Errorf("не извлечено ни одной точки: проверьте структуру книги")
+	}
+	return points, metas, nil
+}
+
+// parseMoBrSheet разбирает один лист-показатель: находит шапку волн (строка с датами) и
+// колонки-волны, затем идёт по строкам, отслеживая текущий блок статистики (метка колонки B)
+// и прогнозный год (дата колонки D; у листов 16–17 годов нет). Пустые ячейки и «-» —
+// пропуск точки. Возвращает точки и описания каталога для комбинаций (год, статистика),
+// у которых оказалась хотя бы одна точка, — поэтому множества рядов точек и каталога
+// совпадают по построению.
+func parseMoBrSheet(xlsx *excelize.File, ind moBrIndicator) ([]moBrPoint, []util.SeriesMeta, error) {
+	rows, err := xlsx.GetRows(ind.Sheet, excelize.Options{RawCellValue: true})
+	if err != nil {
+		return nil, nil, fmt.Errorf("лист %q: чтение строк: %w", ind.Sheet, err)
+	}
+	headerRow, waves, err := moBrWaveHeader(rows, ind)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var (
+		points []moBrPoint
+		metas  []util.SeriesMeta
+	)
+	described := make(map[string]bool)
+	blocks, stat, year := 0, "", ""
+	for r := headerRow + 1; r <= len(rows); r++ {
+		if label := strings.TrimSpace(moBrCell(rows, r, moBrLabelCol)); label != "" {
+			// Новая метка блока: известная статистика — разбираем, неизвестная
+			// («Среднее», 3-й и 1-й квартили) — вне объёма, блок молча пропускается.
+			stat, _ = moBrStatSuffix[label]
+			if stat != "" {
+				blocks++
+			}
+			year = "" // год не переносится в следующий блок
+		}
+		if stat == "" {
+			continue
+		}
+		if !ind.NoYears {
+			// Год — дата в колонке D. Пустая ячейка оставляет год предыдущей строки
+			// (перенос объединённой ячейки); пока года нет, строка не разбирается.
+			if raw := strings.TrimSpace(moBrCell(rows, r, moBrYearCol)); raw != "" {
+				date, ok := moBrExcelDate(raw)
+				if !ok {
+					return nil, nil, fmt.Errorf("лист %q: строка %d, колонка D: значение %q не является датой прогнозного года", ind.Sheet, r, raw)
+				}
+				year = strconv.Itoa(date.Year())
+			}
+			if year == "" {
+				continue
+			}
+		}
+		series := moBrSeriesName(ind.Base, year, stat)
+		for _, wave := range waves {
+			raw := strings.TrimSpace(moBrCell(rows, r, wave.col))
+			if raw == "" || raw == moBrDash {
+				continue // «-» и пусто — отсутствие точки, соседние значения не страдают
+			}
+			value, err := strconv.ParseFloat(raw, 64)
+			if err != nil {
+				return nil, nil, fmt.Errorf("лист %q: ячейка %s: значение %q не является числом",
+					ind.Sheet, moBrCellName(wave.col, r), raw)
+			}
+			if !described[series] {
+				described[series] = true
+				metas = append(metas, moBrSeriesMeta(ind, year, stat))
+			}
+			points = append(points, moBrPoint{Series: series, Date: wave.date, Value: value})
+		}
+	}
+	if blocks == 0 {
+		return nil, nil, fmt.Errorf("лист %q: не найдено ни одного блока статистик из 6 в колонке B (ожидались метки: %s)",
+			ind.Sheet, strings.Join(moBrStatLabels(), ", "))
+	}
+	if len(points) == 0 {
+		return nil, nil, fmt.Errorf("лист %q: 0 точек после разбора (все значения пустые или «-»)", ind.Sheet)
+	}
+	return points, metas, nil
+}
+
+// moBrWaveHeader находит шапку волн — первую строку листа, в которой не меньше
+// moBrMinHeaderDates ячеек являются датами Excel, — и колонки-волны (по возрастанию).
+// На годовых листах колонка D отведена под прогнозные годы и волной не считается.
+func moBrWaveHeader(rows [][]string, ind moBrIndicator) (int, []moBrWave, error) {
+	for i, row := range rows {
+		var waves []moBrWave
+		for c, raw := range row {
+			if c == moBrYearCol && !ind.NoYears {
+				continue
+			}
+			date, ok := moBrExcelDate(strings.TrimSpace(raw))
+			if !ok {
+				continue
+			}
+			waves = append(waves, moBrWave{col: c, date: date})
+		}
+		if len(waves) >= moBrMinHeaderDates {
+			return i + 1, waves, nil
+		}
+	}
+	return 0, nil, fmt.Errorf("лист %q: не найдена шапка волн (строка с %d и более датами)", ind.Sheet, moBrMinHeaderDates)
+}
+
+// moBrExcelDate переводит raw-значение ячейки в дату Excel. Датой считается только значение
+// в окне лет moBrMinYear…moBrMaxYear: значения-прогнозы (0–100) дают 1900 год, поэтому
+// отличаются от дат волн и прогнозных годов без отдельного признака формата.
+func moBrExcelDate(raw string) (time.Time, bool) {
+	serial, err := strconv.ParseFloat(raw, 64)
+	if err != nil {
+		return time.Time{}, false
+	}
+	date, err := excelize.ExcelDateToTime(serial, false)
+	if err != nil {
+		return time.Time{}, false
+	}
+	if date.Year() < moBrMinYear || date.Year() > moBrMaxYear {
+		return time.Time{}, false
+	}
+	return date, true
+}
+
+// moBrCell — значение ячейки листа (строка 1-based, колонка 0-based); пустая строка, если
+// ячейки нет: GetRows обрезает хвостовые пустые ячейки строки.
+func moBrCell(rows [][]string, row, col int) string {
+	if row < 1 || row > len(rows) {
+		return ""
+	}
+	cells := rows[row-1]
+	if col < 0 || col >= len(cells) {
+		return ""
+	}
+	return cells[col]
+}
+
+// moBrCellName — адрес ячейки (строка 1-based, колонка 0-based) для сообщений об ошибке.
+func moBrCellName(col, row int) string {
+	name, err := excelize.CoordinatesToCellName(col+1, row)
+	if err != nil {
+		return fmt.Sprintf("колонка %d, строка %d", col+1, row)
+	}
+	return name
+}
