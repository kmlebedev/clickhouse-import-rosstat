+
+// mpRiskDezRe — признак дезинфляционной части списка рисков блока «Инфляционные риски»:
+// ввод дезинфляционного списка («Основные дезинфляционные риски включают:» — 23092026,
+// «Основным дезинфляционным фактором является:» — 07052026) и абзац, которым эта часть
+// изложена вместо списка («Дезинфляционные риски выражены слабо…» — 06112024). Одного стема
+// «дезинфляционн» мало: первый абзац блока говорит о преобладании проинфляционных рисков
+// над «дезинфляционными» и дезинфляционную часть не открывает.
+var mpRiskDezRe = regexp.MustCompile(
+	`основн[а-яё]*\s+дезинфляционн|дезинфляционн[а-яё]*\s+(?:риск|фактор)[а-яё]*\s+(?:включают|является|выражены|выделены)`)
+
+// mpRiskHeader — служебный абзац-ввод списка рисков блока 4: «Основные проинфляционные риски
+// включают:», «Среди основных проинфляционных рисков были выделены следующие:», «Основным
+// дезинфляционным фактором является:». Признак — двоеточие в конце и упоминание риска или
+// фактора: такой абзац открывает список, сам цитатой не является, матчей не порождает и
+// Seq не двигает. Абзац, который лишь начинается с упоминания рисков и несёт содержание
+// («Дезинфляционные риски выражены слабо и в основном связаны с…»), вводом не считается —
+// он размечается как обычный текст блока (fix-round 1).
+func mpRiskHeader(lowText string) bool {
+	if !strings.HasSuffix(lowText, ":") {
+		return false
+	}
+	return strings.Contains(lowText, "риск") || strings.Contains(lowText, "фактор")
+}
+
+// mpChannelSplitRe — граница предложения: знак конца (.!?) и пробел после него; фрагмент
+// режется сразу после знака (так дословная цитата сохраняет свою пунктуацию).
+var mpChannelSplitRe = regexp.MustCompile(`[.!?]\s+`)
+
+// mpChannelSentences разбивает нормализованный текст абзаца или пункта на предложения по
+// правилу (?<=[.!?])\s+ — Go-RE2 lookbehind не поддерживает, поэтому граница ищется как
+// «знак + пробелы», а фрагмент берётся до знака включительно. Пустые фрагменты
+// отбрасываются. От mpSentences (Task 3) отличается намеренно: там границей считается
+// только точка перед заглавной буквой — для решения и сигнала это точнее, а разметке каналов
+// нужен простой сплит, зафиксированный контроллером в Task 4.
+func mpChannelSentences(text string) []string {
+	var out []string
+	start := 0
+	for _, loc := range mpChannelSplitRe.FindAllStringIndex(text, -1) {
+		if piece := strings.TrimSpace(text[start : loc[0]+1]); piece != "" {
+			out = append(out, piece)
+		}
+		start = loc[1]
+	}
+	if tail := strings.TrimSpace(text[start:]); tail != "" {
+		out = append(out, tail)
+	}
+	return out
+}
+
+// mpChannelHits — сработал ли хотя бы один узор канала на тексте (уже в нижнем регистре).
+func mpChannelHits(ch mpChannel, lowText string) bool {
+	for _, re := range ch.Patterns {
+		if re.MatchString(lowText) {
+			return true
+		}
+	}
+	return false
+}
+
+// tagMPChannels размечает один документ (все блоки одного резюме) по 11 каналам ЦБ:
+//   - пункты и абзацы блока «Инфляционные риски» → risk_pro/risk_dez по порядку: всё до
+//     дезинфляционной части списка — проинфляционные, ввод дезинфляционной части и всё после
+//     него — дезинфляционные. Служебные абзацы-вводы списков («…риски включают:») пропускаются
+//     без матчей и без инкремента Seq, остальные абзацы блока размечаются наравне с пунктами
+//     (в 06112024 дезинфляционная часть изложена именно абзацем — fix-round 1);
+//   - предложения всех абзацев и пунктов остальных блоков (включая пункты «Основные
+//     аргументы…» блока 5 — они несут утверждения по каналам) → prose.
+//
+// Внутри пункта/абзаца разметка идёт по предложениям: одно предложение может попасть в
+// несколько каналов, повтор (Channel, Kind, Text) отбрасывается. Seq — сквозной номер
+// фрагмента в порядке обхода документа (один и тот же номер у всех каналов одного фрагмента).
+func tagMPChannels(blocks []mpSummaryBlock) []mpChannelMatch {
+	var (
+		out  []mpChannelMatch
+		seq  int
+		dez  bool // в блоке рисков: пройдена дезинфляционная часть списка
+		seen = make(map[mpChannelMatchKey]bool)
+	)
+	for _, b := range blocks {
+		kind := mpKindProse
+		if b.Block == mpBlockRisks {
+			low := strings.ToLower(b.Text)
+			if b.Kind == mpKindParagraph {
+				if mpRiskHeader(low) {
+					// Служебный ввод списка: цитатой не является и Seq не двигает, но
+					// переключает атрибуцию пунктов дезинфляционного списка.
+					if mpRiskDezRe.MatchString(low) {
+						dez = true
+					}
+					continue
+				}
+				if mpRiskDezRe.MatchString(low) {
+					// Дезинфляционная часть изложена абзацем (06112024): сам абзац —
+					// цитата risk_dez, а не только переключатель состояния.
+					dez = true
+				}
+			}
+			kind = mpKindRiskPro
+			if dez {
+				kind = mpKindRiskDez
+			}
+		}
+		for _, sent := range mpChannelSentences(b.Text) {
+			seq++
+			low := strings.ToLower(sent)
+			for _, ch := range mpChannels {
+				if !mpChannelHits(ch, low) {
+					continue
+				}
+				key := mpChannelMatchKey{Channel: ch.Slug, Kind: kind, Text: sent}
+				if seen[key] {
+					continue
+				}
+				seen[key] = true
+				out = append(out, mpChannelMatch{Channel: ch.Slug, Kind: kind, Seq: seq, Text: sent})
+			}
+		}
+	}
+	return out
+}
