@@ -0,0 +1,21 @@
+type: chain
+schedule: "7 10 * * *"
+overlap_policy: skip
+
+# Ежедневный прогон контура календаря событий в 10:07 МСК: ЦБ публикует расписание
+# заседаний Совета директоров по ключевой ставке заранее и обновляет его нерегулярно,
+# а импортёр идемпотентен — ключ ReplacingMergeTree (event_date, category, title)
+# перезаписывает строки теми же значениями, поэтому ежедневный прогон лишь пополняет
+# календарь (в т.ч. будущим годом целиком). Слот свободен: ближайшие DAG-и — bold 08:07,
+# financial 10:23, bls 12:23. Недоступность ЦБ — деградация (warn и успешный выход):
+# таблица и витрина к этому моменту уже созданы, а ручной сид
+# sql/events_calendar_q4_2026.sql остаётся на месте; ошибка разбора (0 заседаний) —
+# ошибка прогона, иначе смена разметки страницы выглядела бы зелёным прогоном.
+steps:
+  - id: events_calendar
+    run: "$ROSSTAT_IMPORT_BIN"
+    env:
+      - CLICKHOUSE_IMPORT_STAT=events_calendar
+    retry_policy:
+      limit: 3
+      interval_sec: 300
