+		{"9 Валовой внутрений продукт", "2011-04-01", "2026-07-01"},
+		{"10 Валовой внутренний продукт", "2011-04-01", "2026-07-01"},
+		{"12 Индексы физического объема валового внутреннего продукта", "2012-04-01", "2026-07-01"},
