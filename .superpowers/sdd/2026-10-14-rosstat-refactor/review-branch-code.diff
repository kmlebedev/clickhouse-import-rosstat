+// «к концу предыдущего месяца», строки 6…17 — январь…декабрь, строка 18 — второй якорь
+// «к декабрю предыдущего года» с годовым декабрём, ниже — сноски.
+func openIpcMesFixture(t *testing.T) *excelize.File {
