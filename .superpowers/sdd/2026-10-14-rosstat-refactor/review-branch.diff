+	} {
+		dates := seriesDates(rows, tt.series)
+		if len(dates) == 0 {
+			t.Errorf("ряд %q не найден", tt.series)
+			continue
+		}
+		first, last := dates[0], dates[0]
+		for _, date := range dates {
