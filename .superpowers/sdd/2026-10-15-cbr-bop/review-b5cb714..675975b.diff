+// единственное место, где видно переименование агрегата или перестановку строк, а не код,
+// читающий сам себя.
+var bopStandardWantCodes = []string{
+	"Счет текущих операций",
+	"Экспорт товаров, услуг, первичных и вторичных доходов",
