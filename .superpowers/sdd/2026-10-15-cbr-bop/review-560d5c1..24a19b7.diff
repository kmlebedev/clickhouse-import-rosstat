+// TestCbrBopStandardSpotValues: значения из известных ячеек живой фикстуры (спека §3.9) — края
+// квартального и годового рядов, включая шестнадцатитысячный счёт текущих операций последнего
+// квартала и отрицательные резервные активы первого. Значения литералами: сверка идёт с разбором,
+// а не с константой кода. Точка 1996,33 стоит в колонке с подписью источника «1 квартал 1994 г.»,
+// то есть тест же доказывает, что арабская запись квартала из живого листа доходит до 1994-03-31
+// (общий разбор принимает обе записи номера — cbrBopQuarter).
+// Отдельно взяты два ряда с повторяющейся подписью источника: «Экспорт» и «Импорт» встречаются в
+// листе десятки раз, и ошибка последовательного поиска на строку (взяли бы «Экспорт» соседнего
+// блока — строки 10 или 26, а не 13) каталогом не ловится: имена рядов остались бы верными, а
+// значения уехали бы в чужой ряд. Споты различают строки: 125716.38 стоит в строке 13 (товары),
+// 137650.49 — в строке 10 («Товары и услуги»), 11934.11 — в строке 26 (услуги); 25080.56 — в
+// строке 27 (импорт услуг), 86290.77 — в строке 14 (импорт товаров), 111371.33 — в строке 11.
+func TestCbrBopStandardSpotValues(t *testing.T) {
+	rows := cbrFixtureRows(t, bopStandardFixture, cbrBopStandard.ImportFunc)
+	firstQuarter := time.Date(1994, time.March, 31, 0, 0, 0, 0, time.UTC)
+	lastQuarter := time.Date(2026, time.June, 30, 0, 0, 0, 0, time.UTC)
+	firstYear := time.Date(1994, time.December, 31, 0, 0, 0, 0, time.UTC)
+	lastYear := time.Date(2025, time.December, 31, 0, 0, 0, 0, time.UTC)
+	cbrCheckSpot(t, rows, "Счет текущих операций (квартал)", firstQuarter, 1996.33)
+	cbrCheckSpot(t, rows, "Счет текущих операций (квартал)", lastQuarter, 16949.24)
+	cbrCheckSpot(t, rows, "Счет текущих операций (год)", firstYear, 8941.89)
+	cbrCheckSpot(t, rows, "Счет текущих операций (год)", lastYear, 38588.14)
+	cbrCheckSpot(t, rows, "Резервные активы (квартал)", firstQuarter, -1261)
+	cbrCheckSpot(t, rows, "Резервные активы (квартал)", lastQuarter, 7251.98)
+	cbrCheckSpot(t, rows, "Товары: экспорт (квартал)", lastQuarter, 125716.38)
+	cbrCheckSpot(t, rows, "Услуги: импорт (квартал)", lastQuarter, 25080.56)
+}
