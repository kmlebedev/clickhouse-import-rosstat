+			t.Fatalf("строка %d: %d значений, ожидалась форма (name, date, value)", i, len(raw))
+		}
+		if _, ok := raw[2].(float64); !ok {
+			t.Fatalf("строка %d: значение записано как %T, ожидался float64 (колонка value — Float64)", i, raw[2])
+		}
+	}
+}
