+package cbr
+
+import "github.com/kmlebedev/clickhouse-import-rosstat/util"
+
+// Каталог рядов платёжного баланса РФ (стандарт §10.1): секция cbr_bop_est — оценка ключевых
+// агрегатов (cbr/bop_est.go), секция cbr_bop_standard — стандартная презентация
+// (cbr/bop_standard.go). Источник каталога равен имени таблицы (спека §3.7), а не литералу 'cbr':
+// в общей витрине v_cbr_macro источник — литерал 'cbr', и имена рядов двух выгрузок ЦБ
+// («Счет текущих операций») в нём бы столкнулись.
+
+// cbrBopEstSeriesMeta — каталог оценки ключевых агрегатов: 17 агрегатов × 3 вида периода = 51
+// ряд, в порядке агрегатов листа и видов в cbrBopEstKinds — том же, в каком имена собирает
+// разбор (cbrBopEstName). Каталог и разбор не могут разойтись ни по составу рядов, ни по их
+// порядку, и двусторонний контракт проверяется тестом (стандарт §11.4).
+var cbrBopEstSeriesMeta = cbrBopEstMeta()
+
+// cbrBopEstOrigin — источник рядов: файл и лист в форме origin каталога. Имя листа в файле несёт
+// дату выпуска («Оценка ПБ (15.10.2026)») и меняется с ним, поэтому origin называет префикс
+// листа и объясняет дату; подпись строки источника (и блок для повторяющихся подписей)
+// дописывается в цикле.
+const cbrBopEstOrigin = "cbr.ru/vfs/statistics/credit_statistics/bop/bop_est.xlsx, " +
+	"лист «Оценка ПБ …» (дата выпуска в имени листа)"
+
+// cbrBopEstKindDates — привязка даты точки по виду периода (спека §3.4), в description ряда:
+// у месяца и квартала — конец периода, у накопленного итога — конец последнего покрытого месяца.
+var cbrBopEstKindDates = map[string]string{
+	cbrBopKindMonth:      "Дата точки — последний день отчётного месяца: сопоставлять по toStartOfMonth(date).",
+	cbrBopKindQuarter:    "Дата точки — последний день отчётного квартала: сопоставлять по toStartOfQuarter(date).",
+	cbrBopKindCumulative: "Накопленный итог с начала года: значение накапливается внутри года (в декабре равно году), дата точки — последний день последнего месяца итога («январь - август 2026» → 2026-08-31), сопоставлять по toStartOfMonth(date).",
+}
+
+// cbrBopEstKindFrequency — частота ряда в каталоге: у накопленного итога — месячная (M) с
+// объяснением в описании, а не годовая: точки приходят каждый месяц (стандарт §10.1, спека §3.7).
+var cbrBopEstKindFrequency = map[string]string{
+	cbrBopKindMonth:      "M",
+	cbrBopKindQuarter:    "Q",
+	cbrBopKindCumulative: "M",
+}
+
+// cbrBopEstDescriptionTail — общий хвост description всех 51 ряда: единицы, знак, ноль и ревизия
+// оценки. Отдельным текстом, а не частью Measures: четыре факта одинаковы у всех рядов листа, и
+// их правка — одна, а не 51 (описание каждого агрегата задано в cbrBopEstAggregates).
+const cbrBopEstDescriptionTail = " Единица — млрд долларов США. Знак — по методологии " +
+	"платёжного баланса: положительное значение — превышение поступлений над выплатами (или " +
+	"чистый прирост требований), отрицательное — обратное; отрицательные значения в файле есть. " +
+	"Ноль в источнике — настоящее значение (сальдо равно нулю), а не «данных не имеется»: " +
+	"точкой не становится только пустая ячейка, и в текущем выпуске таких нет. Значения — " +
+	"оценка ЦБ (подпись колонки содержит «(оценка)»): следующим выпуском ЦБ их ревизует, а " +
+	"импортёр перезаписывает точку по ключу (name, date), поэтому историю ревизий хранит только " +
+	"винтажный архив файла."
+
+// cbrBopEstSourceRow — подпись строки источника в origin: у позиции может быть два варианта — ЦБ
+// переименовал часть строк в выпуске 15.10.2026, и разбор принимает оба набора подписей
+// (cbrBopEstAggregates, спека §3.3). Прежний вариант называется явно: агент, сверяющий ряд со
+// старым выпуском файла, должен видеть, какой строке он соответствует.
+func cbrBopEstSourceRow(labels []string) string {
+	row := "строка «" + labels[0] + "»"
+	if len(labels) > 1 {
+		row += " (в прежних выпусках " + cbrBopLabelsText(labels[1:]) + ")"
+	}
+	return row
+}
+
+// cbrBopEstMeta собирает 51 запись каталога из объявлений кода — агрегатов листа
+// (cbrBopEstAggregates) и видов периода (cbrBopEstKinds): тот же порядок, что у разбора. Оба
+// набора подписей источника новых рядов не заводят: позиция строки одна, имя кода одно.
+func cbrBopEstMeta() []util.SeriesMeta {
+	meta := make([]util.SeriesMeta, 0, len(cbrBopEstAggregates)*len(cbrBopEstKinds))
+	for _, agg := range cbrBopEstAggregates {
+		for _, kind := range cbrBopEstKinds {
+			name := cbrBopEstName(agg.Code, kind)
+			origin := cbrBopEstOrigin + ", " + cbrBopEstSourceRow(agg.Labels)
+			if agg.Block != "" {
+				origin += " блока «" + agg.Block + "»"
+			}
+			meta = append(meta, util.SeriesMeta{
+				Source:      cbrBopEstTable,
+				Series:      name,
+				Title:       name,
+				Unit:        cbrBopEstUnit,
+				Frequency:   cbrBopEstKindFrequency[kind],
+				Origin:      origin,
+				Description: agg.Measures + " " + cbrBopEstKindDates[kind] + cbrBopEstDescriptionTail,
+			})
+		}
+	}
+	return meta
+}
+
+// cbrBopStandardSeriesMeta — каталог стандартной презентации: 17 верхних агрегатов × 2 листа = 34
+// ряда, в порядке листов cbrBopStandardSheets и агрегатов листа — том же, в каком точки пишет
+// разбор (cbrBopStandardReadSheet). Каталог и разбор не могут разойтись ни по составу рядов, ни
+// по их порядку, и двусторонний контракт проверяется тестом (стандарт §11.4).
+var cbrBopStandardSeriesMeta = cbrBopStandardMeta()
+
+// cbrBopStandardOrigin — источник рядов: файл и лист в форме origin каталога. Имена листов у этой
+// выгрузки постоянны («Кварталы», «Годы»), поэтому origin называет лист целиком, а подпись строки
+// источника (и блок для повторяющихся подписей) дописывается в цикле. Опечатка «standart» —
+// в имени файла источника, и она названа тут и в описании ряда: агент, ищущий файл на сайте ЦБ,
+// иначе принял бы имя из origin за ошибку выгрузки.
+const cbrBopStandardOrigin = "cbr.ru/vfs/statistics/credit_statistics/bop/bal_of_payments_standart.xlsx " +
+	"(«standart» — опечатка в имени файла ЦБ), лист "
+
+// cbrBopStandardKindDates — привязка даты точки по виду периода (спека §3.4), в description ряда:
+// у квартала — последний день квартала, у года — 31 декабря.
+var cbrBopStandardKindDates = map[string]string{
+	cbrBopKindQuarter: "Дата точки — последний день отчётного квартала: сопоставлять по toStartOfQuarter(date).",
+	cbrBopKindYear:    "Дата точки — 31 декабря отчётного года: сопоставлять по toYear(date).",
+}
+
+// cbrBopStandardKindFrequency — частота ряда в каталоге: лист «Кварталы» — Q, лист «Годы» — A
+// (стандарт §10.1, спека §3.7).
+var cbrBopStandardKindFrequency = map[string]string{
+	cbrBopKindQuarter: "Q",
+	cbrBopKindYear:    "A",
+}
+
+// cbrBopStandardDescriptionTail — общий хвост description всех 34 рядов: единицы, знак, ноль,
+// методология 2022 года и ревизия очередным выпуском. Отдельным текстом, а не частью Measures:
+// эти факты одинаковы у всех рядов выгрузки, и их правка — одна, а не 34 (описание каждого
+// агрегата задано в cbrBopStandardAggregates). Единицы здесь другие, чем у оценки (cbr_bop_est):
+// млн против млрд долларов США, — и об этом сказано явно, потому что имена рядов у двух выгрузок
+// совпадают до вида периода.
+const cbrBopStandardDescriptionTail = " Единица — млн долларов США (в 1000 раз мельче, чем у " +
+	"оценки cbr_bop_est, где те же агрегаты идут в млрд долларов США). Знак — по методологии " +
+	"платёжного баланса: положительное значение — превышение поступлений над выплатами (или " +
+	"чистый прирост требований), отрицательное — обратное; отрицательные значения в файле есть. " +
+	"Ноль в источнике — настоящее значение (сальдо равно нулю), а не «данных не имеется»: " +
+	"точкой не становится только пустая ячейка. Выгрузка — стандартная презентация по методологии " +
+	"платёжного баланса 2022 года; рядом ЦБ держит файл bal_of_payments_standart_before_2022.xlsx " +
+	"с прежней методологией (в этом импортёре он не разбирается, и сопоставление значений до " +
+	"2022 года с ним требует пересчёта). Выпуск квартальный, и ЦБ пересчитывает историю: очередной " +
+	"выпуск ревизует прошлые точки, а импортёр перезаписывает точку по ключу (name, date), поэтому " +
+	"историю ревизий хранит только винтажный архив файла."
+
+// cbrBopStandardMeta собирает 34 записи каталога из объявлений кода — листов выгрузки
+// (cbrBopStandardSheets) и агрегатов листа (cbrBopStandardAggregates): тот же порядок, что у
+// разбора.
+func cbrBopStandardMeta() []util.SeriesMeta {
+	meta := make([]util.SeriesMeta, 0, len(cbrBopStandardAggregates)*len(cbrBopStandardSheets))
+	for _, sheet := range cbrBopStandardSheets {
+		for _, agg := range cbrBopStandardAggregates {
+			name := cbrBopStandardName(agg.Code, sheet.Kind)
+			origin := cbrBopStandardOrigin + "«" + sheet.Sheet + "», строка «" + agg.Label + "»"
+			if agg.Block != "" {
+				origin += " блока «" + agg.Block + "»"
+			}
+			meta = append(meta, util.SeriesMeta{
+				Source:      cbrBopStandardTable,
+				Series:      name,
+				Title:       name,
+				Unit:        cbrBopStandardUnit,
+				Frequency:   cbrBopStandardKindFrequency[sheet.Kind],
+				Origin:      origin,
+				Description: agg.Measures + " " + cbrBopStandardKindDates[sheet.Kind] + cbrBopStandardDescriptionTail,
+			})
+		}
+	}
+	return meta
+}
diff --git a/cbr/bop_parse.go b/cbr/bop_parse.go
new file mode 100644
index 0000000..e25b4fe
--- /dev/null
+++ b/cbr/bop_parse.go
@@ -0,0 +1,458 @@
+package cbr
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/kmlebedev/clickhouse-import-rosstat/util"
+	"github.com/xuri/excelize/v2"
+)
+
+// Общие хелперы разбора выгрузок платёжного баланса ЦБ РФ (cbr/bop_est.go — оценка ключевых
+// агрегатов, cbr/bop_standard.go — стандартные компоненты): якоря листа, подписи периодов и
+// привязка даты, стандарт §6 и спека пункта §3.5. Хелперы не знают ни имён рядов, ни имён
+// таблиц: их задаёт вызывающий импортёр, поэтому один код разбора обслуживает оба файла ЦБ.
+
+// Виды периода в имени ряда (спека §3.2): вид идёт в имя, а не в колонку таблицы — каталог и
+// витрина пакета устроены как (source, series) и (source, series, date, value), и измерение
+// «вид» в колонке разрушило бы и то и другое. Даты точек вида «квартал» и «последний месяц
+// квартала» совпадают, и различает их только имя ряда.
+const (
+	cbrBopKindMonth      = "месяц"
+	cbrBopKindQuarter    = "квартал"
+	cbrBopKindYear       = "год"
+	cbrBopKindCumulative = "накопленным итогом"
+)
+
+// cbrBopUnitAnchor — признак строки единиц: подпись «(млрд долларов США)» стоит в строке над
+// шапкой (в файле оценки — правее последней колонки данных: у винтажа 15.10.2026 это K, у
+// 14.09.2026 — O, и колонка переезжает вместе с числом колонок). От неё отсчитываются строки шапки
+// и первая строка данных, поэтому магических индексов строк в разборе нет (стандарт §6.3).
+const cbrBopUnitAnchor = "долларов США"
+
+// cbrBopLabelReplacer — типографика подписей источника, не влияющая на смысл периода: ЦБ
+// ставит между месяцами накопленного итога короткое и длинное тире (в спеке — дефис).
+// Переносы строк и неразрывные пробелы отдельным правилом не нужны: их схлопывает
+// strings.Fields в cbrBopNormalizeLabel.
+var cbrBopLabelReplacer = strings.NewReplacer("–", "-", "—", "-")
+
+// cbrBopNormalizeLabel приводит подпись строки или колонки источника к сравнимому виду:
+// снимается пометка «(оценка)» (она относится к точке, а не к периоду: следующим выпуском ЦБ
+// её снимает, и подпись не должна от этого меняться), переносы строк и неразрывные пробелы
+// схлопываются в один пробел, тире становится дефисом, у формы «… 2026 г.» снимается хвост
+// «г.». Тот же вид получает ожидаемая подпись из кода, поэтому сравнение идёт по
+// нормализованным строкам (стандарт §6.3), а ошибки называют исходный текст ячейки.
+func cbrBopNormalizeLabel(raw string) string {
+	label := strings.ReplaceAll(raw, "(оценка)", "")
+	label = cbrBopLabelReplacer.Replace(label)
+	label = strings.Join(strings.Fields(label), " ")
+	return strings.TrimSpace(strings.TrimSuffix(label, "г."))
+}
+
+// cbrBopSameLabel — совпадают ли подписи после нормализации; регистр не значим. Пустая строка
+// не равна непустой подписи, поэтому пустые ячейки метки периода в поиске не участвуют.
+func cbrBopSameLabel(a, b string) bool {
+	return a != "" && b != "" && strings.EqualFold(cbrBopNormalizeLabel(a), cbrBopNormalizeLabel(b))
+}
+
+// cbrBopRowMatches — совпадает ли подпись строки хотя бы с одним из ожидаемых вариантов позиции.
+// Вариантов у позиции бывает больше одного: ЦБ переименовывает строки листа от выпуска к выпуску
+// (выпуск 15.10.2026 переименовал половину агрегатов оценки), и разбор принимает оба набора
+// подписей по позиции строки, не заводя второй ряд (спека §3.3). Сравнение остаётся точным
+// совпадением нормализованных подписей: варианты перечислены кодом, а не выводятся из текста.
+func cbrBopRowMatches(cell string, labels []string) bool {
+	for _, label := range labels {
+		if cbrBopSameLabel(cell, label) {
+			return true
+		}
+	}
+	return false
+}
+
+// cbrBopLabelsText — перечень ожидаемых подписей для текста ошибки: по нему видно, чего именно не
+// дождался разбор, — подписи строк меняются от выпуска к выпуску, и у позиции их может быть
+// несколько.
+func cbrBopLabelsText(labels []string) string {
+	quoted := make([]string, 0, len(labels))
+	for _, label := range labels {
+		quoted = append(quoted, "«"+label+"»")
+	}
+	return strings.Join(quoted, " / ")
+}
+
+// cbrBopPeriod — разобранная подпись колонки: вид периода (он идёт в имя ряда) и дата точки.
+type cbrBopPeriod struct {
+	Kind string
+	Date time.Time
+}
+
+// cbrBopParsePeriod разбирает подпись периода в одну из четырёх форм (спека §3.5):
+// «месяц ГГГГ» (апрель 2026), «квартал ГГГГ» (II квартал 2026 в оценке и 2 квартал 2026 в
+// стандартной презентации — запись номера у двух файлов ЦБ разная, см. cbrBopQuarter),
+// «месяц - месяц ГГГГ» (январь - июль 2026; первый месяц обязан быть январь — иначе это не итог с
+// начала года) и «ГГГГ» (2026). Дата точки — по спеке §3.4: последний день месяца, последний день
+// квартала, 31 декабря, у накопленного итога — последний день последнего покрытого месяца.
+// Неразобранная подпись — ошибка, а не пропуск колонки: значение без периода записать нечем
+// (стандарт §6.4).
+func cbrBopParsePeriod(raw string) (cbrBopPeriod, error) {
+	label := cbrBopNormalizeLabel(raw)
+	fields := strings.Fields(label)
+	switch len(fields) {
+	case 1:
+		year, err := cbrBopYear(fields[0], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		return cbrBopPeriod{Kind: cbrBopKindYear, Date: time.Date(year, time.December, 31, 0, 0, 0, 0, time.UTC)}, nil
+	case 2:
+		month, err := cbrBopMonth(fields[0], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		year, err := cbrBopYear(fields[1], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		return cbrBopPeriod{Kind: cbrBopKindMonth, Date: cbrBopLastDayOfMonth(year, month)}, nil
+	case 3:
+		if !strings.EqualFold(fields[1], "квартал") {
+			return cbrBopPeriod{}, cbrBopPeriodFormError(label)
+		}
+		quarter, err := cbrBopQuarter(fields[0], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		year, err := cbrBopYear(fields[2], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		return cbrBopPeriod{Kind: cbrBopKindQuarter, Date: cbrBopLastDayOfQuarter(year, quarter)}, nil
+	case 4:
+		if fields[1] != "-" {
+			return cbrBopPeriod{}, cbrBopPeriodFormError(label)
+		}
+		first, err := cbrBopMonth(fields[0], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		if first != time.January {
+			return cbrBopPeriod{}, fmt.Errorf("подпись %q: первый месяц накопленного итога %q не январь — ЦБ считает итог с начала года", label, fields[0])
+		}
+		last, err := cbrBopMonth(fields[2], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		year, err := cbrBopYear(fields[3], label)
+		if err != nil {
+			return cbrBopPeriod{}, err
+		}
+		return cbrBopPeriod{Kind: cbrBopKindCumulative, Date: cbrBopLastDayOfMonth(year, last)}, nil
+	default:
+		return cbrBopPeriod{}, cbrBopPeriodFormError(label)
+	}
+}
+
+// cbrBopPeriodFormError — отказ разбора с перечнем поддерживаемых форм: по тексту ошибки
+// видно, какую именно подпись источника разбор не знает.
+func cbrBopPeriodFormError(label string) error {
+	return fmt.Errorf("подпись %q не разобрана как период: ожидается «месяц ГГГГ», «[IVX]+ квартал ГГГГ» (или «1 квартал ГГГГ»), «месяц - месяц ГГГГ» или «ГГГГ»", label)
+}
+
+// cbrBopMonth — месяц по русскому названию. Словарь месяцев один на пакет (util.MonthsToNum,
+// правило 7 AGENTS.md): он знает и именительный падеж («июль»), и родительный («июля»).
+func cbrBopMonth(name, label string) (time.Month, error) {
+	month, ok := util.MonthsToNum[strings.ToLower(name)]
+	if !ok {
+		return 0, fmt.Errorf("подпись %q: неизвестный месяц %q", label, name)
+	}
+	return month, nil
+}
+
+// cbrBopYear — год подписи. Ошибка называется вместе с подписью: в листе десятки колонок, и
+// «invalid syntax» без контекста не говорит, какую правку ждать от ЦБ.
+func cbrBopYear(token, label string) (int, error) {
+	year, err := strconv.Atoi(token)
+	if err != nil {
+		return 0, fmt.Errorf("подпись %q: год %q: %w", label, token, err)
+	}
+	return year, nil
+}
+
+// cbrBopRomanDigits — римские цифры квартала. В файлах ЦБ они латинские (I — 0x49): похожие
+// кириллические «І» и «Х» цифрами не считаются и дают ошибку разбора — это смена формы
+// подписи источником, а не квартал (стандарт §6.4).
+var cbrBopRomanDigits = map[byte]int{'I': 1, 'V': 5, 'X': 10}
+
+// cbrBopQuarter — номер квартала подписи. Запись номера у двух файлов ЦБ разная: оценка пишет
+// квартал латинской римской цифрой («I квартал 2026 г.»), стандартная презентация — арабской
+// («1 квартал 1994 г.»), и оба файла обслуживает один разбор, поэтому принимаются обе записи — и
+// только они. Сначала пробуется римская; отказ римской записи у токена из одних римских цифр
+// возвращается как есть (это содержательный отказ: «V квартал» — номер вне диапазона 1…4), а у
+// остальных токенов принимается ровно одна арабская цифра 1…4. Посторонняя форма обязана валить
+// прогон, а не превращаться в квартал догадкой (стандарт §6.4).
+func cbrBopQuarter(token, label string) (int, error) {
+	roman, romanErr := cbrBopRomanQuarter(token, label)
+	if romanErr == nil {
+		return roman, nil
+	}
+	if cbrBopRomanToken(token) {
+		return 0, romanErr
+	}
+	// Арабская запись — ровно один символ из «1»…«4»: strconv.Atoi принял бы ещё «+2», «02» и « 2»
+	// (ведущий пробел не доживает до сюда — его снимает cbrBopNormalizeLabel), а это уже не форма
+	// спеки §3.5, и такая подпись обязана валить прогон с исходным текстом, а не становиться точкой.
+	if len(token) != 1 || token[0] < '1' || token[0] > '4' {
+		return 0, fmt.Errorf("подпись %q: %q не номер квартала (арабская цифра 1…4 или латинская римская I, V, X)", label, token)
+	}
+	return int(token[0] - '0'), nil
+}
+
+// cbrBopRomanToken — состоит ли токен целиком из римских цифр квартала. Отделяет отказ римской
+// записи по диапазону («V квартал», «IX квартал») от токена, римским не являющегося вовсе: у
+// второго ошибку обязана назвать арабская попытка, у первого арабская запись ни при чём.
+func cbrBopRomanToken(token string) bool {
+	if token == "" {
+		return false
+	}
+	for i := 0; i < len(token); i++ {
+		if _, ok := cbrBopRomanDigits[token[i]]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+// cbrBopRomanQuarter разбирает римскую цифру квартала — так номер пишет оценка (в стандартной
+// презентации он арабский, и вызывает её cbrBopQuarter) — и проверяет диапазон: «V квартал»
+// цифрой разбирается, но кварталом не является, и молча пропустить это нельзя.
+func cbrBopRomanQuarter(token, label string) (int, error) {
+	quarter := 0
+	for i := 0; i < len(token); i++ {
+		value, ok := cbrBopRomanDigits[token[i]]
+		if !ok {
+			return 0, fmt.Errorf("подпись %q: %q не римская цифра квартала (латинские I, V, X)", label, token)
+		}
+		// Вычитающее правило римской записи (IV = 4): следующая цифра больше текущей. За концом
+		// токена следующей цифры нет — сравнение с нулём ничего не вычитает.
+		next := 0
+		if i+1 < len(token) {
+			next = cbrBopRomanDigits[token[i+1]]
+		}
+		if value < next {
+			quarter -= value
+			continue
+		}
+		quarter += value
+	}
+	if quarter < 1 || quarter > 4 {
+		return 0, fmt.Errorf("подпись %q: номер квартала %d вне диапазона 1…4", label, quarter)
+	}
+	return quarter, nil
+}
+
+// cbrBopLastDayOfMonth — последний день месяца: нулевой день от первого числа следующего
+// месяца (time.Date нормализует день 0 в последний день предыдущего месяца). У привязки даты
+// платёжного баланса конвенция — конец периода (спека §3.4), поэтому день 0, а не -1, как в
+// cbrIntRateLoansMonthDate: там точка ряда — предпоследний день месяца.
+func cbrBopLastDayOfMonth(year int, month time.Month) time.Time {
+	return time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC)
+}
+
+// cbrBopLastDayOfQuarter — последний день квартала: его третий месяц, затем последний день
+// месяца. Четвёртый квартал даёт time.Date(year, 13, 0) — это 31 декабря, как и ожидается.
+func cbrBopLastDayOfQuarter(year, quarter int) time.Time {
+	return cbrBopLastDayOfMonth(year, time.Month(quarter*3))
+}
+
+// cbrBopColumn — колонка данных листа: её индекс в строке (0-based; колонка 0 — метка периода)
+// и разобранный период подписи.
+type cbrBopColumn struct {
+	Index  int
+	Period cbrBopPeriod
+}
+
+// cbrBopLayout — разметка листа, выведенная из якорей: номер первой строки данных и колонки с
+// разобранными периодами.
+type cbrBopLayout struct {
+	FirstDataRow int
+	Columns      []cbrBopColumn
+}
+
+// cbrBopColumnName — буква колонки листа по индексу (0-based): ошибки разбора называют колонку
+// так же, как её видит человек в Excel, а не «колонка 14».
+func cbrBopColumnName(index int) string {
+	name, err := excelize.ColumnNumberToName(index + 1)
+	if err != nil {
+		return strconv.Itoa(index + 1)
+	}
+	return name
+}
+
+// cbrBopSheetByPrefix ищет лист книги по префиксу имени и возвращает его точное имя: у выгрузки
+// оценки дата выпуска стоит в имени листа («Оценка ПБ (15.10.2026)») и меняется с выпуском,
+// поэтому имя листа — признак, а не константа (стандарт §6.3). Отсутствие листа — ошибка с
+// именем таблицы и списком листов книги: «0 rows» на переименованном листе выглядели бы
+// успешным прогоном (стандарт §6.4).
+func cbrBopSheetByPrefix(xlsx *excelize.File, table, prefix string) (string, error) {
+	sheets := xlsx.GetSheetList()
+	for _, name := range sheets {
+		if strings.HasPrefix(name, prefix) {
+			return name, nil
+		}
+	}
+	return "", fmt.Errorf("%s: в книге нет листа с префиксом %q (листы книги: %s)", table, prefix, strings.Join(sheets, ", "))
+}
+
+// cbrBopSheetByName ищет лист книги по точному имени и возвращает его же: у стандартной
+// презентации имена листов — константы («Кварталы», «Годы»), даты выпуска в них нет, поэтому
+// префиксный поиск здесь был бы слабее признака — он принял бы «Кварталы (30.09.2026)» за тот же
+// лист и молча разобрал бы не то, что объявлено. Отсутствие листа — ошибка с именем таблицы и
+// списком листов книги: «0 rows» на переименованном листе выглядели бы успешным прогоном
+// (стандарт §6.4, спека §3.5).
+func cbrBopSheetByName(xlsx *excelize.File, table, name string) (string, error) {
+	sheets := xlsx.GetSheetList()
+	for _, sheet := range sheets {
+		if sheet == name {
+			return sheet, nil
+		}
+	}
+	return "", fmt.Errorf("%s: в книге нет листа «%s» (листы книги: %s)", table, name, strings.Join(sheets, ", "))
+}
+
+// cbrBopRowContains — есть ли в строке ячейка, содержащая подстроку.
+func cbrBopRowContains(row []string, substr string) bool {
+	for _, cell := range row {
+		if strings.Contains(cell, substr) {
+			return true
+		}
+	}
+	return false
+}
+
+// cbrBopRowEmpty — строка без единой непустой ячейки: пустые строки шапки её строками не
+// считаются, иначе шапка «нашлась» бы и в пустом листе.
+func cbrBopRowEmpty(row []string) bool {
+	for _, cell := range row {
+		if strings.TrimSpace(cell) != "" {
+			return false
+		}
+	}
+	return true
+}
+
+// cbrBopColumnPeriod возвращает подпись колонки: это самая нижняя непустая ячейка её строк шапки,
+// и она обязана разобраться как период. Спека §3.5 допускает мягкий разбор — «первая,
+// разобравшаяся как период, при обходе снизу вверх»: неразобравшуюся ячейку можно пропустить и
+// взять следующую выше. Код строже намеренно: мягкий разбор молча пропустил бы строку-аннотацию,
+// добавленную источником под периодами, взял бы период из чужой строки, и значения уехали бы в
+// (name, date) сдвинутой шапки, тогда как смена шапки обязана валить прогон громко (стандарт §6.4,
+// §12.3). На живом листе оба варианта дают одно и то же: самая нижняя непустая ячейка колонки
+// данных и есть подпись периода (в листе оценки над периодами стоит только «Справочно:» —
+// периодом оно не является, а под ним в строке ниже лежит подпись прошлого года, поэтому разбором
+// оно не берётся). Возвращает разобранный период и текст, на котором разбор остановился: если он
+// не разобрался, это та самая нижняя непустая ячейка — ею ошибка называет текст источника. Пустой
+// текст означает, что подписей в колонке нет вовсе, то есть колонка данных не она.
+func cbrBopColumnPeriod(headerRows [][]string, column int) (cbrBopPeriod, string, bool) {
+	for i := len(headerRows) - 1; i >= 0; i-- {
+		row := headerRows[i]
+		if column >= len(row) {
+			continue
+		}
+		cell := strings.TrimSpace(row[column])
+		if cell == "" {
+			continue
+		}
+		period, err := cbrBopParsePeriod(cell)
+		if err != nil {
+			return cbrBopPeriod{}, cell, false
+		}
+		return period, cell, true
+	}
+	return cbrBopPeriod{}, "", false
+}
+
+// cbrBopSheetLayout выводит разметку листа из якорей (стандарт §6.3): строка единиц — ячейка с
+// «долларов США»; первая строка данных — первая ниже неё, где в колонке A стоит первая ожидаемая
+// подпись агрегата (firstLabels — её варианты: у оценки подписей два набора, у стандартной
+// презентации один); строки шапки — непустые строки между ними. Колонки данных — колонки 1…
+// (колонка A — метка периода), у каждой подпись берётся снизу вверх. Колонка с подписью, не
+// разобравшейся как период, и колонка со значением, но без подписи, — ошибка (спека §3.5): первая
+// означает смену формы подписи источником, вторая — значение, которому нечем назначить период.
+// Ошибки называют таблицу, лист, колонку буквой и строку.
+func cbrBopSheetLayout(rows [][]string, table, sheet string, firstLabels []string) (cbrBopLayout, error) {
+	layout := cbrBopLayout{}
+	unitRow := -1
+	for i, row := range rows {
+		if cbrBopRowContains(row, cbrBopUnitAnchor) {
+			unitRow = i
+			break
+		}
+	}
+	if unitRow < 0 {
+		return layout, fmt.Errorf("%s: лист «%s»: не найдена строка единиц (ячейка с %q) — шапка источника не распознана",
+			table, sheet, cbrBopUnitAnchor)
+	}
+	firstDataRow := -1
+	for i := unitRow + 1; i < len(rows); i++ {
+		if len(rows[i]) > 0 && cbrBopRowMatches(rows[i][0], firstLabels) {
+			firstDataRow = i
+			break
+		}
+	}
+	if firstDataRow < 0 {
+		return layout, fmt.Errorf("%s: лист «%s»: ниже строки единиц (строка %d) нет первой ожидаемой подписи агрегата (варианты: %s) — источник изменил состав листа",
+			table, sheet, unitRow+1, cbrBopLabelsText(firstLabels))
+	}
+	headerRows := make([][]string, 0, firstDataRow-unitRow)
+	for i := unitRow + 1; i < firstDataRow; i++ {
+		if !cbrBopRowEmpty(rows[i]) {
+			headerRows = append(headerRows, rows[i])
+		}
+	}
+	if len(headerRows) == 0 {
+		return layout, fmt.Errorf("%s: лист «%s»: между строкой единиц и первой строкой данных нет строк с подписями периодов — колонки привязать не к чему",
+			table, sheet)
+	}
+	width := 0
+	for _, row := range headerRows {
+		if len(row) > width {
+			width = len(row)
+		}
+	}
+	columns := make([]cbrBopColumn, 0, width)
+	labeled := make(map[int]bool, width)
+	for c := 1; c < width; c++ {
+		period, text, ok := cbrBopColumnPeriod(headerRows, c)
+		if text == "" {
+			continue
+		}
+		if !ok {
+			// Нижняя непустая ячейка колонки не разобралась как период — ошибка, а не «поискать
+			// выше»: иначе аннотация, добавленная источником под периодами, была бы молча
+			// пропущена, а период взят из чужой строки (разбор подписи — cbrBopColumnPeriod).
+			return layout, fmt.Errorf("%s: лист «%s», колонка %s: подпись %q не разобрана как период — источник изменил шапку листа",
+				table, sheet, cbrBopColumnName(c), text)
+		}
+		columns = append(columns, cbrBopColumn{Index: c, Period: period})
+		labeled[c] = true
+	}
+	if len(columns) == 0 {
+		return layout, fmt.Errorf("%s: лист «%s»: в строках шапки нет ни одной колонки с разобранной подписью периода", table, sheet)
+	}
+	// Колонка со значением, но без разобравшейся подписи, — ошибка (спека §3.5): иначе точка
+	// молча не попала бы в таблицу, а ряд остался бы без обновления (стандарт §6.4).
+	for i := firstDataRow; i < len(rows); i++ {
+		for c, cell := range rows[i] {
+			if c == 0 || labeled[c] || strings.TrimSpace(cell) == "" {
+				continue
+			}
+			return layout, fmt.Errorf("%s: лист «%s», колонка %s строки %d: есть значение %q, но подпись периода не разобрана",
+				table, sheet, cbrBopColumnName(c), i+1, strings.TrimSpace(cell))
+		}
+	}
+	layout.FirstDataRow = firstDataRow
+	layout.Columns = columns
+	return layout, nil
+}
diff --git a/cbr/bop_parse_test.go b/cbr/bop_parse_test.go
new file mode 100644
index 0000000..4acd279
--- /dev/null
+++ b/cbr/bop_parse_test.go
@@ -0,0 +1,83 @@
+package cbr
+
+import (
+	"testing"
+	"time"
+)
+
+// TestCbrBopParsePeriod: четыре формы подписи периода (спека §3.5) и привязка даты по виду
+// (§3.4). Подписи взяты как есть — с переносами строк, пометкой «(оценка)» и хвостом «г.»:
+// хелпер общий для обеих выгрузок платёжного баланса, и годовая форма, которой нет в оценке,
+// нужна стандартным компонентам (cbr_bop_standard). Запись номера квартала у двух файлов ЦБ
+// разная — оценка пишет «I квартал», стандартная презентация «1 квартал», — и разбор обязан
+// принимать обе (иначе живой файл стандартной презентации не разберётся вовсе).
+func TestCbrBopParsePeriod(t *testing.T) {
+	for name, tc := range map[string]struct {
+		label string
+		kind  string
+		date  string
+	}{
+		"месяц":                            {"июль \n2026 г.\n(оценка)", "месяц", "2026-07-31"},
+		"месяц прошлого года":              {"апрель\n2025 г.", "месяц", "2025-04-30"},
+		"февраль високосного года":         {"февраль 2024 г.", "месяц", "2024-02-29"},
+		"первый квартал":                   {"I квартал \n2025 г. ", "квартал", "2025-03-31"},
+		"второй квартал с оценкой":         {"II квартал \n2026 г. \n(оценка)", "квартал", "2026-06-30"},
+		"четвёртый квартал":                {"IV квартал 2025", "квартал", "2025-12-31"},
+		"квартал арабской цифрой":          {"4 квартал 2026 г.", "квартал", "2026-12-31"},
+		"первый квартал 1994":              {"1 квартал 1994 г.", "квартал", "1994-03-31"},
+		"квартал арабской без года хвоста": {"2 квартал 2026", "квартал", "2026-06-30"},
+		"накопленный итог":                 {"январь - июль \n2026 г.\n(оценка)", "накопленным итогом", "2026-07-31"},
+		"итог за декабрь":                  {"январь - декабрь 2025", "накопленным итогом", "2025-12-31"},
+		"итог с длинным тире":              {"январь — июль 2025", "накопленным итогом", "2025-07-31"},
+		"год":                              {"2025 г.", "год", "2025-12-31"},
+		"год без хвоста":                   {"1994", "год", "1994-12-31"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			want, err := time.Parse("2006-01-02", tc.date)
+			if err != nil {
+				t.Fatalf("тест: дата %q: %v", tc.date, err)
+			}
+			got, err := cbrBopParsePeriod(tc.label)
+			if err != nil {
+				t.Fatalf("cbrBopParsePeriod(%q): %v", tc.label, err)
+			}
+			if got.Kind != tc.kind {
+				t.Errorf("cbrBopParsePeriod(%q): вид %q, want %q", tc.label, got.Kind, tc.kind)
+			}
+			if !got.Date.Equal(want) {
+				t.Errorf("cbrBopParsePeriod(%q): дата %s, want %s", tc.label, got.Date.Format("2006-01-02"), tc.date)
+			}
+		})
+	}
+	// Неразобранные подписи — ошибка, а не период: «Справочно:» стоит в строке шапки над подписью
+	// прошлого года (её снимает выбор подписи снизу вверх), итог обязан начинаться с января,
+	// квартал — римской или арабской цифрой с годом и в диапазоне 1…4, и никакая другая форма
+	// кварталом не считается (стандарт §6.4): расширение приёма на «похожие» записи читало бы
+	// чужие точки как квартал.
+	for name, label := range map[string]string{
+		"пустая подпись":                "",
+		"«Справочно:»":                  "Справочно:",
+		"итог не с января":              "февраль - июль 2026",
+		"квартал без года":              "II квартал",
+		"кириллическая цифра":           "Х квартал 2026",
+		"пятый квартал":                 "V квартал 2026",
+		"пятый квартал арабской цифрой": "5 квартал 2026",
+		"нулевой квартал":               "0 квартал 2026",
+		"двенадцатый квартал":           "12 квартал 2026",
+		"арабская с ведущим нулём":      "02 квартал 2026",
+		"арабская со знаком":            "+2 квартал 2026",
+		"арабская с минусом":            "-2 квартал 2026",
+		"полноширинная цифра":           "２ квартал 2026",
+		"квартал словом":                "второй квартал 2026",
+		"квартал с лишним словом":       "2 квартал 2026 года",
+		"месяц без года":                "июль",
+		"год и месяц вразнобой":         "2026 июль",
+		"подпись с посторонним":         "II квартал 2026 года",
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := cbrBopParsePeriod(label); err == nil {
+				t.Errorf("cbrBopParsePeriod(%q): ожидалась ошибка разбора", label)
+			}
+		})
+	}
+}
diff --git a/cbr/bop_standard.go b/cbr/bop_standard.go
new file mode 100644
index 0000000..3f0e94e
--- /dev/null
+++ b/cbr/bop_standard.go
@@ -0,0 +1,295 @@
+package cbr
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+
+	"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
+	"github.com/kmlebedev/clickhouse-import-rosstat/util"
+	"github.com/xuri/excelize/v2"
+)
+
+// Стандартная презентация платёжного баланса Российской Федерации (ЦБ РФ):
+// https://www.cbr.ru/statistics/macro_itm/external_sector/pb/ — прямая стабильная выгрузка
+// bal_of_payments_standart.xlsx. Два листа («Кварталы» с 1 квартала 1994 года и «Годы» 1994–2025),
+// у каждого те же 17 верхних агрегатов в одном порядке и та же строка единиц. Публикуется по
+// методологии платёжного баланса 2022 года; файл обновляется раз в квартал. Канал «внешние
+// условия и курс» контура ключевой ставки (пункт 4.2 №14 роадмапа).
+
+const (
+	cbrBopStandardTable = "cbr_bop_standard"
+	// cbrBopStandardDataUrl — стабильная прямая ссылка на файл (стандарт §4.1, строка «XLSX»):
+	// даты в ней нет, темп обновления — квартал, поэтому качает файл шаблон — те же байты уходят
+	// и в разбор, и в винтажный архив версии (§9.6). «standart» — опечатка в адресе ЦБ, а не в
+	// коде: таблица называется cbr_bop_standard (спека §3.1).
+	cbrBopStandardDataUrl = "https://www.cbr.ru/vfs/statistics/credit_statistics/bop/bal_of_payments_standart.xlsx"
+	// cbrBopStandardCountPoints — количественный чек версии (стандарт §9.2): число точек своей
+	// таблицы. FINAL обязателен — иначе count() считал бы несмёрженные части.
+	cbrBopStandardCountPoints = "SELECT count() FROM cbr_bop_standard FINAL"
+	// cbrBopStandardUnit — единицы значения, как в строке единиц источника «млн долларов США»
+	// (строка 4 листа; в файле оценки те же ряды идут в млрд — в 1000 раз крупнее).
+	cbrBopStandardUnit = "млн долларов США"
+)
+
+// cbrBopStandardSheet — лист стандартной презентации и вид периода всех его колонок (спека §3.5):
+// «Кварталы» → квартал, «Годы» → год. Вид — часть имени ряда, поэтому объявлен кодом, а лист лишь
+// сверяется с ним: смена шапки листа обязана валить прогон, а не подменить вид у половины точек.
+type cbrBopStandardSheet struct {
+	Sheet string
+	Kind  string
+}
+
+// cbrBopStandardSheets — обход листов в порядке книги. Имена листов здесь — константы, а не
+// признак: даты выпуска в них нет (лист оценки ищется по префиксу, здесь — по точному имени),
+// поэтому отсутствие любого из двух листов — ошибка (спека §3.5). Номер квартала эти листы пишут
+// арабской цифрой («1 квартал 1994 г.»), тогда как оценка — римской: обе записи разбирает общий
+// cbrBopQuarter, и переписывать подписи перед разбором не нужно.
+var cbrBopStandardSheets = []cbrBopStandardSheet{
+	{Sheet: "Кварталы", Kind: cbrBopKindQuarter},
+	{Sheet: "Годы", Kind: cbrBopKindYear},
+}
+
+// cbrBopStandardAggregates — 17 верхних агрегатов стандартной презентации в порядке строк листа
+// (спека §3.3). Label — подпись строки источника, по которой идёт последовательный поиск: в листе
+// десятки строк и подписи плоские и повторяющиеся («Экспорт» и «Импорт» встречаются по нескольку
+// десятков раз), поэтому поиск без порядка прочитал бы экспорт услуг как экспорт товаров
+// (стандарт §6.8). Code — имя кода: повторяющуюся подпись имя различить не может, поэтому
+// «Товары: экспорт» собирает код. Block — блок листа, к которому относится повторяющаяся подпись:
+// origin каталога обязан его назвать, иначе «строка «Экспорт»» не говорит, о каком экспорте речь.
+// Measures — что измеряет агрегат: description каталога собирается из него в cbr/bop_meta.go
+// (правило 11 AGENTS.md — описание каждого ряда).
+var cbrBopStandardAggregates = []struct {
+	Label    string
+	Code     string
+	Block    string
+	Measures string
+}{
+	{
+		Label: "Счет текущих операций", Code: "Счет текущих операций",
+		Measures: "Сальдо счёта текущих операций: экспорт товаров, услуг и полученные первичные и вторичные доходы минус импорт и выплаченные доходы. Ключевой агрегат внешних условий: профицит — приток средств в экономику, дефицит — отток.",
+	},
+	{
+		Label:    "Экспорт товаров, услуг, полученные первичные и вторичные доходы",
