+// bopEstHasPoint — есть ли в разборе точка (ряд, дата).
+func bopEstHasPoint(rows []appendedRow, name string, date time.Time) bool {
+	for _, row := range rows {
+		if row.name == name && row.date.Equal(date) {
+			return true
+		}
+	}
+	return false
+}
