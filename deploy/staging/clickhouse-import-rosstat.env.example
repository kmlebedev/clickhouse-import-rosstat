# Секреты staging. РЕАЛЬНЫЙ файл: /etc/clickhouse-import-rosstat.env, права 600, вне git.
# deploy-staging НЕ создаёт этот файл и падает, если его нет.
#
# CLICKHOUSE_URL            — для импортёров (запускает dagu); пользователь, который пишет в БД
# CLICKHOUSE_PASSWORD       — пароль пользователя kimi_reader; его читает mcp-clickhouse
# FASTMCP_SERVER_AUTH_GOOGLE_* — Google OAuth для MCP: client ID/secret, base URL, scopes,
#                             ключ подписи FastMCP JWT. Значения — из Google Cloud Console.
# ROSSTAT_MCP_ALLOWED_GOOGLE_EMAILS — allowlist: только эти Google-адреса получают доступ.
# GOST_APP_ID               — токен gtn.access.appid REST API портала Росстандарта (импортёр
#                             gost_vehicle_safety_certificate, dagu/craw.yaml); значение — из
#                             JS-конфига страницы реестра (standarts.adminsHeaders)
# ARCHIVE_BACKEND           — винтажный архив версий файлов источников (пакет archive/):
#                             local | yandex | пусто = архивация выключена
# ARCHIVE_YANDEX_TOKEN      — OAuth-токен приложения Яндекс.Диска; токену нужны ОБА scope:
#                             cloud_api:disk.write (запись версий) и cloud_api:disk.read
#                             (проверка наличия, чтение реестра и скачивание версий)
# ARCHIVE_YANDEX_DIR        — корень архива на Диске; при пустом значении disk:/rosstat-archive
#
# OAuth ОБЯЗАТЕЛЕН: в HTTP-режиме mcp-clickhouse падает на старте без одного из режимов
# (CLICKHOUSE_MCP_AUTH_TOKEN, FASTMCP_SERVER_AUTH или CLICKHOUSE_MCP_AUTH_DISABLED).
# Static bearer удалён: OAuth и токен взаимоисключающие, unit дополнительно делает
# UnsetEnvironment=CLICKHOUSE_MCP_AUTH_TOKEN.
# GOST_APP_ID ОБЯЗАТЕЛЕН для часового шага gost_vehicle_safety_certificate: без него импортёр
# падает до сети («GOST_APP_ID не задан»). В этом файле держать ТОЛЬКО токен: режимные
# переменные (GOST_MODE/GOST_FROM/GOST_TO/GOST_SETTLE_DAYS) задаёт сам DAG в env шага.
# ARCHIVE_YANDEX_TOKEN ОБЯЗАТЕЛЕН при ARCHIVE_BACKEND=yandex: без него хранилище не собирается,
# импортёр пишет в лог «архив версий файлов выключен» и продолжает без архива — импорт не
# останавливается, но новые версии файлов не сохраняются.
# Архивация — ОПЦИЯ и включается осознанно. Пустой (или отсутствующий) ARCHIVE_BACKEND =
# архивация выключена целиком: штатный режим, пока хранилище не заведено. Включение — ПОСЛЕ
# подстановки рабочего токена: впишите его в ARCHIVE_YANDEX_TOKEN и раскомментируйте
# ARCHIVE_BACKEND=yandex. `REPLACE_ME` — заглушка, а не токен: с включённым бэкендом и нерабочим
# токеном каждый прогон упирается в 401 на проверке архива (ErrAuth), no-op не наступает и импорт
# идёт ПОЛНЫМ каждый день — данные при этом не теряются, но версии файлов не сохраняются, пока
# токен не починен.
CLICKHOUSE_URL=clickhouse://:REPLACE_ME@localhost:9000/default
CLICKHOUSE_PASSWORD=REPLACE_ME
#
# --- MCP OAuth (Google + allowlist) ---
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://mcp.selfinvesting.ru:8443/auth/callback
# OAuth consent screen scopes: openid, email, profile.
FASTMCP_SERVER_AUTH=rosstat_mcp_auth.RosstatGoogleProvider
FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_ID=REPLACE_ME
FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_SECRET=REPLACE_ME
FASTMCP_SERVER_AUTH_GOOGLE_BASE_URL=https://mcp.selfinvesting.ru:8443
FASTMCP_SERVER_AUTH_GOOGLE_REQUIRED_SCOPES=openid,email,profile
# Стабильный ключ подписи FastMCP JWT (openssl rand -hex 32); без него выводится из client_secret.
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=REPLACE_ME
# Только эти Google-адреса; пустой список = сервер не стартует (fail closed).
ROSSTAT_MCP_ALLOWED_GOOGLE_EMAILS=user@example.com
# Host-заголовки, которые принимает MCP (бинд 0.0.0.0 требует явного списка):
# публичное имя и loopback для smoke на хосте. Не секрет.
CLICKHOUSE_MCP_ALLOWED_HOSTS="mcp.selfinvesting.ru:8443,localhost:8443,127.0.0.1:8443"
# Origin consent-страницы FastMCP; без него POST с Origin получит 403.
CLICKHOUSE_MCP_ALLOWED_ORIGINS="https://mcp.selfinvesting.ru:8443"
#
# --- Grafana MCP (mcp-grafana на 127.0.0.1:8000, наружу не публикуется) ---
# Admin-токен отдельного сервис-аккаунта mcp-grafana-admin: на Grafana 13 дашборды,
# залитые через gcx/k8s API, видны только роли Admin (Viewer/Editor получают 403;
# проверено на 13.2.3). Токен деплоя дашбордов может остаться Editor — для MCP он не подходит.
# MCP остаётся read-only благодаря --disable-write.
# Публичного HTTPS-эндпоинта у Grafana MCP нет: доступ только через ssh-туннель.
GRAFANA_MCP_TOKEN=REPLACE_ME
GOST_APP_ID=REPLACE_ME
# Включение архивации: подставьте рабочий токен в ARCHIVE_YANDEX_TOKEN
# и раскомментируйте строку ниже.
#ARCHIVE_BACKEND=yandex
ARCHIVE_YANDEX_TOKEN=REPLACE_ME
ARCHIVE_YANDEX_DIR=disk:/rosstat-archive
#
# Уведомления dagu о падении импорта (deploy/staging/dagu-base.yaml):
# SMTP-сервер и адрес получателя. MAIL_TO — шлюз CMC, который пересылает
# письмо в SMS на мобильный телефон владельца. Значения не коммитить.
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM=dagu@palmshell
MAIL_TO=REPLACE_ME
#
# MLflow (deploy/staging/mlflow.service) этот файл НЕ читает: серверу не нужны ни секреты,
# ни MLFLOW_* переменные — только SQLite и локальные артефакты в /var/lib/mlflow, доступ
# через ssh-туннель. Секретов для MLflow не добавлять.
