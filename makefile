# ============================================================
# Makefile для Go-проекта (целевая платформа: linux/amd64)
# ============================================================

# Имя итогового исполняемого файла
BINARY_NAME := clickhouse-import-rosstat
# Каталог для артефактов сборки
BUILD_DIR   := build
# Команда Go
GO          := go
# Целевая платформа
GOOS        := linux
GOARCH      := amd64
# Отключаем CGO для статически слинкованного бинарника
CGO_ENABLED := 0

# Флаги сборки (можно добавить -ldflags="-s -w" для уменьшения размера)
LDFLAGS := -ldflags="-s -w"

# Путь к итоговому бинарному файлу
TARGET := $(BUILD_DIR)/$(BINARY_NAME)

# Список всех исходников (используется для проверки изменений)
SOURCES := $(shell find . -name '*.go' -type f)

# ============================================================
# Цели по умолчанию
# ============================================================

.PHONY: all
all: clean fmt vet test build
	@echo "✅ Сборка завершена: $(TARGET)"

.PHONY: build
build: $(TARGET)

# Сборка бинарника с явным указанием GOOS/GOARCH и отключённым CGO
$(TARGET): $(SOURCES) go.mod go.sum
	@mkdir -p $(BUILD_DIR)
	CGO_ENABLED=$(CGO_ENABLED) GOOS=$(GOOS) GOARCH=$(GOARCH) \
	$(GO) build $(LDFLAGS) -o $@ .

# ============================================================
# Вспомогательные цели
# ============================================================

.PHONY: clean
clean:
	@echo "🧹 Очистка..."
	@rm -rf $(BUILD_DIR)

.PHONY: test
test:
	@echo "🧪 Запуск тестов..."
	@$(GO) test -v ./...

.PHONY: fmt
fmt:
	@echo "🎨 Форматирование кода..."
	@$(GO) fmt ./...

.PHONY: vet
vet:
	@echo "🔍 Статический анализ (go vet)..."
	@$(GO) vet ./...

# Запуск собранной программы (удобно для быстрой проверки)
.PHONY: run
run: build
	@echo "🚀 Запуск $(TARGET)..."
	@./$(TARGET)

# Скачивание зависимостей (если нужно обновить модули)
.PHONY: deps
deps:
	@echo "📦 Загрузка зависимостей..."
	@$(GO) mod download
	@$(GO) mod tidy

# ============================================================
# Дополнительно: статический анализ с golangci-lint (опционально)
# ============================================================

.PHONY: lint
lint:
	@echo "🧐 Запуск golangci-lint..."
	@golangci-lint run ./...

# ============================================================
# Информация о среде сборки
# ============================================================

.PHONY: info
info:
	@echo "GOOS      = $(GOOS)"
	@echo "GOARCH    = $(GOARCH)"
	@echo "CGO_ENABLED = $(CGO_ENABLED)"
	@echo "BINARY    = $(TARGET)"