            "refId": "A",
            "rawSql": "SELECT date AS time, value AS \"Учётная цена ЦБ, ₽/г\"\nFROM v_cbr_macro\nWHERE series = 'cbr_gold' AND $__timeFilter(date)\nORDER BY date\n",
            "editorType": "sql",
            "format": 0,
            "queryType": "timeseries",
            "pluginVersion": "4.3.2"
          }
        ],
        "title": "Учётная цена золота ЦБ, ₽/г",
        "description": "Учётная цена золота Банка России (v_cbr_macro, series = 'cbr_gold') — уровень на дату, ₽ за грамм. Это цена для расчётов ЦБ, а не биржевая котировка: из неё и официального курса собирается ЦБ-паритет $/oz панели 2. Значения — ₽/г.",
        "transparent": false,
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "ch-rosstat"
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 1
        },
        "repeatDirection": "h",
        "options": {
