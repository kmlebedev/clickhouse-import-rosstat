      {
        "type": "timeseries",
        "id": 1,
        "targets": [
          {
            "refId": "A",
            "rawSql": "SELECT date AS time, value AS \"Ключевая ставка, % годовых\"\nFROM v_cbr_macro\nWHERE series = 'cbr_key_rate' AND $__timeFilter(date)\nORDER BY date\n",
            "editorType": "sql",
            "format": 0,
            "queryType": "timeseries",
            "pluginVersion": "4.3.2"
          },
          {
            "refId": "B",
            "rawSql": "SELECT meeting_date AS time, decision_rate AS \"Решение ЦБ, % годовых\"\nFROM v_cbr_mp_summary\nWHERE $__timeFilter(meeting_date)\nORDER BY meeting_date\n",
            "editorType": "sql",
            "format": 0,
            "queryType": "timeseries",
            "pluginVersion": "4.3.2"
          }
        ],
        "title": "Ключевая ставка и решения ЦБ",
        "description": "Ключевая ставка ЦБ (v_cbr_macro, series = 'cbr_key_rate') — уровень на дату; точки — принятые решения по датам заседаний (v_cbr_mp_summary.decision_rate). Значения — % годовых.",
        "transparent": false,
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "ch-rosstat"
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 1
        },
        "repeatDirection": "h",
        "options": {
