          {
            "refId": "A",
            "rawSql": "SELECT time, yoy AS \"М2, г/г\"\nFROM (\n    SELECT date AS time, value / nullIf(lagInFrame(value, 12) OVER (ORDER BY date), 0) - 1 AS yoy\n    FROM v_cbr_macro\n    WHERE series = 'М2 SA'\n)\nWHERE $__timeFilter(time)\nORDER BY time\n",
            "editorType": "sql",
            "format": 0,
            "queryType": "timeseries",
            "pluginVersion": "4.3.2"
          },
          {
            "refId": "B",
            "rawSql": "SELECT time, yoy AS \"Кредит экономике, г/г\"\nFROM (\n    SELECT date AS time, value / nullIf(lagInFrame(value, 12) OVER (ORDER BY date), 0) - 1 AS yoy\n    FROM v_cbr_macro\n    WHERE series = 'Кредит экономике'\n)\nWHERE $__timeFilter(time)\nORDER BY time\n",
            "editorType": "sql",
            "format": 0,
            "queryType": "timeseries",
            "pluginVersion": "4.3.2"
          }
        ],
