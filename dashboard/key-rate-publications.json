            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "gradientMode": "none",
              "lineWidth": 1,
              "fillOpacity": 0,
              "spanNulls": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byFrameRefID",
